#: templates/configure/tab_network.html.jinja:25
msgid ""
"La sélection du pays est obligatoire pour activer\n"
"                    l'interface Wi-Fi et respecter les réglementations "
"locales sur les fréquences radio."
msgstr ""
"Die Auswahl des Landes ist erforderlich, um die WLAN-Schnittstelle zu "
"aktivieren und die örtlichen Funkfrequenzvorschriften einzuhalten."

#: templates/configure/tab_network.html.jinja:29
msgid ""
"Pays (pour la\n"
"                            réglementation Wi-Fi)"
msgstr ""
"Land (für\n"
"                            WLAN-Bestimmungen)"

