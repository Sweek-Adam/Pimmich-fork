<!DOCTYPE html>
<html lang="{{ get_locale() }}">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ _('Envoyer des photos') }} - Pimmich</title>
  <link href="{{ url_for('static', filename='vendor/tailwind/tailwind.min.css') }}" rel="stylesheet">
  <link rel="stylesheet" href="{{ url_for('static', filename='styles.css') }}">
  <link rel="icon" type="image/x-icon" href="{{ url_for('static', filename='favicon.ico') }}">
  <!-- Installation sur l'écran d'accueil du téléphone -->
  <link rel="manifest" href="{{ url_for('static', filename='pwa/manifest.json') }}">
  <link rel="apple-touch-icon" href="{{ url_for('static', filename='pwa/apple-touch-icon.png') }}">
  <meta name="theme-color" content="#3b82f6">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="Pimmich">
</head>

<body class="relative min-h-screen">

  <!-- Messages flash -->
  {% with messages = get_flashed_messages(with_categories=true) %}
  {% if messages %}
  <div id="flash-container" class="absolute top-0 mt-4 max-w-xs w-full z-20">
    {% for category, message in messages %}
    <div class="
          flash-message
          px-4 py-3 rounded-md text-white shadow-md transition-opacity duration-700 ease-in-out
          {% if category == 'success' %}
            bg-green-500
          {% elif category == 'error' %}
            bg-red-500
          {% else %}
            bg-gray-500
          {% endif %}
        ">
      {{ message }}
    </div>
    {% endfor %}
  </div>
  <script>
    // Disparition automatique après 4 secondes
    setTimeout(() => {
      const messages = document.querySelectorAll('.flash-message');
      messages.forEach(msg => {
        msg.classList.add('opacity-0');
        setTimeout(() => msg.remove(), 700); // attendre que l'effet se termine
      });
    }, 4000);
  </script>
  {% endif %}
  {% endwith %}

  <div class="flex items-center justify-center min-h-screen">
    <div class="w-11/12 max-w-lg p-6 md:p-8 bg-white bg-opacity-90 backdrop-blur-md rounded-2xl shadow-xl">
      <img src="{{ url_for('static', filename='pimmich_logo.png') }}" alt="Logo Pimmich" class="w-40 mx-auto mb-8">
      <h2 class="text-center text-2xl font-semibold mb-4">{{ _('Envoyer des photos pour le cadre') }}</h2>
      <p class="text-center text-gray-600 mb-6">{{ _('Les photos seront soumises à validation avant d\'être affichées.')
        }}</p>

      <div id="now-box" class="hidden mb-6 text-center">
        <h2 class="text-xl font-semibold mb-2">{{ _('En ce moment sur le cadre') }}</h2>
        <img id="now-photo" class="w-full rounded-lg shadow" alt="{{ _('Photo affichée sur le cadre') }}">
        <div id="now-reactions" class="flex justify-center gap-2 mt-3"></div>
        <a href="{{ url_for('guest_book_page') }}" class="inline-block mt-3 text-blue-600 underline text-sm">📖 {{ _("Livre d'or") }}</a>
      </div>
      <script>
        (() => {
          const $ = (id) => document.getElementById(id);
          let shown = null;
          async function refresh() {
            let d;
            try { d = await (await fetch("{{ url_for('guest_now_showing') }}")).json(); } catch (e) { return; }
            $("now-box").classList.toggle("hidden", !d.photo);
            if (!d.photo) return;
            if (d.photo !== shown) { $("now-photo").src = d.url; shown = d.photo; }
            render(d.kinds, d.counts);
          }
          function render(kinds, counts) {
            $("now-reactions").innerHTML = "";
            Object.entries(kinds).forEach(([kind, emoji]) => {
              const b = document.createElement("button"); b.type = "button";
              b.className = "px-3 py-2 rounded-full border bg-white text-lg";
              b.textContent = `${emoji} ${counts[kind] || ""}`.trim();
              b.addEventListener("click", async () => {
                b.disabled = true;
                const r = await (await fetch("{{ url_for('guest_react') }}", { method: "POST", headers: { "Content-Type": "application/json" },
                  body: JSON.stringify({ photo: shown, kind }) })).json();
                b.disabled = false;
                if (r.success) { render(kinds, r.counts); b.animate([{ transform: "scale(1.4)" }, { transform: "scale(1)" }], 300); }
              });
              $("now-reactions").appendChild(b);
            });
          }
          refresh(); setInterval(refresh, 8000);
        })();
      </script>
      <form id="upload-form" method="POST" action="{{ url_for('handle_upload') }}" enctype="multipart/form-data">
        <div class="mb-4">
          <input type="file" name="photos" multiple required accept="image/*,video/*"
            class="block w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 cursor-pointer focus:outline-none">
        </div>
        <input type="text" name="name" maxlength="60" placeholder="{{ _('Votre prénom (optionnel)') }}" class="block w-full mt-3 p-2 border border-gray-300 rounded">
        <div id="upload-progress" class="hidden mt-4">
          <div class="w-full bg-gray-200 rounded-full h-4 overflow-hidden">
            <div id="upload-progress-bar" class="bg-blue-500 h-4 text-xs text-white text-center leading-4" style="width: 0%">0%</div>
          </div>
          <p id="upload-progress-text" class="text-center text-sm text-gray-600 mt-2"></p>
        </div>

        <div class="flex items-center justify-center mt-8">
          <button type="submit"
            class="bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline transition duration-150 ease-in-out w-full">
            {{ _('Envoyer') }}
          </button>
        </div>
      </form>
      {% if guest_messages_enabled %}
      <div class="mt-8 pt-6 border-t border-gray-300">
        <h2 class="text-center text-2xl font-semibold mb-4">{{ _('Écrire un message sur le cadre') }}</h2>
        <input type="text" id="gm-title" maxlength="120" placeholder="{{ _('Titre (optionnel)') }}"
          class="block w-full mb-3 p-2 border border-gray-300 rounded">
        <textarea id="gm-body" rows="4" maxlength="1000" placeholder="{{ _('Votre message…') }}"
          class="block w-full mb-3 p-2 border border-gray-300 rounded"></textarea>
        <input type="text" id="gm-signature" maxlength="80" placeholder="{{ _('Votre prénom (optionnel)') }}"
          class="block w-full mb-3 p-2 border border-gray-300 rounded">
        <select id="gm-style" class="block w-full mb-3 p-2 border border-gray-300 rounded">
          {% for key, label in message_styles %}<option value="{{ key }}">{{ _(label) }}</option>{% endfor %}
        </select>
        <div class="flex gap-2">
          <button type="button" id="gm-preview" class="flex-1 bg-gray-500 hover:bg-gray-600 text-white font-bold py-2 px-4 rounded">{{ _('Aperçu') }}</button>
          <button type="button" id="gm-publish" class="flex-1 bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded">{{ _('Afficher sur le cadre') }}</button>
        </div>
        <p id="gm-status" class="text-center text-sm mt-3"></p>
        <img id="gm-preview-img" class="hidden mt-3 w-full rounded border" alt="{{ _('Aperçu du message') }}">
        <p class="text-center text-xs text-gray-500 mt-2">{{ _('Le message reste affiché 7 jours.') }}</p>
      </div>

      <div class="mt-8 pt-6 border-t border-gray-300" id="voice-box">
        <h2 class="text-center text-2xl font-semibold mb-2">{{ _('Laisser un message vocal') }}</h2>
        <p class="text-center text-sm text-gray-600 mb-3">{{ _('Le cadre le lira à voix haute quand votre message passera (90 secondes au plus).') }}</p>
        <div id="vc-recorder" class="hidden text-center">
          <button type="button" id="vc-record" class="bg-red-600 hover:bg-red-700 text-white font-bold py-3 px-6 rounded-full">🎤 {{ _('Enregistrer') }}</button>
          <p id="vc-timer" class="text-sm text-gray-600 mt-2"></p>
        </div>
        <div id="vc-file" class="hidden">
          <label class="block text-sm text-gray-600 mb-1" for="vc-input">{{ _("Enregistrez-vous avec l'application Dictaphone du téléphone, puis choisissez le fichier :") }}</label>
          <input type="file" id="vc-input" accept="audio/*" capture class="block w-full text-sm">
        </div>
        <audio id="vc-preview" controls class="w-full mt-3 hidden"></audio>
        <input type="text" id="vc-signature" maxlength="80" placeholder="{{ _('Votre prénom (optionnel)') }}" class="block w-full mt-3 p-2 border border-gray-300 rounded">
        <button type="button" id="vc-send" class="w-full mt-3 bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded" disabled>{{ _('Envoyer le message vocal') }}</button>
        <p id="vc-status" class="text-center text-sm mt-3"></p>
      </div>
      <script>
        (() => {
          const $ = (id) => document.getElementById(id);
          let blob = null, recorder = null, timer = null;
          const ready = (b) => { blob = b; $("vc-preview").src = URL.createObjectURL(b); $("vc-preview").classList.remove("hidden"); $("vc-send").disabled = false; };
          const canRecord = window.isSecureContext && navigator.mediaDevices && window.MediaRecorder;
          $(canRecord ? "vc-recorder" : "vc-file").classList.remove("hidden");
          $("vc-input").addEventListener("change", () => { if ($("vc-input").files[0]) ready($("vc-input").files[0]); });
          $("vc-record").addEventListener("click", async () => {
            if (recorder && recorder.state === "recording") { recorder.stop(); return; }
            let stream;
            try { stream = await navigator.mediaDevices.getUserMedia({ audio: true }); }
            catch (e) { $("vc-recorder").classList.add("hidden"); $("vc-file").classList.remove("hidden"); return; }
            const chunks = [];
            recorder = new MediaRecorder(stream);
            recorder.ondataavailable = (e) => chunks.push(e.data);
            recorder.onstop = () => {
              stream.getTracks().forEach(t => t.stop()); clearInterval(timer);
              $("vc-record").textContent = "🎤 " + {{ _('Recommencer')|tojson }};
              ready(new Blob(chunks, { type: recorder.mimeType || "audio/webm" }));
            };
            recorder.start();
            const start = Date.now();
            $("vc-record").textContent = "⏹ " + {{ _('Arrêter')|tojson }};
            timer = setInterval(() => {
              const s = Math.round((Date.now() - start) / 1000);
              $("vc-timer").textContent = `${Math.floor(s / 60)}:${String(s % 60).padStart(2, "0")}`;
              if (s >= 90) recorder.stop();
            }, 250);
          });
          $("vc-send").addEventListener("click", async () => {
            if (!blob) return;
            $("vc-send").disabled = true;
            const form = new FormData();
            form.append("voice", blob, "message");
            form.append("signature", $("vc-signature").value.trim());
            try {
              const r = await (await fetch("{{ url_for('guest_voice_publish') }}", { method: "POST", body: form })).json();
              $("vc-status").textContent = r.message; $("vc-status").className = "text-center text-sm mt-3 " + (r.success ? "text-green-700" : "text-red-600");
              if (r.success) { blob = null; $("vc-preview").classList.add("hidden"); $("vc-input").value = ""; return; }
            } catch (e) {
              $("vc-status").textContent = {{ _("Échec de l'envoi. Vérifiez la connexion au cadre.")|tojson }};
            }
            $("vc-send").disabled = false;
          });
        })();
      </script>

      <div class="mt-8 pt-6 border-t border-gray-300" id="drawing-box">
        <h2 class="text-center text-2xl font-semibold mb-2">{{ _('Faire un dessin pour le cadre') }}</h2>
        <p class="text-center text-sm text-gray-600 mb-3">{{ _('Dessinez avec le doigt, ajoutez des autocollants, puis envoyez.') }}</p>
        <div class="dr-stage">
          <canvas id="dr-canvas" class="dr-canvas"></canvas>
          <p id="dr-hint" class="dr-hint" hidden>{{ _("Touchez le dessin pour poser l'autocollant") }}</p>
        </div>
        <div class="dr-bar">
          <div class="dr-modes" role="tablist">
            <button type="button" class="dr-mode on" data-mode="pen" aria-label="{{ _('Crayon') }}">✏️<span>{{ _('Crayon') }}</span></button>
            <button type="button" class="dr-mode" data-mode="sticker" aria-label="{{ _('Autocollants') }}">😀<span>{{ _('Autocollants') }}</span></button>
            <button type="button" class="dr-mode" data-mode="eraser" aria-label="{{ _('Gomme') }}">🧽<span>{{ _('Gomme') }}</span></button>
          </div>
          <div class="dr-actions">
            <button type="button" class="dr-icon" id="dr-undo" title="{{ _('Annuler') }}" aria-label="{{ _('Annuler') }}">↩️</button>
            <button type="button" class="dr-icon" id="dr-clear" title="{{ _('Tout effacer') }}" aria-label="{{ _('Tout effacer') }}">🗑</button>
          </div>
        </div>
        <div class="dr-panel" id="dr-pen-panel">
          <div class="dr-scroll" id="dr-colors"></div>
          <div class="dr-sizes">
            <button type="button" class="dr-size" data-size="4" aria-label="{{ _('Trait fin') }}"><span style="width:6px;height:6px"></span></button>
            <button type="button" class="dr-size on" data-size="10" aria-label="{{ _('Trait moyen') }}"><span style="width:12px;height:12px"></span></button>
            <button type="button" class="dr-size" data-size="24" aria-label="{{ _('Trait épais') }}"><span style="width:20px;height:20px"></span></button>
          </div>
        </div>
        <div class="dr-panel" id="dr-sticker-panel" hidden><div class="dr-scroll" id="dr-stickers"></div></div>
        <div class="dr-bgs" role="radiogroup" aria-label="{{ _('Fond') }}">
          <button type="button" class="dr-bgbtn on" data-bg="paper"><i style="background:#fffdf6"></i>{{ _('Papier') }}</button>
          <button type="button" class="dr-bgbtn" data-bg="slate"><i style="background:#2f3b33"></i>{{ _('Ardoise') }}</button>
          <button type="button" class="dr-bgbtn" data-bg="kraft"><i style="background:#d9b98c"></i>{{ _('Kraft') }}</button>
        </div>
        <input type="text" id="dr-signature" maxlength="80" placeholder="{{ _('Votre prénom (optionnel)') }}" class="block w-full mt-3 p-2 border border-gray-300 rounded">
        <button type="button" id="dr-send" class="w-full mt-3 bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded">{{ _('Envoyer le dessin') }}</button>
        <p id="dr-status" class="text-center text-sm mt-3"></p>
      </div>
      <style>
        .dr-stage { position: relative; }
        .dr-canvas { width: 100%; border-radius: 14px; border: 1px solid #d1d5db; touch-action: none; background: #fffdf6; display: block; box-shadow: 0 2px 10px rgba(0,0,0,.06); }
        .dr-hint { position: absolute; left: 50%; top: 10px; transform: translateX(-50%); margin: 0; background: rgba(17,24,39,.75); color: #fff; font-size: .78rem; padding: .25rem .7rem; border-radius: 999px; pointer-events: none; white-space: nowrap; }
        .dr-bar { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: .4rem; margin-top: .6rem; }
        .dr-modes { display: flex; background: #f3f4f6; border-radius: 12px; padding: 3px; gap: 3px; }
        .dr-mode { border: 0; background: none; border-radius: 9px; padding: .35rem .45rem; font-size: 1.05rem; display: flex; align-items: center; gap: .3rem; }
        .dr-mode span { font-size: .78rem; font-weight: 600; color: #4b5563; }
        .dr-mode.on { background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.15); }
        .dr-mode.on span { color: #1d4ed8; }
        @media (max-width: 380px) { .dr-mode span { display: none; } }
        .dr-actions { display: flex; gap: .3rem; }
        .dr-icon { width: 36px; height: 36px; border-radius: 10px; border: 1px solid #e5e7eb; background: #fff; font-size: 1.15rem; color: #111827; }
        .dr-panel { margin-top: .5rem; display: flex; align-items: center; gap: .6rem; }
        .dr-panel[hidden], .dr-hint[hidden] { display: none; }
        .dr-scroll { display: flex; gap: .4rem; overflow-x: auto; padding: 4px 2px; flex: 1; scrollbar-width: none; -webkit-overflow-scrolling: touch; }
        .dr-scroll::-webkit-scrollbar { display: none; }
        .dr-color { flex: none; width: 32px; height: 32px; border-radius: 50%; border: 3px solid #fff; box-shadow: 0 0 0 1px #d1d5db; }
        .dr-color.on { box-shadow: 0 0 0 3px #2563eb; }
        .dr-sizes { display: flex; gap: .3rem; flex: none; }
        .dr-size { width: 36px; height: 36px; border-radius: 10px; border: 2px solid #e5e7eb; background: #fff; display: inline-flex; align-items: center; justify-content: center; }
        .dr-size.on { border-color: #2563eb; }
        .dr-size span { display: block; border-radius: 50%; background: #333; }
        .dr-sticker { flex: none; width: 44px; height: 44px; border-radius: 12px; border: 2px solid transparent; background: #f9fafb; font-size: 1.5rem; line-height: 1; }
        .dr-sticker.on { border-color: #2563eb; background: #eff6ff; }
        .dr-bgs { display: flex; justify-content: center; gap: .4rem; margin-top: .6rem; }
        .dr-bgbtn { display: flex; align-items: center; gap: .35rem; border: 1px solid #e5e7eb; background: #fff; color: #374151; border-radius: 999px; padding: .25rem .7rem; font-size: .82rem; }
        .dr-bgbtn i { width: 14px; height: 14px; border-radius: 50%; border: 1px solid #d1d5db; display: inline-block; }
        .dr-bgbtn.on { border-color: #2563eb; color: #1d4ed8; font-weight: 600; }
      </style>
      <script>
        (() => {
          const $ = (id) => document.getElementById(id);
          const canvas = $("dr-canvas"), ctx = canvas.getContext("2d");
          canvas.width = 1280;
          canvas.height = Math.round(1280 * {{ frame_height }} / {{ frame_width }});
          const BACKGROUNDS = { paper: "#fffdf6", slate: "#2f3b33", kraft: "#d9b98c" };
          const DARK_BG = { slate: true };
          const COLORS = ["#222222", "#ffffff", "#e53935", "#fb8c00", "#fdd835", "#43a047", "#1e88e5", "#8e24aa", "#ec407a", "#795548"];
          const STICKERS = ["❤️", "😘", "😂", "🥰", "🎉", "🎂", "🎈", "🌞", "🌈", "⭐", "🌸", "🍀", "🐶", "🐱", "🦄", "👍", "🏖️", "⛄", "🎄", "🎃"];
          let mode = "pen", background = "paper", color = COLORS[0], size = 10, sticker = STICKERS[0], current = null;
          const ops = [];
          const point = (e) => { const r = canvas.getBoundingClientRect(); return [(e.clientX - r.left) * canvas.width / r.width, (e.clientY - r.top) * canvas.height / r.height]; };
          function stroke(op, from) {
            ctx.lineCap = ctx.lineJoin = "round";
            ctx.strokeStyle = op.erase ? BACKGROUNDS[background] : op.color;
            ctx.lineWidth = op.size;
            ctx.beginPath();
            const pts = op.points;
            const start = Math.max(0, from || 0);
            ctx.moveTo(pts[start][0], pts[start][1]);
            if (pts.length === 1) ctx.lineTo(pts[0][0] + 0.1, pts[0][1]);
            for (let i = start + 1; i < pts.length; i++) ctx.lineTo(pts[i][0], pts[i][1]);
            ctx.stroke();
          }
          function draw(op) {
            if (op.type === "stroke") return stroke(op);
            ctx.font = `${op.size}px "Apple Color Emoji","Segoe UI Emoji","Noto Color Emoji",sans-serif`;
            ctx.textAlign = "center"; ctx.textBaseline = "middle";
            ctx.fillText(op.emoji, op.x, op.y);
          }
          function redraw() {
            ctx.fillStyle = BACKGROUNDS[background];
            ctx.fillRect(0, 0, canvas.width, canvas.height);
            ops.forEach(draw);
          }
          function selectColor(c) {
            color = c;
            document.querySelectorAll(".dr-color").forEach(o => o.classList.toggle("on", o.dataset.color === c));
          }
          COLORS.forEach(c => {
            const b = document.createElement("button"); b.type = "button"; b.className = "dr-color"; b.style.background = c; b.dataset.color = c;
            b.setAttribute("aria-label", c);
            b.addEventListener("click", () => { selectColor(c); setMode("pen"); });
            $("dr-colors").appendChild(b);
          });
          STICKERS.forEach(emoji => {
            const b = document.createElement("button"); b.type = "button"; b.className = "dr-sticker"; b.textContent = emoji;
            b.addEventListener("click", () => { sticker = emoji; refresh(); });
            $("dr-stickers").appendChild(b);
          });
          function setMode(next) { mode = next; refresh(); }
          function refresh() {
            document.querySelectorAll(".dr-mode").forEach(b => b.classList.toggle("on", b.dataset.mode === mode));
            document.querySelectorAll(".dr-sticker").forEach(b => b.classList.toggle("on", b.textContent === sticker));
            $("dr-pen-panel").hidden = mode === "sticker";
            $("dr-sticker-panel").hidden = mode !== "sticker";
            $("dr-hint").hidden = mode !== "sticker";
          }
          document.querySelectorAll(".dr-mode").forEach(b => b.addEventListener("click", () => setMode(b.dataset.mode)));
          document.querySelectorAll(".dr-size").forEach(b => b.addEventListener("click", () => {
            size = Number(b.dataset.size); document.querySelectorAll(".dr-size").forEach(o => o.classList.toggle("on", o === b));
          }));
          document.querySelectorAll(".dr-bgbtn").forEach(b => b.addEventListener("click", () => {
            background = b.dataset.bg;
            document.querySelectorAll(".dr-bgbtn").forEach(o => o.classList.toggle("on", o === b));
            // Une couleur qui se voit sur le fond choisi (noir sur l'ardoise, blanc sur le papier : invisibles)
            if (DARK_BG[background] && color === "#222222") selectColor("#ffffff");
            if (!DARK_BG[background] && color === "#ffffff") selectColor("#222222");
            redraw();
          }));
          $("dr-undo").addEventListener("click", () => { ops.pop(); redraw(); });
          $("dr-clear").addEventListener("click", () => { ops.length = 0; redraw(); });
          canvas.addEventListener("pointerdown", (e) => {
            e.preventDefault();
            const [x, y] = point(e);
            if (mode === "sticker") { ops.push({ type: "sticker", emoji: sticker, x, y, size: canvas.width * 0.09 }); redraw(); return; }
            current = { type: "stroke", color, size: mode === "eraser" ? size * 3 : size, erase: mode === "eraser", points: [[x, y]] };
            canvas.setPointerCapture(e.pointerId);
            stroke(current);
          });
          canvas.addEventListener("pointermove", (e) => {
            if (!current) return;
            current.points.push(point(e));
            stroke(current, current.points.length - 2);
          });
          const finish = () => { if (current) { ops.push(current); current = null; } };
          canvas.addEventListener("pointerup", finish);
          canvas.addEventListener("pointercancel", finish);
          selectColor(color);
          refresh();
          redraw();
          $("dr-send").addEventListener("click", () => {
            const status = (t, ok) => { $("dr-status").textContent = t; $("dr-status").className = "text-center text-sm mt-3 " + (ok ? "text-green-700" : "text-red-600"); };
            const visible = ops.some(op => op.type === "sticker" || (!op.erase && op.color !== BACKGROUNDS[background]));
            if (!visible) { status({{ _("Faites d'abord un dessin.")|tojson }}, false); return; }
            $("dr-send").disabled = true;
            canvas.toBlob(async (blob) => {
              const form = new FormData();
              form.append("drawing", blob, "dessin.png");
              form.append("signature", $("dr-signature").value.trim());
              try {
                const r = await (await fetch("{{ url_for('guest_drawing_publish') }}", { method: "POST", body: form })).json();
                status(r.message, r.success);
                if (r.success) { ops.length = 0; redraw(); }
              } catch (err) {
                status({{ _("Échec de l'envoi. Vérifiez la connexion au cadre.")|tojson }}, false);
              } finally {
                $("dr-send").disabled = false;
              }
            }, "image/png");
          });
        })();
      </script>
      {% endif %}
      <details id="install-help" class="mt-6 text-sm text-gray-700">
        <summary class="cursor-pointer text-blue-600">{{ _("Ajouter cette page à l'écran d'accueil du téléphone") }}</summary>
        <ul class="list-disc ml-5 mt-2 space-y-1">
          <li><strong>iPhone / iPad</strong> : {{ _("dans Safari, touchez le bouton Partager puis « Sur l'écran d'accueil ».") }}</li>
          <li><strong>Android</strong> : {{ _("dans Chrome, ouvrez le menu ⋮ puis « Ajouter à l'écran d'accueil ».") }}</li>
        </ul>
        <p class="mt-2">{{ _("Pimmich s'ouvrira alors comme une application, directement sur cette page.") }}</p>
      </details>
      <div class="mt-6 pt-6 border-t border-gray-300 text-center">
        <a href="{{ url_for('login') }}" class="text-blue-600 hover:underline">{{ _('Retour à la connexion
          administrateur') }}</a>
      </div>
      <div class="text-center mt-6 text-sm">
        <span class="font-semibold">{{ _('Langue') }}:</span>
        {% set current_lang = get_locale() %}
        <a href="?lang=fr"
          class="{% if current_lang == 'fr' %}font-bold text-indigo-600{% else %}text-blue-600 hover:underline{% endif %}">FR</a>
        |
        <a href="?lang=en"
          class="{% if current_lang == 'en' %}font-bold text-indigo-600{% else %}text-blue-600 hover:underline{% endif %}">EN</a>
        |
        <a href="?lang=es"
          class="{% if current_lang == 'es' %}font-bold text-indigo-600{% else %}text-blue-600 hover:underline{% endif %}">ES</a>
        |
        <a href="?lang=de"
          class="{% if current_lang == 'de' %}font-bold text-indigo-600{% else %}text-blue-600 hover:underline{% endif %}">DE</a>
        |
        <a href="?lang=ja"
          class="{% if current_lang == 'ja' %}font-bold text-indigo-600{% else %}text-blue-600 hover:underline{% endif %}">JA</a>
      </div>
    </div>
  </div>

  {% if guest_messages_enabled %}
  <script>
    (function () {
      const $ = (id) => document.getElementById(id);
      const status = (text, ok) => { $("gm-status").textContent = text; $("gm-status").className = "text-center text-sm mt-3 " + (ok ? "text-green-600" : "text-red-600"); };
      const data = () => ({ title: $("gm-title").value, body: $("gm-body").value, signature: $("gm-signature").value, style: $("gm-style").value });
      $("gm-preview").addEventListener("click", async () => {
        const resp = await fetch("{{ url_for('guest_message_preview') }}", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(data()) });
        if (!resp.ok) { status((await resp.json()).message, false); return; }
        const img = $("gm-preview-img");
        if (img.src.startsWith("blob:")) URL.revokeObjectURL(img.src);
        img.src = URL.createObjectURL(await resp.blob());
        img.classList.remove("hidden");
        status("", true);
      });
      $("gm-publish").addEventListener("click", async () => {
        $("gm-publish").disabled = true;
        try {
          const resp = await fetch("{{ url_for('guest_message_publish') }}", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(data()) });
          const result = await resp.json();
          status(result.message, result.success);
          if (result.success) { ["gm-title", "gm-body"].forEach(id => $(id).value = ""); $("gm-preview-img").classList.add("hidden"); }
        } catch (e) {
          status({{ _("Échec de l'envoi. Vérifiez la connexion au cadre.")|tojson }}, false);
        } finally {
          $("gm-publish").disabled = false;
        }
      });
    })();
  </script>
  {% endif %}
  <script>
    // Envoi avec barre de progression (les photos de téléphone sont lourdes) ; sans JavaScript, le formulaire reste classique
    document.getElementById("upload-form").addEventListener("submit", (event) => {
      const form = event.target;
      if (!window.XMLHttpRequest || !window.FormData) return;
      event.preventDefault();
      const button = form.querySelector("button[type=submit]");
      const bar = document.getElementById("upload-progress-bar");
      const text = document.getElementById("upload-progress-text");
      const files = form.querySelector("input[type=file]").files;
      button.disabled = true;
      document.getElementById("upload-progress").classList.remove("hidden");
      text.textContent = `${files.length} ` + {{ _("fichier(s) en cours d'envoi...")|tojson }};
      const xhr = new XMLHttpRequest();
      xhr.open("POST", form.action);
      xhr.upload.onprogress = (e) => {
        if (!e.lengthComputable) return;
        const percent = Math.round(100 * e.loaded / e.total);
        bar.style.width = percent + "%";
        bar.textContent = percent + "%";
      };
      xhr.onload = () => {
        if (xhr.status === 413) {
          text.textContent = {{ _('Envoi trop volumineux : envoyez moins de fichiers à la fois.')|tojson }};
          button.disabled = false;
          return;
        }
        window.location.href = xhr.responseURL || window.location.href;  // affiche le message de confirmation
      };
      xhr.onerror = () => { text.textContent = {{ _("Échec de l'envoi. Vérifiez la connexion au cadre.")|tojson }}; button.disabled = false; };
      xhr.send(new FormData(form));
    });
  </script>
</body>

</html>