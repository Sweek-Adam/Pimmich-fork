<!DOCTYPE html>
<html lang="{{ get_locale() }}">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ _('Envoyer des photos') }} - Pimmich</title>
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
  <link rel="stylesheet" href="{{ url_for('static', filename='styles.css') }}">
  <link rel="icon" type="image/x-icon" href="{{ url_for('static', filename='favicon.ico') }}">
  <!-- Installation sur l'écran d'accueil du téléphone -->
  <link rel="manifest" href="{{ url_for('static', filename='pwa/manifest.json') }}">
  <link rel="apple-touch-icon" href="{{ url_for('static', filename='pwa/apple-touch-icon.png') }}">
  <meta name="theme-color" content="#3b82f6">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-title" content="Pimmich">
</head>

<body class="relative min-h-screen">

  <!-- Messages flash -->
  {% with messages = get_flashed_messages(with_categories=true) %}
  {% if messages %}
  <div id="flash-container" class="absolute top-0 mt-4 max-w-xs w-full z-20">
    {% for category, message in messages %}
    <div class="
          flash-message
          px-4 py-3 rounded-md text-white shadow-md transition-opacity duration-700 ease-in-out
          {% if category == 'success' %}
            bg-green-500
          {% elif category == 'error' %}
            bg-red-500
          {% else %}
            bg-gray-500
          {% endif %}
        ">
      {{ message }}
    </div>
    {% endfor %}
  </div>
  <script>
    // Disparition automatique après 4 secondes
    setTimeout(() => {
      const messages = document.querySelectorAll('.flash-message');
      messages.forEach(msg => {
        msg.classList.add('opacity-0');
        setTimeout(() => msg.remove(), 700); // attendre que l'effet se termine
      });
    }, 4000);
  </script>
  {% endif %}
  {% endwith %}

  <div class="flex items-center justify-center min-h-screen">
    <div class="w-11/12 max-w-lg p-6 md:p-8 bg-white bg-opacity-90 backdrop-blur-md rounded-2xl shadow-xl">
      <img src="{{ url_for('static', filename='pimmich_logo.png') }}" alt="Logo Pimmich" class="w-40 mx-auto mb-8">
      <h2 class="text-center text-2xl font-semibold mb-4">{{ _('Envoyer des photos pour le cadre') }}</h2>
      <p class="text-center text-gray-600 mb-6">{{ _('Les photos seront soumises à validation avant d\'être affichées.')
        }}</p>

      <form id="upload-form" method="POST" action="{{ url_for('handle_upload') }}" enctype="multipart/form-data">
        <div class="mb-4">
          <input type="file" name="photos" multiple required accept="image/*,video/*"
            class="block w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 cursor-pointer focus:outline-none">
        </div>
        <div id="upload-progress" class="hidden mt-4">
          <div class="w-full bg-gray-200 rounded-full h-4 overflow-hidden">
            <div id="upload-progress-bar" class="bg-blue-500 h-4 text-xs text-white text-center leading-4" style="width: 0%">0%</div>
          </div>
          <p id="upload-progress-text" class="text-center text-sm text-gray-600 mt-2"></p>
        </div>

        <div class="flex items-center justify-center mt-8">
          <button type="submit"
            class="bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded focus:outline-none focus:shadow-outline transition duration-150 ease-in-out w-full">
            {{ _('Envoyer') }}
          </button>
        </div>
      </form>
      <details id="install-help" class="mt-6 text-sm text-gray-700">
        <summary class="cursor-pointer text-blue-600">{{ _("Ajouter cette page à l'écran d'accueil du téléphone") }}</summary>
        <ul class="list-disc ml-5 mt-2 space-y-1">
          <li><strong>iPhone / iPad</strong> : {{ _("dans Safari, touchez le bouton Partager puis « Sur l'écran d'accueil ».") }}</li>
          <li><strong>Android</strong> : {{ _("dans Chrome, ouvrez le menu ⋮ puis « Ajouter à l'écran d'accueil ».") }}</li>
        </ul>
        <p class="mt-2">{{ _("Pimmich s'ouvrira alors comme une application, directement sur cette page.") }}</p>
      </details>
      <div class="mt-6 pt-6 border-t border-gray-300 text-center">
        <a href="{{ url_for('login') }}" class="text-blue-600 hover:underline">{{ _('Retour à la connexion
          administrateur') }}</a>
      </div>
      <div class="text-center mt-6 text-sm">
        <span class="font-semibold">{{ _('Langue') }}:</span>
        {% set current_lang = get_locale() %}
        <a href="?lang=fr"
          class="{% if current_lang == 'fr' %}font-bold text-indigo-600{% else %}text-blue-600 hover:underline{% endif %}">FR</a>
        |
        <a href="?lang=en"
          class="{% if current_lang == 'en' %}font-bold text-indigo-600{% else %}text-blue-600 hover:underline{% endif %}">EN</a>
        |
        <a href="?lang=es"
          class="{% if current_lang == 'es' %}font-bold text-indigo-600{% else %}text-blue-600 hover:underline{% endif %}">ES</a>
        |
        <a href="?lang=de"
          class="{% if current_lang == 'de' %}font-bold text-indigo-600{% else %}text-blue-600 hover:underline{% endif %}">DE</a>
        |
        <a href="?lang=ja"
          class="{% if current_lang == 'ja' %}font-bold text-indigo-600{% else %}text-blue-600 hover:underline{% endif %}">JA</a>
      </div>
    </div>
  </div>

  <script>
    // Envoi avec barre de progression (les photos de téléphone sont lourdes) ; sans JavaScript, le formulaire reste classique
    document.getElementById("upload-form").addEventListener("submit", (event) => {
      const form = event.target;
      if (!window.XMLHttpRequest || !window.FormData) return;
      event.preventDefault();
      const button = form.querySelector("button[type=submit]");
      const bar = document.getElementById("upload-progress-bar");
      const text = document.getElementById("upload-progress-text");
      const files = form.querySelector("input[type=file]").files;
      button.disabled = true;
      document.getElementById("upload-progress").classList.remove("hidden");
      text.textContent = `${files.length} {{ _("fichier(s) en cours d'envoi...") }}`;
      const xhr = new XMLHttpRequest();
      xhr.open("POST", form.action);
      xhr.upload.onprogress = (e) => {
        if (!e.lengthComputable) return;
        const percent = Math.round(100 * e.loaded / e.total);
        bar.style.width = percent + "%";
        bar.textContent = percent + "%";
      };
      xhr.onload = () => {
        if (xhr.status === 413) {
          text.textContent = "{{ _('Envoi trop volumineux : envoyez moins de fichiers à la fois.') }}";
          button.disabled = false;
          return;
        }
        window.location.href = xhr.responseURL || window.location.href;  // affiche le message de confirmation
      };
      xhr.onerror = () => { text.textContent = "{{ _('Échec de l\'envoi. Vérifiez la connexion au cadre.') }}"; button.disabled = false; };
      xhr.send(new FormData(form));
    });
  </script>
</body>

</html>