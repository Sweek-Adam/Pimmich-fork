<!DOCTYPE html>
{#- Page de configuration. Chaque onglet est dans templates/configure/tab_<nom>.html.jinja,
    les styles dans configure/styles.html.jinja et le JavaScript dans configure/scripts_*.html.jinja. -#}
<html lang="{{ get_locale() }}">

<head>
    <meta charset="UTF-8">
    <title>{{ _('Configuration') }} - Pimmich</title>
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="{{ url_for('static', filename='styles.css') }}">
    <link rel="icon" type="image/x-icon" href="{{ url_for('static', filename='favicon.ico') }}">
    <!-- GLightbox CSS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox/dist/css/glightbox.min.css" />
    <!-- Font Awesome pour les icônes -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <!-- Chart.js pour les graphiques -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
{% include 'configure/styles.html.jinja' %}
</head>

<body class="relative min-h-screen">

    <!-- Global Notification Toast -->
    <div id="global-toast"
        class="hidden fixed bottom-5 right-5 bg-green-600 text-white py-2 px-4 rounded-lg shadow-lg transition-all duration-300 ease-in-out transform translate-y-10 opacity-0 z-50">
        <p id="global-toast-message"></p>
    </div>

    {% if disk_alert %}
    <div class="max-w-xl mx-auto mt-4 p-3 rounded border border-red-300 bg-red-50 text-red-800 text-sm">
        <i class="fas fa-hdd mr-1"></i>{{ _("Espace disque faible : %(free)s Go libres (seuil : %(threshold)s Go). Supprimez des photos ou activez le nettoyage automatique dans Système > Maintenance.", free=disk_alert.free_gb, threshold=disk_alert.threshold_gb) }}
    </div>
    {% endif %}
    <!-- Messages flash -->
    {% with messages = get_flashed_messages(with_categories=true) %}
    {% if messages %}
    <div id="flash-container" class="relative z-10 max-w-xl mx-auto mt-4 space-y-2">
        {% for category, message in messages %}
        <div class="
          flash-message
          px-4 py-3 rounded-md text-white shadow-md transition-opacity duration-700 ease-in-out
          {% if category == 'success' %}
            bg-green-500
          {% elif category == 'error' %}
            bg-red-500
          {% elif category == 'warning' %}
            bg-yellow-400 text-black
          {% else %}
            bg-gray-500
          {% endif %}
        ">
            {{ message }}
        </div>
        {% endfor %}
    </div>

    <script>
        // Disparition automatique après 4 secondes
        setTimeout(() => {
            const messages = document.querySelectorAll('.flash-message');
            messages.forEach(msg => {
                msg.classList.add('opacity-0');
                setTimeout(() => msg.remove(), 700); // attendre que l'effet se termine
            });
        }, 4000);
    </script>
    {% endif %}
    {% endwith %}

    <!-- Contenu principal -->
    <div class="relative z-10 container mx-auto p-4 bg-white/80 backdrop-blur-md rounded-xl shadow-xl mt-8">
        <div class="flex justify-between items-center mb-4">
            <div class="language-selector text-sm">
                <span class="font-semibold">{{ _('Langue') }}:</span>
                {% set current_lang = get_locale() %}
                <a href="?lang=fr"
                    class="{% if current_lang == 'fr' %}font-bold text-indigo-600{% else %}text-blue-600 hover:underline{% endif %}">FR</a>
                |
                <a href="?lang=en"
                    class="{% if current_lang == 'en' %}font-bold text-indigo-600{% else %}text-blue-600 hover:underline{% endif %}">EN</a>
                |
                <a href="?lang=es"
                    class="{% if current_lang == 'es' %}font-bold text-indigo-600{% else %}text-blue-600 hover:underline{% endif %}">ES</a>
                |
                <a href="?lang=de"
                    class="{% if current_lang == 'de' %}font-bold text-indigo-600{% else %}text-blue-600 hover:underline{% endif %}">DE</a>
                |
                <a href="?lang=ja"
                    class="{% if current_lang == 'ja' %}font-bold text-indigo-600{% else %}text-blue-600 hover:underline{% endif %}">JA</a>
            </div>
            <div class="logout-link">
                {% if current_username %}
                <span class="text-gray-600 mr-2"><i class="fas fa-user mr-1"></i>{{ current_username }}{% if not is_admin %} ({{ _("utilisateur") }}){% endif %}</span>
                {% endif %}
                <a href="/logout">{{ _('Se déconnecter') }}</a>
            </div>
        </div>
        <div class="flex justify-between items-center mb-2 h-auto py-2">
            <div class="flex items-center gap-4">
                <a href="https://github.com/gotenash" target="_blank" rel="noopener noreferrer">
                    <img src="{{ url_for('static', filename='gotenash.jpg') }}" alt="Avatar Gotenash"
                        class="h-16 w-16 rounded-full object-cover shadow-md">
                </a>
                <a href="https://github.com/Sigalou" target="_blank" rel="noopener noreferrer">
                    <img src="{{ url_for('static', filename='sigalou.png') }}" alt="Avatar Sigalou"
                        class="h-16 w-16 rounded-full object-cover shadow-md">
                </a>
                <a href="https://www.gadgetaulab.fr" target="_blank" rel="noopener noreferrer">
                    <img src="{{ url_for('static', filename='logo_gadgeto.png') }}" alt="Logo Gadgetaulab" class="h-16">
                </a>
            </div>

            <img src="{{ url_for('static', filename='pimmich_logo.png') }}" alt="Logo Pimmich" class="h-16">

            {% from 'configure/_layout_select.html.jinja' import layout_select %}
            <div id="live-preview-container" class="cadre-bois p-4 flex flex-col items-center">
                <p id="live-preview-status" class="text-gray-500 italic hidden">{{ _("Le diaporama est arrêté.") }}</p>

                <div id="live-preview-box" class="relative mt-1 w-64 h-40 flex items-center justify-center bg-gray-100 rounded-lg shadow-inner overflow-hidden border border-gray-200 hidden">
                    <img id="live-preview-image" src="" alt="{{ _('Photo en cours') }}"
                        class="max-w-full max-h-full object-contain">

                    <!-- Boutons de contrôle toujours visibles, en bas de l'image -->
                    <div id="live-preview-controls"
                        class="absolute bottom-2 left-0 right-0 flex items-center justify-center gap-3 hidden">
                        <button type="button"
                            class="notification-toggle-btn bg-blue-600 hover:bg-blue-700 text-white p-2 rounded-full w-8 h-8 flex items-center justify-center shadow-md transition-transform transform hover:scale-110"
                            title="{{ _('Activer/Désactiver les notifications') }}">
                            <i class="fas fa-bell fa-xs"></i>
                        </button>
                        <button type="button"
                            class="slideshow-control-btn bg-blue-600 hover:bg-blue-700 text-white p-2 rounded-full w-8 h-8 flex items-center justify-center shadow-md transition-transform transform hover:scale-110"
                            data-command="previous" title="{{ _('Photo précédente') }}">
                            <i class="fas fa-backward fa-xs"></i>
                        </button>
                        <button type="button"
                            class="slideshow-control-btn bg-blue-600 hover:bg-blue-700 text-white p-2 rounded-full w-8 h-8 flex items-center justify-center shadow-md transition-transform transform hover:scale-110"
                            data-command="toggle_pause" title="{{ _('Pause/Lecture') }}">
                            <i class="slideshow-pause-icon fas fa-pause fa-xs"></i>
                        </button>
                        <button type="button"
                            class="slideshow-control-btn bg-blue-600 hover:bg-blue-700 text-white p-2 rounded-full w-8 h-8 flex items-center justify-center shadow-md transition-transform transform hover:scale-110"
                            data-command="next" title="{{ _('Photo suivante') }}">
                            <i class="fas fa-forward fa-xs"></i>
                        </button>
                    </div>
                </div>
                <div class="mt-2 flex items-center gap-1 text-xs" title="{{ _('Disposition du diaporama') }}">
                    <i class="fas fa-th-large text-gray-600"></i>
                    {{ layout_select("layout-override-header", layout_override, _("Selon les réglages"), "layout-override-select text-xs py-0 rounded border-gray-300") }}
                </div>
            </div>
        </div>

        <!-- Nouvelle navigation par groupes -->
        <div id="main-nav" class="flex justify-center space-x-1 sm:space-x-2 p-1 bg-transparent rounded-lg mb-4">
            <button class="main-nav-link inline-flex items-center" data-group="group-diaporama"><i
                    class="fas fa-desktop fa-fw mr-2"></i>{{ _('Diaporama') }}</button>
            <button class="main-nav-link inline-flex items-center" data-group="group-contenu"><i
                    class="fas fa-photo-video fa-fw mr-2"></i>{{ _('Contenu') }}</button>
            <button class="main-nav-link inline-flex items-center" data-group="group-interactions"><i
                    class="fas fa-comments fa-fw mr-2"></i>{{ _('Interactions') }} <span id="interactions-pending-badge"
                    class="hidden bg-red-500 text-white text-xs font-bold rounded-full h-5 w-5 inline-flex items-center justify-center ml-1">0</span></button>
            <button class="main-nav-link inline-flex items-center" data-group="group-maintenance"><i
                    class="fas fa-server fa-fw mr-2"></i>{{ _('Système') }}</button>
        </div>

        <!-- Conteneurs de sous-navigation pour chaque groupe -->
        <div id="group-diaporama" class="sub-nav-group hidden">
            <div class="tabs flex overflow-x-auto pb-2">
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-affichage')"
                    title="{{ _('Gérez les paramètres d\'affichage du diaporama, la durée, les transitions...') }}"><i
                        class="fas fa-desktop fa-fw mr-2"></i>{{ _('Affichage') }}</button>
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-dispositions')"
                    title="{{ _('Photo unique, compositions et thèmes : choisissez comment les photos sont présentées.') }}"><i
                        class="fas fa-th-large fa-fw mr-2"></i>{{ _('Dispositions') }}</button>
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-heure')"
                    title="{{ _('Configurez l\'affichage de l\'heure, la météo et les marées.') }}"><i
                        class="fas fa-clock fa-fw mr-2"></i>{{ _('Horloge & Infos') }}</button>
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-vocal')"
                    title="{{ _('Configurez le contrôle vocal du diaporama.') }}"><i
                        class="fas fa-microphone-alt fa-fw mr-2"></i>{{ _('Vocal') }}</button>
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-metadata')"><i
                        class="fas fa-info-circle fa-fw mr-2"></i>{{ _('Métadonnées') }}</button>
            </div>
        </div>

        <div id="group-contenu" class="sub-nav-group hidden">
            <div class="tabs flex overflow-x-auto pb-2">
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-sources')"
                    title="{{ _('Configurez les sources de photos (Immich, Samba, USB...).') }}"><i
                        class="fas fa-folder-open fa-fw mr-2"></i>{{ _('Sources') }}</button>
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-apercu')"
                    title="{{ _('Visualisez et gérez toutes les photos prêtes pour le diaporama.') }}"><i
                        class="fas fa-eye fa-fw mr-2"></i>{{ _('Aperçu') }}</button>
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-messages')"
                    title="{{ _('Écrivez des messages qui s\'affichent dans le diaporama.') }}"><i
                        class="fas fa-comment-alt fa-fw mr-2"></i>{{ _('Messages') }}</button>
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-queue')"
                    title="{{ _('Voyez et réorganisez les prochaines photos du diaporama.') }}"><i
                        class="fas fa-stream fa-fw mr-2"></i>{{ _('À suivre') }}</button>
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-playlists')"
                    title="{{ _('Créez et gérez vos albums photo personnalisés.') }}"><i
                        class="fas fa-list-ul fa-fw mr-2"></i>{{ _('Playlists') }}</button>
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-favoris')"
                    title="{{ _('Retrouvez et gérez vos photos favorites.') }}"><i class="fas fa-star fa-fw mr-2"></i>{{
                    _('Favoris') }} <span id="favorites-count-badge"
                        class="hidden bg-yellow-400 text-white text-xs font-bold rounded-full h-5 w-5 inline-flex items-center justify-center ml-1">0</span></button>
            </div>
        </div>

        <div id="group-interactions" class="sub-nav-group hidden">
            <div class="tabs flex overflow-x-auto pb-2">
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-telegram')"
                    title="{{ _('Configurez la réception de photos via le bot Telegram.') }}"><i
                        class="fab fa-telegram-plane fa-fw mr-2"></i>{{ _('Telegram') }}</button>
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-validation')"
                    title="{{ _('Validez ou rejetez les photos envoyées par les invités.') }}"><i
                        class="fas fa-check-circle fa-fw mr-2"></i>{{ _('Validation') }} <span id="pending-count-badge"
                        class="hidden bg-red-500 text-white text-xs font-bold rounded-full h-5 w-5 inline-flex items-center justify-center ml-1">0</span></button>
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-actions')"
                    title="{{ _('Lancez les imports, contrôlez le diaporama et envoyez des photos.') }}"><i
                        class="fas fa-cogs fa-fw mr-2"></i>{{ _('Actions') }}</button>
            </div>
        </div>

        <div id="group-maintenance" class="sub-nav-group hidden">
            <div class="tabs flex overflow-x-auto pb-2">
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-comptes')"
                    title="{{ _('Gérez votre mot de passe et les comptes utilisateurs.') }}"><i class="fas fa-users fa-fw mr-2"></i>{{
                    _('Comptes') }}</button>
                {% if is_admin %}
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-network')"
                    title="{{ _('Gérez les paramètres Wi-Fi et réseau.') }}"><i class="fas fa-wifi fa-fw mr-2"></i>{{
                    _('Réseau') }}</button>
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-maintenance')"
                    title="{{ _('Gérez les mises à jour, sauvegardes et contrôles système.') }}"><i
                        class="fas fa-tools fa-fw mr-2"></i>{{ _('Maintenance') }}</button>
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-stats')"
                    title="{{ _('Consultez les statistiques d\'utilisation du système.') }}"><i
                        class="fas fa-chart-bar fa-fw mr-2"></i>{{ _('Statistiques') }}</button>
                <button class="tablink inline-flex items-center" onclick="openTab(event, 'tab-logs')"
                    title="{{ _('Consultez les journaux système.') }}"><i class="fas fa-file-alt fa-fw mr-2"></i>{{
                    _('Logs') }}</button>
                {% endif %}
            </div>
        </div>

        <form method="POST" action="/configure">

{% include 'configure/tab_affichage.html.jinja' %}
{% include 'configure/tab_dispositions.html.jinja' %}


{% include 'configure/tab_heure.html.jinja' %}


{% include 'configure/tab_sources.html.jinja' %}

{% include 'configure/tab_telegram.html.jinja' %}

{% include 'configure/tab_vocal.html.jinja' %}

{% include 'configure/tab_metadata.html.jinja' %}

            <!-- Le bouton de sauvegarde est placé ici, à l'intérieur du formulaire mais après les onglets de configuration -->
            <button type="submit" id="save-changes-btn" class="save-button">{{ _("Enregistrer les modifications")
                }}</button>

        </form>

{% include 'configure/tab_actions.html.jinja' %}

{% include 'configure/tab_validation.html.jinja' %}
{% include 'configure/tab_network.html.jinja' %}

{% include 'configure/tab_comptes.html.jinja' %}

{% include 'configure/tab_maintenance.html.jinja' %}

{% include 'configure/tab_stats.html.jinja' %}

{% include 'configure/tab_logs.html.jinja' %}

{% include 'configure/tab_apercu.html.jinja' %}
{% include 'configure/tab_messages.html.jinja' %}
{% include 'configure/tab_queue.html.jinja' %}

{% include 'configure/tab_playlists.html.jinja' %}

{% include 'configure/tab_favoris.html.jinja' %}


        <script src="https://cdn.jsdelivr.net/npm/glightbox/dist/js/glightbox.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
{% include 'configure/scripts_gallery.html.jinja' %}
{% include 'configure/scripts_main.html.jinja' %}

{% include 'configure/scripts_status.html.jinja' %}
</body>
</html>