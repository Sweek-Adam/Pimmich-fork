<!DOCTYPE html>
{#- Page de configuration. Chaque onglet est dans templates/configure/tab_<nom>.html.jinja,
    les styles dans configure/styles.html.jinja et le JavaScript dans configure/scripts_*.html.jinja. -#}
<html lang="{{ get_locale() }}">

<head>
    <meta charset="UTF-8">
    <title>{{ _('Configuration') }} - Pimmich</title>
    <link href="{{ url_for('static', filename='vendor/tailwind/tailwind.min.css') }}" rel="stylesheet">
    <link rel="stylesheet" href="{{ url_for('static', filename='styles.css') }}">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <meta name="theme-color" content="#4f46e5">
    <link rel="icon" type="image/x-icon" href="{{ url_for('static', filename='favicon.ico') }}">
    <!-- GLightbox CSS -->
    <link rel="stylesheet" href="{{ url_for('static', filename='vendor/glightbox/glightbox.min.css') }}" />
    <!-- Font Awesome pour les icônes -->
    <link rel="stylesheet" href="{{ url_for('static', filename='vendor/fontawesome/css/all.min.css') }}">
    <!-- Chart.js pour les graphiques -->
    <script src="{{ url_for('static', filename='vendor/chartjs/chart.umd.min.js') }}"></script>
{% include 'configure/styles.html.jinja' %}
{% include 'configure/styles_app.html.jinja' %}
</head>

<body class="relative min-h-screen">

    <!-- Global Notification Toast -->
    <div id="global-toast"
        class="hidden fixed bottom-5 right-5 bg-green-600 text-white py-2 px-4 rounded-lg shadow-lg transition-all duration-300 ease-in-out transform translate-y-10 opacity-0 z-50">
        <p id="global-toast-message"></p>
    </div>

    <!-- Messages flash -->
    {% with messages = get_flashed_messages(with_categories=true) %}
    {% if messages %}
    <div id="flash-container" class="relative z-10 max-w-xl mx-auto mt-4 space-y-2">
        {% for category, message in messages %}
        <div class="
          flash-message
          px-4 py-3 rounded-md text-white shadow-md transition-opacity duration-700 ease-in-out
          {% if category == 'success' %}
            bg-green-500
          {% elif category == 'error' %}
            bg-red-500
          {% elif category == 'warning' %}
            bg-yellow-400 text-black
          {% else %}
            bg-gray-500
          {% endif %}
        ">
            {{ message }}
        </div>
        {% endfor %}
    </div>

    <script>
        // Disparition automatique après 4 secondes
        setTimeout(() => {
            const messages = document.querySelectorAll('.flash-message');
            messages.forEach(msg => {
                msg.classList.add('opacity-0');
                setTimeout(() => msg.remove(), 700); // attendre que l'effet se termine
            });
        }, 4000);
    </script>
    {% endif %}
    {% endwith %}

    {% set current_lang = get_locale() %}
    <!-- Structure de l'application : menu latéral (ordinateur), barre du bas (téléphone) -->
    <div id="app-shell">
        <aside id="app-sidebar">
            <a class="app-brand" href="#" onclick="goToTab('tab-accueil'); return false;">
                <img src="{{ url_for('static', filename='pwa/icon-192.png') }}" alt="" class="app-brand-icon">
                <span>Pimmich</span>
            </a>
            <nav class="app-nav">
                {% for group, icon, label in [('group-accueil', 'fa-home', _('Accueil')), ('group-photos', 'fa-images', _('Photos')), ('group-ecran', 'fa-tv', _('Écran')), ('group-partage', 'fa-user-friends', _('Partage')), ('group-systeme', 'fa-cog', _('Système'))] %}
                <button type="button" class="main-nav-link" data-group="{{ group }}"><i class="fas {{ icon }} fa-fw"></i><span>{{ label }}</span>{% if group == 'group-partage' %}<span id="interactions-pending-badge" class="nav-badge hidden">0</span>{% endif %}</button>
                {% endfor %}
            </nav>
            <div class="app-credits">
                {{ _("Pimmich par") }} <a href="https://github.com/gotenash" target="_blank" rel="noopener noreferrer">Gotenash</a>
                &amp; <a href="https://github.com/Sigalou" target="_blank" rel="noopener noreferrer">Sigalou</a>
                · <a href="https://www.gadgetaulab.fr" target="_blank" rel="noopener noreferrer">Gadgetaulab</a>
            </div>
        </aside>

        <div id="app-content">
            <header id="app-topbar">
                <h1 id="app-section-title">{{ _('Accueil') }}</h1>
                <div class="app-search">
                    <i class="fas fa-search"></i>
                    <input type="search" id="settings-search" placeholder="{{ _('Rechercher un réglage…') }}" autocomplete="off">
                    <div id="settings-search-results" class="hidden"></div>
                </div>
                <span id="app-status-pill" class="status-pill" title="{{ _('État du diaporama') }}"><span class="dot"></span><span class="label">…</span></span>
                <details class="app-user-menu">
                    <summary><i class="fas fa-user-circle"></i><span class="hidden md:inline">{{ current_username or '' }}</span></summary>
                    <div class="menu">
                        {% if not is_admin %}<p class="text-xs text-gray-500 mb-2">{{ _("Compte utilisateur") }}</p>{% endif %}
                        <p class="text-xs font-semibold text-gray-500 mb-1">{{ _('Langue') }}</p>
                        <div class="flex gap-2 mb-3">
                            {% for code in ['fr', 'en', 'es', 'de', 'ja'] %}<a href="?lang={{ code }}" class="lang {% if current_lang == code %}active{% endif %}">{{ code|upper }}</a>{% endfor %}
                        </div>
                        <a href="#" onclick="goToTab('tab-comptes'); this.closest('details').open = false; return false;"><i class="fas fa-key fa-fw"></i> {{ _('Mon compte') }}</a>
                        <a href="/logout"><i class="fas fa-sign-out-alt fa-fw"></i> {{ _('Se déconnecter') }}</a>
                    </div>
                </details>
            </header>

            <!-- Sous-rubriques de chaque rubrique -->
            <div id="group-accueil" class="sub-nav-group hidden">
                <div class="tabs single"><button type="button" class="tablink" onclick="openTab(event, 'tab-accueil')"><i class="fas fa-home fa-fw"></i>{{ _('Accueil') }}</button></div>
            </div>
            <div id="group-photos" class="sub-nav-group hidden">
                <div class="tabs">
                    <button type="button" class="tablink" onclick="openTab(event, 'tab-actions')"><i class="fas fa-file-import fa-fw"></i>{{ _('Importer') }}</button>
                    <button type="button" class="tablink" onclick="openTab(event, 'tab-sources')"><i class="fas fa-folder-open fa-fw"></i>{{ _('Sources') }}</button>
                    <button type="button" class="tablink" onclick="openTab(event, 'tab-apercu')"><i class="fas fa-th fa-fw"></i>{{ _('Bibliothèque') }}</button>
                    <button type="button" class="tablink" onclick="openTab(event, 'tab-queue')"><i class="fas fa-stream fa-fw"></i>{{ _('À suivre') }}</button>
                    <button type="button" class="tablink" onclick="openTab(event, 'tab-playlists')"><i class="fas fa-list-ul fa-fw"></i>{{ _('Playlists') }}</button>
                    <button type="button" class="tablink" onclick="openTab(event, 'tab-favoris')"><i class="fas fa-star fa-fw"></i>{{ _('Favoris') }} <span id="favorites-count-badge" class="nav-badge yellow hidden">0</span></button>
                    <button type="button" class="tablink" onclick="openTab(event, 'tab-messages')"><i class="fas fa-comment-alt fa-fw"></i>{{ _('Messages') }}</button>
                </div>
            </div>
            <div id="group-ecran" class="sub-nav-group hidden">
                <div class="tabs">
                    <button type="button" class="tablink" onclick="openTab(event, 'tab-dispositions')"><i class="fas fa-th-large fa-fw"></i>{{ _('Dispositions') }}</button>
                    <button type="button" class="tablink" onclick="openTab(event, 'tab-affichage')"><i class="fas fa-desktop fa-fw"></i>{{ _('Affichage') }}</button>
                    <button type="button" class="tablink" onclick="openTab(event, 'tab-heure')"><i class="fas fa-clock fa-fw"></i>{{ _('Horloge & météo') }}</button>
                    <button type="button" class="tablink" onclick="openTab(event, 'tab-metadata')"><i class="fas fa-info-circle fa-fw"></i>{{ _('Infos des photos') }}</button>
                    <button type="button" class="tablink" onclick="openTab(event, 'tab-son')"><i class="fas fa-music fa-fw"></i>{{ _('Son') }}</button>
                </div>
            </div>
            <div id="group-partage" class="sub-nav-group hidden">
                <div class="tabs">
                    <button type="button" class="tablink" onclick="openTab(event, 'tab-invites')"><i class="fas fa-qrcode fa-fw"></i>{{ _('Invités') }}</button>
                    <button type="button" class="tablink" onclick="openTab(event, 'tab-validation')"><i class="fas fa-check-circle fa-fw"></i>{{ _('À valider') }} <span id="pending-count-badge" class="nav-badge hidden">0</span></button>
                    <button type="button" class="tablink" onclick="openTab(event, 'tab-telegram')"><i class="fab fa-telegram-plane fa-fw"></i>{{ _('Telegram') }}</button>
                </div>
            </div>
            <div id="group-systeme" class="sub-nav-group hidden">
                <div class="tabs">
                    <button type="button" class="tablink" onclick="openTab(event, 'tab-comptes')"><i class="fas fa-users fa-fw"></i>{{ _('Comptes') }}</button>
                    {% if is_admin %}
                    <button type="button" class="tablink" onclick="openTab(event, 'tab-maintenance')"><i class="fas fa-tools fa-fw"></i>{{ _('Maintenance') }}</button>
                    <button type="button" class="tablink" onclick="openTab(event, 'tab-network')"><i class="fas fa-wifi fa-fw"></i>{{ _('Réseau') }}</button>
                    {% endif %}
                    <button type="button" class="tablink" onclick="openTab(event, 'tab-vocal')"><i class="fas fa-microphone-alt fa-fw"></i>{{ _('Commande vocale') }}</button>
                    {% if is_admin %}
                    <button type="button" class="tablink" onclick="openTab(event, 'tab-stats')"><i class="fas fa-chart-bar fa-fw"></i>{{ _('Statistiques') }}</button>
                    <button type="button" class="tablink" onclick="openTab(event, 'tab-logs')"><i class="fas fa-file-alt fa-fw"></i>{{ _('Journaux') }}</button>
                    {% endif %}
                </div>
            </div>

            <main id="app-main">
{% include 'configure/tab_accueil.html.jinja' %}
        <form method="POST" action="/configure">

{% include 'configure/tab_affichage.html.jinja' %}
{% include 'configure/tab_dispositions.html.jinja' %}


{% include 'configure/tab_heure.html.jinja' %}


{% include 'configure/tab_sources.html.jinja' %}

{% include 'configure/tab_invites.html.jinja' %}
{% include 'configure/tab_telegram.html.jinja' %}

{% include 'configure/tab_vocal.html.jinja' %}

{% include 'configure/tab_metadata.html.jinja' %}

            <!-- Le bouton de sauvegarde est placé ici, à l'intérieur du formulaire mais après les onglets de configuration -->
            <button type="submit" id="save-changes-btn" class="save-button">{{ _("Enregistrer les modifications")
                }}</button>

        </form>

{% include 'configure/tab_actions.html.jinja' %}

{% include 'configure/tab_validation.html.jinja' %}
{% include 'configure/tab_network.html.jinja' %}

{% include 'configure/tab_comptes.html.jinja' %}

{% include 'configure/tab_maintenance.html.jinja' %}

{% include 'configure/tab_stats.html.jinja' %}

{% include 'configure/tab_logs.html.jinja' %}

{% include 'configure/tab_apercu.html.jinja' %}
{% include 'configure/tab_messages.html.jinja' %}
{% include 'configure/tab_queue.html.jinja' %}

{% include 'configure/tab_playlists.html.jinja' %}

{% include 'configure/tab_favoris.html.jinja' %}


{% include 'configure/tab_son.html.jinja' %}
            </main>
        </div>

        <nav id="app-bottomnav">
            {% for group, icon, label in [('group-accueil', 'fa-home', _('Accueil')), ('group-photos', 'fa-images', _('Photos')), ('group-ecran', 'fa-tv', _('Écran')), ('group-partage', 'fa-user-friends', _('Partage')), ('group-systeme', 'fa-cog', _('Système'))] %}
            <button type="button" class="main-nav-link" data-group="{{ group }}"><i class="fas {{ icon }}"></i><span>{{ label }}</span></button>
            {% endfor %}
        </nav>
    </div>

        <script src="{{ url_for('static', filename='vendor/glightbox/glightbox.min.js') }}"></script>
        <script src="{{ url_for('static', filename='vendor/sortable/Sortable.min.js') }}"></script>
{% include 'configure/scripts_gallery.html.jinja' %}
{% include 'configure/scripts_main.html.jinja' %}

{% include 'configure/scripts_status.html.jinja' %}
{% include 'configure/scripts_app.html.jinja' %}
</body>
</html>