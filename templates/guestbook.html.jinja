<!DOCTYPE html>
<html lang="{{ get_locale() }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ _("Livre d'or") }} - Pimmich</title>
  <link href="{{ url_for('static', filename='vendor/tailwind/tailwind.min.css') }}" rel="stylesheet">
  <link rel="icon" type="image/x-icon" href="{{ url_for('static', filename='favicon.ico') }}">
  <style>
    body { background: #f7f3ea; }
    .gb-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1rem; }
    .gb-page { background: #fff; border-radius: 14px; overflow: hidden; box-shadow: 0 4px 14px rgba(0,0,0,.08); }
    .gb-page img { width: 100%; display: block; }
  </style>
</head>
<body class="min-h-screen p-4">
  <div class="max-w-5xl mx-auto">
    <h1 class="text-3xl font-bold text-center mt-4 mb-1">📖 {{ _("Livre d'or") }}</h1>
    <p class="text-center text-gray-600 mb-6">{{ _("Tous les messages et dessins laissés sur le cadre.") }} · <a class="text-blue-600 underline" href="{{ url_for('upload_page') }}">{{ _("Laisser un mot") }}</a></p>
    {% if not entries %}<p class="text-center text-gray-500">{{ _("Le livre d'or est encore vide : soyez le premier à écrire !") }}</p>{% endif %}
    <div class="gb-grid">
      {% for entry in entries %}
      <div class="gb-page" id="gb-{{ entry.id }}">
        <img src="{{ url_for('static', filename='guestbook/' ~ entry.id ~ '.jpg') }}" alt="{{ entry.title or entry.body or _('Dessin') }}" loading="lazy">
        <div class="p-3 text-sm text-gray-600 flex items-center gap-2">
          <span>{{ entry.signature or _("Un invité") }} · {{ entry.created[:10] }}</span>
          {% if session.get('logged_in') %}<button type="button" class="ml-auto text-red-600 gb-delete" data-id="{{ entry.id }}">{{ _("Retirer") }}</button>{% endif %}
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
  {% if session.get('logged_in') %}
  <script>
    document.querySelectorAll(".gb-delete").forEach(b => b.addEventListener("click", async () => {
      if (!confirm({{ _("Retirer cette page du livre d'or ?")|tojson }})) return;
      const r = await (await fetch(`/api/guestbook/${b.dataset.id}`, { method: "DELETE" })).json();
      if (r.success) document.getElementById(`gb-${b.dataset.id}`).remove();
    }));
  </script>
  {% endif %}
</body>
</html>
