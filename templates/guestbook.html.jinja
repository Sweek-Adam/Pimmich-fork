<!DOCTYPE html>
<html lang="{{ get_locale() }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ _("Livre d'or") }} - Pimmich</title>
  <link rel="stylesheet" href="{{ url_for('static', filename='guest.css') }}">
  <link rel="icon" type="image/x-icon" href="{{ url_for('static', filename='favicon.ico') }}">
  <style>
    .book { columns: 280px; column-gap: 16px; }
    .entry { break-inside: avoid; margin: 0 0 16px; background: var(--surface); border: 1px solid var(--border); border-radius: 18px; overflow: hidden; box-shadow: var(--shadow); }
    .entry button.open { display: block; width: 100%; padding: 0; border: 0; background: none; cursor: zoom-in; }
    .entry img { width: 100%; display: block; }
    .entry .meta { display: flex; align-items: center; gap: 8px; padding: 10px 14px; font-size: .9rem; }
    .entry .who { font-weight: 700; }
    .kind { font-size: 1rem; }
    .remove { margin-left: auto; border: 1px solid var(--border); background: var(--surface); color: var(--danger); border-radius: 999px; padding: 4px 10px; font: inherit; font-size: .8rem; cursor: pointer; }
    .empty { text-align: center; padding: 40px 16px; }
    .empty .big { font-size: 3rem; }
    .viewer { position: fixed; inset: 0; z-index: 60; background: rgba(8, 9, 12, .92); display: grid; place-items: center; padding: 16px; cursor: zoom-out; }
    .viewer img { max-width: 100%; max-height: 100%; border-radius: 12px; }
  </style>
</head>
<body>
  <main class="page wide">
    <header class="brand">
      <div style="font-size:2.6rem">📖</div>
      <h1>{{ _("Livre d'or") }}</h1>
      <p class="muted">{{ _("Tous les messages et dessins laissés sur le cadre.") }}</p>
      <div class="chips" style="margin-top:6px">
        <a class="chip on" href="{{ url_for('upload_page') }}">✍️ {{ _("Laisser un mot") }}</a>
        {% if session.get('logged_in') %}<a class="chip" href="/app">⚙️ {{ _("Administration") }}</a>{% endif %}
      </div>
    </header>

    {% if not entries %}
    <div class="card empty"><div class="big">🕊️</div><p class="muted">{{ _("Le livre d'or est encore vide : soyez le premier à écrire !") }}</p></div>
    {% endif %}

    <div class="book">
      {% for entry in entries %}
      <article class="entry" id="gb-{{ entry.id }}">
        <button type="button" class="open" data-src="{{ url_for('static', filename='guestbook/' ~ entry.id ~ '.jpg') }}">
          <img src="{{ url_for('static', filename='guestbook/' ~ entry.id ~ '.jpg') }}" alt="{{ entry.title or entry.body or _('Dessin') }}" loading="lazy">
        </button>
        <div class="meta">
          <span class="kind">{{ '🎨' if entry.kind == 'drawing' else ('🎤' if entry.kind == 'voice' else '✉️') }}</span>
          <span><span class="who">{{ entry.signature or _("Un invité") }}</span> <span class="muted">· {{ entry.created[:10] }}</span></span>
          {% if session.get('logged_in') %}<button type="button" class="remove gb-delete" data-id="{{ entry.id }}">{{ _("Retirer") }}</button>{% endif %}
        </div>
      </article>
      {% endfor %}
    </div>
  </main>

  <div id="viewer" class="viewer hidden"><img alt=""></div>
  <script>
    const viewer = document.getElementById("viewer");
    document.querySelectorAll(".entry .open").forEach(b => b.addEventListener("click", () => {
      viewer.querySelector("img").src = b.dataset.src; viewer.classList.remove("hidden");
    }));
    viewer.addEventListener("click", () => viewer.classList.add("hidden"));
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") viewer.classList.add("hidden"); });
  </script>
  {% if session.get('logged_in') %}
  <script>
    document.querySelectorAll(".gb-delete").forEach(b => b.addEventListener("click", async () => {
      if (!confirm({{ _("Retirer cette page du livre d'or ?")|tojson }})) return;
      const r = await (await fetch(`/api/guestbook/${b.dataset.id}`, { method: "DELETE" })).json();
      if (r.success) document.getElementById(`gb-${b.dataset.id}`).remove();
    }));
  </script>
  {% endif %}
</body>
</html>
