            <div id="tab-dispositions" class="tabcontent">
                <fieldset>
                    <legend>
                        <h3><i class="fas fa-th-large mr-2"></i>{{ _("Disposition du moment") }}</h3>
                    </legend>
                    <p class="text-sm text-gray-600 mb-3">{{ _("Choisissez une disposition à afficher une seule fois tout de suite, ou à utiliser jusqu'à nouvel ordre. « Selon mes réglages » utilise les dispositions cochées ci-dessous.") }}</p>
                    <button type="button" class="layout-current open-layout-picker max-w-md">
                        <i class="fas fa-th-large"></i>
                        <span><small>{{ _("Disposition") }}</small><strong class="layout-current-label">…</strong></span>
                        <i class="fas fa-chevron-right ml-auto"></i>
                    </button>
                </fieldset>

                <fieldset class="mt-6">
                    <legend>
                        <h3><i class="fas fa-layer-group mr-2"></i>{{ _("Mes configurations") }}</h3>
                    </legend>
                    <p class="text-sm text-gray-600 mb-3">{{ _("Enregistrez vos choix de dispositions sous un nom, puis passez de l'une à l'autre d'un clic.") }}</p>
                    <div id="lp-list" class="lp-list"></div>
                    <div class="flex flex-wrap gap-2 mt-3">
                        <input type="text" id="lp-name" maxlength="60" class="flex-1" placeholder="{{ _('Nom (ex : Soirée, Calme, Noël en famille)') }}">
                        <button type="button" id="lp-save" class="btn-secondary"><i class="fas fa-save mr-1"></i>{{ _("Enregistrer la sélection ci-dessous") }}</button>
                    </div>
                    <p id="lp-status" class="text-sm mt-2"></p>
                </fieldset>
                <script>
                    window.addEventListener("DOMContentLoaded", () => {
                        const $ = (id) => document.getElementById(id);
                        const T = { activate: {{ _("Activer")|tojson }}, active: {{ _("Active")|tojson }}, update: {{ _("Remplacer par la sélection")|tojson }},
                                    remove: {{ _("Supprimer")|tojson }}, layouts: {{ _("disposition(s)")|tojson }}, none: {{ _("Aucune configuration enregistrée.")|tojson }},
                                    confirmRemove: {{ _("Supprimer cette configuration ?")|tojson }} };
                        const say = (t, ok) => { $("lp-status").textContent = t || ""; $("lp-status").className = "text-sm mt-2 " + (ok ? "text-green-700" : "text-red-600"); };
                        const selection = () => ({
                            formats: [...document.querySelectorAll('input[name="compositions_styles"]:checked')].map(c => c.value).filter(v => v !== "unique"),
                            unique: !!document.querySelector('input[name="compositions_styles"][value="unique"]:checked'),
                            every: Number(($("compositions_every") || {}).value || 5),
                        });
                        const call = async (url, method, body) => (await fetch(url, { method, headers: { "Content-Type": "application/json" }, body: body ? JSON.stringify(body) : undefined })).json();
                        function render(presets) {
                            const box = $("lp-list");
                            if (!presets.length) { box.innerHTML = `<p class="muted">${T.none}</p>`; return; }
                            box.innerHTML = "";
                            presets.forEach(p => {
                                const card = document.createElement("div");
                                card.className = "lp-card" + (p.active ? " active" : "");
                                const title = document.createElement("div");
                                title.innerHTML = `<strong></strong><small>${p.count} ${T.layouts}</small>`;
                                title.querySelector("strong").textContent = p.name;
                                const actions = document.createElement("div");
                                actions.className = "lp-actions";
                                const act = document.createElement("button");
                                act.type = "button"; act.className = p.active ? "badge on" : "btn-primary text-sm";
                                act.textContent = p.active ? T.active : T.activate; act.disabled = p.active;
                                act.addEventListener("click", async () => {
                                    const r = await call(`/api/layout_presets/${p.id}/activate`, "POST");
                                    say(r.message, r.success);
                                    if (r.success) setTimeout(() => location.reload(), 600);  // cases cochées mises à jour
                                });
                                const upd = document.createElement("button");
                                upd.type = "button"; upd.className = "link"; upd.textContent = T.update;
                                upd.addEventListener("click", async () => { const r = await call("/api/layout_presets", "POST", { id: p.id, selection: selection() }); say(r.message, r.success); if (r.success) render(r.presets); });
                                const del = document.createElement("button");
                                del.type = "button"; del.className = "link text-red-600"; del.textContent = T.remove;
                                del.addEventListener("click", async () => { if (!confirm(T.confirmRemove)) return; const r = await call(`/api/layout_presets/${p.id}`, "DELETE"); say(r.message, r.success); render(r.presets); });
                                actions.append(act, upd, del);
                                card.append(title, actions);
                                box.appendChild(card);
                            });
                        }
                        $("lp-save").addEventListener("click", async () => {
                            const r = await call("/api/layout_presets", "POST", { name: $("lp-name").value, selection: selection() });
                            say(r.message, r.success);
                            if (r.success) { $("lp-name").value = ""; render(r.presets); }
                        });
                        (async () => render((await (await fetch("/api/layout_presets")).json()).presets))();
                    });
                </script>

                <fieldset class="mt-6">
                    <legend>
                        <h3>{{ _("Dispositions utilisées") }}</h3>
                    </legend>
                    <p class="text-sm text-gray-600 mb-3">{{ _("Cochez les dispositions du diaporama. Avec « Photo unique » et des compositions : une composition toutes les N photos. Sans « Photo unique » : uniquement des compositions. Une composition regroupe les photos qui suivent dans le diaporama ou la playlist, dans leur ordre ; un message qui en fait partie devient une note.") }}</p>
                    <input type="hidden" name="compositions_form" value="1">
                    <label for="compositions_every">{{ _("Une composition toutes les (photos) :") }}</label>
                    <input type="number" id="compositions_every" name="compositions_every" min="0" max="100" class="w-24"
                        value="{{ config.get('compositions_every', 5) }}">
                    <p class="text-sm text-gray-600 mt-1">{{ _("0 : les compositions s'enchaînent, sans photo seule entre elles. Une composition reste affichée au moins 2,5 secondes par photo (la durée du diaporama est allongée si besoin).") }}</p>
                    <div class="form-check form-switch my-3">
                        <input class="form-check-input" type="checkbox" id="compositions_full_photos" name="compositions_full_photos" {% if config.get('compositions_full_photos', True) %}checked{% endif %}>
                        <label class="form-check-label ml-2" for="compositions_full_photos">{{ _("Photos entières (sans recadrage)") }}</label>
                    </div>
                    <div class="form-check form-switch my-3">
                        <input class="form-check-input" type="checkbox" id="smart_crop" name="smart_crop" {% if config.get('smart_crop', True) %}checked{% endif %}>
                        <label class="form-check-label ml-2" for="smart_crop">{{ _("Recadrage intelligent : garder les visages entiers") }}</label>
                        <p class="text-sm text-gray-600 mt-1">{{ _("Quand une photo doit être coupée (cases des compositions, photos très larges), le cadre garde les visages au lieu du centre de l'image.") }}</p>
                    </div>
                    <div class="form-check form-switch my-3">
                        <input class="form-check-input" type="checkbox" id="compositions_include_messages" name="compositions_include_messages" {% if config.get('compositions_include_messages', True) %}checked{% endif %}>
                        <label class="form-check-label ml-2" for="compositions_include_messages">{{ _("Inclure les messages dans les compositions") }}</label>
                    </div>
                    <div class="form-check form-switch my-3">
                        <input class="form-check-input" type="checkbox" id="compositions_seasonal" name="compositions_seasonal" {% if config.get('compositions_seasonal', True) %}checked{% endif %}>
                        <label class="form-check-label ml-2" for="compositions_seasonal">{{ _("Thèmes de saison seulement pendant leur période (et plus fréquents à ce moment-là)") }}</label>
                    </div>
                    <p class="text-sm text-gray-600 mb-2"><i class="fas fa-comment-dots msg-ok"></i> {{ _("affiche les messages dans la composition (un message à afficher déclenche l'une de ces dispositions)") }} · <i class="fas fa-comment-slash msg-no"></i> {{ _("messages affichés seuls") }}</p>
                    <p class="text-sm text-gray-600 mb-2">{{ _("Noël : 1er décembre – 6 janvier · Halloween : 15 octobre – 2 novembre · Pâques : 2 semaines autour de Pâques · Printemps, Automne, Hiver : selon la saison.") }} {{ _("Moments de famille et fêtes (anniversaire, mariage, naissance, rentrée, Saint-Valentin, fêtes des mères et des pères) : seulement à leur date.") }}</p>
                    {% for title, items in [(_("Formats"), composition_formats), (_("Thèmes"), composition_themes)] %}
                    <h4 class="text-md font-semibold mt-4 mb-2">{{ title }}</h4>
                    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
                        {% for item in items %}
                        {% set key, label = item[0], item[1] %}
                        <label class="block border rounded-lg overflow-hidden cursor-pointer bg-white hover:shadow">
                            <img src="{{ url_for('static', filename='composition_previews/' ~ key ~ '.jpg') }}" alt="{{ _(label) }}" class="w-full" loading="lazy">
                            <span class="flex items-center gap-2 p-2 text-sm">
                                <input type="checkbox" name="compositions_styles" value="{{ key }}" {% if key in composition_enabled %}checked{% endif %}>
                                {{ _(label) }}{% if item|length > 2 and item[2] %} <i class="fas fa-calendar-alt text-gray-400" title="{{ _('Thème de saison') }}"></i>{% endif %}
                                {% if key in message_layouts %}<i class="fas fa-comment-dots msg-ok ml-auto" title="{{ _('Affiche les messages') }}{{ _(' (jusqu’à 3, dans des fantômes)') if key == 'halloween' else '' }}"></i>{% else %}<i class="fas fa-comment-slash msg-no ml-auto" title="{{ _('Les messages sont affichés seuls, en plein écran') }}"></i>{% endif %}
                            </span>
                        </label>
                        {% endfor %}
                    </div>
                    {% endfor %}
                </fieldset>

                <fieldset class="mt-6" id="family-dates-box">
                    <legend><h3><i class="fas fa-birthday-cake mr-2"></i>{{ _("Dates de la famille") }}</h3></legend>
                    <p class="text-sm text-gray-600 mb-2">{{ _("Anniversaires, mariages et naissances : le jour venu, le cadre montre une disposition « Joyeux anniversaire Léo ! » avec son âge, « 25 ans de mariage » ou « Bienvenue Emma ! ». La rentrée, la Saint-Valentin et les fêtes des mères et des pères (à la date de votre pays) arrivent toutes seules.") }}</p>
                    <div id="fd-list" class="fd-list"></div>
                    <button type="button" id="fd-add" class="link mt-2"><i class="fas fa-plus mr-1"></i>{{ _("Ajouter une date") }}</button>
                    <div class="flex flex-wrap gap-2 mt-3 items-center">
                        <button type="button" id="fd-save" class="btn-primary">{{ _("Enregistrer") }}</button>
                        <span id="fd-status" class="text-sm"></span>
                    </div>
                    <p class="text-sm mt-3"><strong>{{ _("Bientôt :") }}</strong> <span id="fd-upcoming"></span></p>
                </fieldset>
                <style>
                    .fd-list { display: grid; gap: .5rem; }
                    .fd-row { display: grid; grid-template-columns: 11rem 1fr 11rem auto; gap: .5rem; align-items: center; }
                    @media (max-width: 640px) { .fd-row { grid-template-columns: 1fr 1fr; } }
                </style>
                <script>
                    window.addEventListener("DOMContentLoaded", () => {
                        const $ = (id) => document.getElementById(id);
                        const KINDS = { birthday: {{ _("Anniversaire")|tojson }}, wedding: {{ _("Mariage")|tojson }}, birth: {{ _("Naissance")|tojson }} };
                        const T = { name: {{ _("Prénom (ou « Claire & Paul »)")|tojson }}, remove: {{ _("Retirer")|tojson }}, none: {{ _("rien dans les deux mois")|tojson }},
                                    years: {{ _("{n} ans")|tojson }} };
                        function row(item) {
                            const div = document.createElement("div"); div.className = "fd-row";
                            const kind = document.createElement("select");
                            Object.entries(KINDS).forEach(([k, v]) => kind.add(new Option(v, k)));
                            kind.value = item.kind || "birthday";
                            const name = document.createElement("input"); name.type = "text"; name.maxLength = 60; name.placeholder = T.name; name.value = item.name || "";
                            const when = document.createElement("input"); when.type = "date"; when.value = item.date || "";
                            const remove = document.createElement("button"); remove.type = "button"; remove.className = "link"; remove.textContent = T.remove;
                            remove.addEventListener("click", () => div.remove());
                            div.append(kind, name, when, remove);
                            $("fd-list").appendChild(div);
                        }
                        async function load() {
                            const d = await (await fetch("/api/family_dates")).json();
                            $("fd-list").innerHTML = "";
                            d.dates.forEach(row);
                            if (!d.dates.length) row({});
                            $("fd-upcoming").textContent = d.upcoming.length ? d.upcoming.map(u => `${KINDS[u.kind]} ${u.name} — ${new Date(u.date).toLocaleDateString()}${u.years ? " (" + T.years.replace("{n}", u.years) + ")" : ""}`).join(" · ") : T.none;
                        }
                        $("fd-add").addEventListener("click", () => row({}));
                        $("fd-save").addEventListener("click", async () => {
                            const dates = [...document.querySelectorAll("#fd-list .fd-row")].map(r => {
                                const [kind, name, when] = r.querySelectorAll("select, input");
                                return { kind: kind.value, name: name.value.trim(), date: when.value };
                            }).filter(d => d.name && d.date);
                            const r = await (await fetch("/api/family_dates", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ dates }) })).json();
                            $("fd-status").textContent = r.message; $("fd-status").className = "text-sm " + (r.success ? "text-green-700" : "text-red-600");
                            load();
                        });
                        document.querySelectorAll(".tablink[onclick*=\"'tab-dispositions'\"]").forEach(b => b.addEventListener("click", () => setTimeout(load, 50)));
                        if ($("family-dates-box").offsetParent !== null) load();
                    });
                </script>
            </div>
