            <div id="tab-accueil" class="tabcontent">
                <!-- Assistant de démarrage (masqué une fois terminé ou fermé) -->
                <section id="setup-card" class="card hidden">
                    <div class="flex items-center justify-between mb-2">
                        <h2 class="card-title"><i class="fas fa-rocket text-indigo-500 mr-2"></i>{{ _("Bien démarrer") }}</h2>
                        <button type="button" id="setup-dismiss" class="text-sm text-gray-500 hover:text-gray-800">{{ _("Masquer") }}</button>
                    </div>
                    <div class="progress"><div id="setup-progress" style="width:0%"></div></div>
                    <ol id="setup-steps" class="setup-steps"></ol>
                </section>

                <div class="home-grid">
                    <!-- À l'écran -->
                    <section class="card home-now">
                        <h2 class="card-title"><i class="fas fa-tv text-indigo-500 mr-2"></i>{{ _("À l'écran") }}</h2>
                        <div id="live-preview-container">
                            <p id="live-preview-status" class="now-empty hidden">{{ _("Le diaporama est arrêté.") }}</p>
                            <div id="live-preview-box" class="now-preview hidden">
                                <img id="live-preview-image" src="" alt="{{ _('Photo en cours') }}">
                            </div>
                            <div id="live-preview-controls" class="now-controls hidden">
                                <button type="button" class="slideshow-control-btn round" data-command="previous" title="{{ _('Photo précédente') }}"><i class="fas fa-step-backward"></i></button>
                                <button type="button" class="slideshow-control-btn round big" data-command="toggle_pause" title="{{ _('Pause/Lecture') }}"><i class="slideshow-pause-icon fas fa-pause"></i></button>
                                <button type="button" class="slideshow-control-btn round" data-command="next" title="{{ _('Photo suivante') }}"><i class="fas fa-step-forward"></i></button>
                                <button type="button" class="notification-toggle-btn round" title="{{ _('Activer/Désactiver les notifications') }}"><i class="fas fa-bell"></i></button>
                            </div>
                        </div>
                        <button type="button" id="open-layout-picker" class="layout-current open-layout-picker">
                            <i class="fas fa-th-large"></i>
                            <span><small>{{ _("Disposition") }}</small><strong id="layout-current-label" class="layout-current-label">…</strong></span>
                            <i class="fas fa-chevron-right ml-auto"></i>
                        </button>
                        {% set remote_show_idle = false %}{% include 'configure/_music_remote.html.jinja' %}
                    </section>

                    <!-- Santé et actions rapides -->
                    <div class="home-side">
                        <section class="card">
                            <h2 class="card-title"><i class="fas fa-heartbeat text-rose-500 mr-2"></i>{{ _("État du cadre") }}</h2>
                            <ul id="health-list" class="health-list"><li class="muted">{{ _("Vérification…") }}</li></ul>
                        </section>
                        <section class="card">
                            <h2 class="card-title"><i class="fas fa-bolt text-amber-500 mr-2"></i>{{ _("Actions rapides") }}</h2>
                            <div class="quick-actions">
                                <button type="button" onclick="goToTab('tab-messages')"><i class="fas fa-comment-alt"></i>{{ _("Écrire un message") }}</button>
                                <button type="button" onclick="goToTab('tab-actions')"><i class="fas fa-cloud-upload-alt"></i>{{ _("Ajouter des photos") }}</button>
                                <button type="button" onclick="goToTab('tab-playlists')"><i class="fas fa-play-circle"></i>{{ _("Lancer une playlist") }}</button>
                                <button type="button" onclick="goToTab('tab-invites')"><i class="fas fa-qrcode"></i>{{ _("Inviter des proches") }}</button>
                                <button type="button" onclick="goToTab('tab-son')"><i class="fas fa-music"></i>{{ _("Musique") }}</button>
                                <button type="button" onclick="goToTab('tab-apercu')"><i class="fas fa-th"></i>{{ _("Mes photos") }}</button>
                            </div>
                        </section>
                    </div>
                </div>

                <!-- À suivre -->
                <section class="card">
                    <div class="flex items-center justify-between">
                        <h2 class="card-title"><i class="fas fa-stream text-indigo-500 mr-2"></i>{{ _("À suivre") }}</h2>
                        <button type="button" class="link" onclick="goToTab('tab-queue')">{{ _("Réorganiser") }} <i class="fas fa-arrow-right"></i></button>
                    </div>
                    <div id="home-queue" class="home-queue"><span class="muted">…</span></div>
                </section>

                <section class="card hidden" id="home-memories">
                    <h2 class="card-title"><i class="fas fa-star text-yellow-600 mr-2"></i>{{ _("Ce jour-là") }}</h2>
                    <div id="home-memories-list" class="memories-strip"></div>
                </section>

                <!-- Ambiances -->
                <section class="card">
                    <div class="flex items-center justify-between">
                        <h2 class="card-title"><i class="fas fa-magic text-purple-500 mr-2"></i>{{ _("Ambiance") }}</h2>
                        <button type="button" id="ambiance-restore" class="link hidden">{{ _("Revenir à mes réglages") }}</button>
                    </div>
                    <div id="ambiances" class="ambiances"></div>
                </section>

                <!-- Sélecteur visuel de disposition -->
                <div id="layout-picker" class="modal hidden" role="dialog" aria-modal="true" aria-labelledby="layout-picker-title">
                    <div class="modal-panel">
                        <div class="modal-head">
                            <h2 id="layout-picker-title" class="card-title">{{ _("Choisir une disposition") }}</h2>
                            <button type="button" class="modal-close" aria-label="{{ _('Fermer') }}">&times;</button>
                        </div>
                        <div class="picker-toolbar">
                            <div class="chips">
                                <button type="button" class="chip active" data-filter="all">{{ _("Tout") }}</button>
                                <button type="button" class="chip" data-filter="format">{{ _("Formats") }}</button>
                                <button type="button" class="chip" data-filter="theme">{{ _("Thèmes") }}</button>
                                <button type="button" class="chip" data-filter="messages"><i class="fas fa-comment-dots"></i> {{ _("Avec messages") }}</button>
                            </div>
                            <input type="search" id="layout-picker-search" placeholder="{{ _('Rechercher…') }}">
                        </div>
                        <div id="picker-presets" class="picker-presets hidden"></div>
                        <div class="picker-special">
                            <button type="button" class="picker-card special" data-layout="auto"><i class="fas fa-sliders-h"></i><span>{{ _("Selon mes réglages") }}</span></button>
                            <button type="button" class="picker-card special" data-layout="compositions"><i class="fas fa-random"></i><span>{{ _("Compositions au hasard") }}</span></button>
                        </div>
                        <div id="layout-picker-grid" class="picker-grid">
                            {% for value, label, group in layout_choices if value not in ('auto', 'compositions') %}
                            <button type="button" class="picker-card" data-layout="{{ value }}" data-group="{{ group or 'format' }}" data-label="{{ _(label)|lower }}" data-messages="{{ 1 if value in message_layouts else 0 }}">
                                <img src="{{ url_for('static', filename='composition_previews/' ~ value ~ '.jpg') }}" alt="" loading="lazy">
                                <span>{{ _(label) }}{% if value in message_layouts %} <i class="fas fa-comment-dots msg-ok" title="{{ _('Affiche les messages') }}"></i>{% endif %}</span>
                            </button>
                            {% endfor %}
                        </div>
                        <div id="layout-picker-actions" class="picker-actions hidden">
                            <p><strong id="layout-picker-chosen"></strong></p>
                            <div class="flex flex-wrap gap-2">
                                <button type="button" class="btn-secondary" data-mode="now"><i class="fas fa-bolt mr-1"></i>{{ _("Afficher maintenant (une fois)") }}</button>
                                <button type="button" class="btn-primary" data-mode="always"><i class="fas fa-thumbtack mr-1"></i>{{ _("Utiliser jusqu'à nouvel ordre") }}</button>
                            </div>
                        </div>
                    </div>
                </div>

                <script>
                    window.addEventListener("DOMContentLoaded", () => {
                        const $ = (id) => document.getElementById(id);
                        const esc = (t) => { const d = document.createElement("div"); d.textContent = t ?? ""; return d.innerHTML; };
                        const T = {
                            ok: {{ _("Tout va bien.")|tojson }},
                            fix: {{ _("Régler")|tojson }},
                            empty: {{ _("Rien à afficher pour l'instant.")|tojson }},
                            stopped: {{ _("Le diaporama est arrêté.")|tojson }},
                            auto: {{ _("Selon mes réglages")|tojson }},
                            random: {{ _("Compositions au hasard")|tojson }},
                        };
                        const LABELS = { auto: T.auto, compositions: T.random };
                        document.querySelectorAll("#layout-picker-grid .picker-card").forEach(c => LABELS[c.dataset.layout] = c.querySelector("span").textContent.trim());

                        // --- Assistant de démarrage ---
                        async function loadSetup() {
                            const data = await (await fetch('/api/setup')).json();
                            if (!data.success || data.dismissed || data.done === data.total) { $("setup-card").classList.add("hidden"); return; }
                            $("setup-card").classList.remove("hidden");
                            $("setup-progress").style.width = `${Math.round(100 * data.done / data.total)}%`;
                            $("setup-steps").innerHTML = data.steps.map(s => `<li class="${s.done ? "done" : ""}">
                                <i class="${s.done ? "fas fa-check-circle" : "far fa-circle"}"></i><span>${esc(s.title)}</span>
                                ${s.done ? "" : `<button type="button" class="link" data-tab="${esc(s.tab)}">${esc(T.fix)} <i class="fas fa-arrow-right"></i></button>`}</li>`).join("");
                            $("setup-steps").querySelectorAll("[data-tab]").forEach(b => b.addEventListener("click", () => goToTab(b.dataset.tab)));
                        }
                        $("setup-dismiss").addEventListener("click", async () => {
                            await fetch('/api/setup/dismiss', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{"dismissed": true}' });
                            $("setup-card").classList.add("hidden");
                        });

                        // --- Santé du cadre ---
                        async function loadHealth() {
                            const data = await (await fetch('/api/health')).json();
                            const icons = { error: "fa-times-circle", warning: "fa-exclamation-triangle", info: "fa-info-circle" };
                            $("health-list").innerHTML = data.items.length ? data.items.map(i => `<li class="${i.level}">
                                <i class="fas ${icons[i.level]}"></i><div><strong>${esc(i.title)}</strong><p>${esc(i.detail)}</p></div>
                                ${i.tab ? `<button type="button" class="link" data-tab="${esc(i.tab)}">${esc(T.fix)}</button>` : ""}</li>`).join("")
                                : `<li class="ok"><i class="fas fa-check-circle"></i><div><strong>${esc(T.ok)}</strong></div></li>`;
                            $("health-list").querySelectorAll("[data-tab]").forEach(b => b.addEventListener("click", () => goToTab(b.dataset.tab)));
                        }

                        // --- À suivre ---
                        async function loadQueue() {
                            const data = await (await fetch('/api/slideshow/queue')).json();
                            if (!data.running) { $("home-queue").innerHTML = `<span class="muted">${esc(T.stopped)}</span>`; return; }
                            const slots = data.slots || data.upcoming.map(i => ({ ...i, type: "photo" }));
                            $("home-queue").innerHTML = slots.length ? slots.slice(0, 12).map(s => s.type === "composition"
                                ? `<span class="hq-compo${s.pending ? " pending" : ""}" title="${esc(s.label)}"><img src="${esc(s.image || s.items[0].thumb)}" loading="lazy"><i class="fas fa-th-large"></i></span>`
                                : `<img src="${esc(s.thumb)}" title="${esc(s.name)}" loading="lazy">`).join("") : `<span class="muted">${esc(T.empty)}</span>`;
                        }

                        // --- Ambiances ---
                        async function loadAmbiances() {
                            const data = await (await fetch('/api/ambiances')).json();
                            $("ambiances").innerHTML = data.ambiances.map(a => `<button type="button" class="ambiance ${a.active ? "active" : ""}" data-key="${esc(a.key)}">
                                <i class="fas ${esc(a.icon)}"></i><strong>${esc(a.label)}</strong><small>${esc(a.description)}</small></button>`).join("");
                            $("ambiance-restore").classList.toggle("hidden", !data.can_restore);
                            $("ambiances").querySelectorAll("[data-key]").forEach(b => b.addEventListener("click", () => applyAmbiance(b.dataset.key)));
                        }
                        async function applyAmbiance(key) {
                            const data = await (await fetch('/api/ambiance', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ ambiance: key }) })).json();
                            showToast(data.message);
                            loadAmbiances(); loadLayout(); loadSetup();
                        }
                        $("ambiance-restore").addEventListener("click", () => applyAmbiance("perso"));

                        // --- Disposition : sélecteur visuel ---
                        let chosen = null;
                        async function loadLayout() {
                            const data = await (await fetch('/api/slideshow/layout')).json();
                            document.querySelectorAll(".layout-current-label").forEach(l => l.textContent = LABELS[data.layout] || data.layout);
                            document.querySelectorAll(".picker-card").forEach(c => c.classList.toggle("current", c.dataset.layout === data.layout));
                        }
                        const picker = $("layout-picker");
                        document.body.appendChild(picker);  // utilisable depuis n'importe quel onglet (Accueil, Dispositions)
                        async function loadPresets() {  // « Mes configurations » : un clic pour en activer une
                            const data = await (await fetch("/api/layout_presets")).json();
                            const box = $("picker-presets");
                            box.classList.toggle("hidden", !data.presets.length);
                            box.innerHTML = `<span class="muted">{{ _("Mes configurations :") }}</span>`;
                            data.presets.forEach(p => {
                                const b = document.createElement("button");
                                b.type = "button"; b.className = "chip" + (p.active ? " active" : ""); b.textContent = p.name;
                                b.addEventListener("click", async () => {
                                    const r = await (await fetch(`/api/layout_presets/${p.id}/activate`, { method: "POST" })).json();
                                    showToast(r.message); closePicker(); loadLayout();
                                });
                                box.appendChild(b);
                            });
                        }
                        const openPicker = () => { picker.classList.remove("hidden"); $("layout-picker-search").focus(); loadPresets(); };
                        const closePicker = () => { picker.classList.add("hidden"); $("layout-picker-actions").classList.add("hidden"); chosen = null; };
                        document.querySelectorAll(".open-layout-picker").forEach(b => b.addEventListener("click", openPicker));
                        picker.querySelector(".modal-close").addEventListener("click", closePicker);
                        picker.addEventListener("click", (e) => { if (e.target === picker) closePicker(); });
                        document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !picker.classList.contains("hidden")) closePicker(); });
                        function filterPicker() {
                            const filter = picker.querySelector(".chip.active").dataset.filter;
                            const q = $("layout-picker-search").value.trim().toLowerCase();
                            picker.querySelectorAll("#layout-picker-grid .picker-card").forEach(c => {
                                const hidden = filter === "messages" ? c.dataset.messages !== "1" : (filter !== "all" && c.dataset.group !== filter && c.dataset.layout !== "unique");
                                c.classList.toggle("hidden", hidden || (q && !c.dataset.label.includes(q)));
                            });
                        }
                        picker.querySelectorAll(".chip").forEach(chip => chip.addEventListener("click", () => {
                            picker.querySelectorAll(".chip").forEach(c => c.classList.toggle("active", c === chip)); filterPicker();
                        }));
                        $("layout-picker-search").addEventListener("input", filterPicker);
                        picker.querySelectorAll(".picker-card").forEach(card => card.addEventListener("click", () => {
                            chosen = card.dataset.layout;
                            picker.querySelectorAll(".picker-card").forEach(c => c.classList.toggle("selected", c === card));
                            $("layout-picker-chosen").textContent = LABELS[chosen];
                            $("layout-picker-actions").classList.remove("hidden");
                            picker.querySelector('[data-mode="now"]').classList.toggle("hidden", chosen === "auto");
                        }));
                        picker.querySelectorAll("[data-mode]").forEach(btn => btn.addEventListener("click", async () => {
                            const url = btn.dataset.mode === "now" ? '/api/slideshow/layout/now' : '/api/slideshow/layout';
                            const data = await (await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ layout: chosen }) })).json();
                            showToast(data.message);
                            if (data.success) { closePicker(); loadLayout(); }
                        }));

                        // --- Ce jour-là ---
                        async function loadMemories() {
                            const data = await (await fetch('/api/memories/today')).json();
                            $("home-memories").classList.toggle("hidden", !data.items.length);
                            const ago = (n) => n === 1 ? {{ _("il y a 1 an")|tojson }} : {{ _("il y a %(num)s ans", num="__N__")|tojson }}.replace("__N__", n);
                            $("home-memories-list").innerHTML = data.items.map(m =>
                                `<figure><img src="${esc(m.thumb)}" loading="lazy" alt=""><figcaption><strong>${m.year}</strong> ${esc(ago(m.years_ago))}</figcaption></figure>`).join("");
                        }

                        loadSetup(); loadHealth(); loadQueue(); loadAmbiances(); loadLayout(); loadMemories();
                        setInterval(() => { if ($("tab-accueil").offsetParent) { loadQueue(); loadHealth(); } }, 15000);
                    });
                </script>
            
                <section class="card" id="home-history">
                    <div class="flex flex-wrap items-center gap-3 mb-2">
                        <h2 class="card-title" style="margin:0"><i class="fas fa-history text-indigo-500 mr-2"></i>{{ _("Historique") }}</h2>
                        <button type="button" id="hist-undo" class="btn-secondary text-sm ml-auto hidden"><i class="fas fa-undo mr-1"></i><span></span></button>
                    </div>
                    <ul id="hist-events" class="hist-events"></ul>
                    <p class="font-semibold text-sm mt-3 mb-1">{{ _("Affiché récemment") }}</p>
                    <div id="hist-shown" class="hist-shown"></div>
                    <p id="hist-status" class="text-sm mt-2"></p>
                </section>
                <style>
                    .hist-events { max-height: 260px; overflow-y: auto; display: grid; gap: 2px; font-size: .9rem; }
                    .hist-events li { display: flex; gap: .6rem; padding: 4px 0; border-bottom: 1px solid var(--border); }
                    .hist-events time { color: var(--muted); white-space: nowrap; min-width: 6.5rem; }
                    .hist-events .who { color: var(--muted); }
                    .hist-events li.undone span.text { text-decoration: line-through; color: var(--muted); }
                    .hist-shown { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 4px; }
                    .hist-shown img { width: 96px; height: 54px; object-fit: cover; border-radius: 6px; flex: none; }
                </style>
                <script>
                    window.addEventListener("DOMContentLoaded", () => {
                        const $ = (id) => document.getElementById(id);
                        const T = { undo: {{ _("Annuler : {action}")|tojson }}, none: {{ _("Rien pour l'instant.")|tojson }} };
                        const when = (ts) => new Date(ts * 1000).toLocaleString(undefined, { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" });
                        async function load() {
                            if (!$("home-history").offsetParent) return;
                            const d = await (await fetch("/api/history")).json();
                            $("hist-events").innerHTML = d.events.length ? "" : `<li>${T.none}</li>`;
                            d.events.forEach(e => {
                                const li = document.createElement("li"); if (e.undone) li.className = "undone";
                                const time = document.createElement("time"); time.textContent = when(e.at);
                                const text = document.createElement("span"); text.className = "text"; text.textContent = e.text;
                                const who = document.createElement("span"); who.className = "who"; who.textContent = e.who ? `· ${e.who}` : "";
                                li.append(time, text, who); $("hist-events").appendChild(li);
                            });
                            $("hist-shown").innerHTML = "";
                            d.displayed.forEach(p => { const img = document.createElement("img"); img.src = p.thumb; img.loading = "lazy"; img.title = when(p.at); $("hist-shown").appendChild(img); });
                            $("hist-undo").classList.toggle("hidden", !d.undo);
                            if (d.undo) $("hist-undo").querySelector("span").textContent = T.undo.replace("{action}", d.undo);
                        }
                        $("hist-undo").addEventListener("click", async () => {
                            const r = await (await fetch("/api/history/undo", { method: "POST", headers: { "Content-Type": "application/json" }, body: "{}" })).json();
                            $("hist-status").textContent = r.message; $("hist-status").className = "text-sm mt-2 " + (r.success ? "text-green-700" : "text-red-600");
                            load();
                        });
                        document.querySelectorAll(".tablink[onclick*=\"'tab-accueil'\"], .main-nav-link").forEach(b => b.addEventListener("click", () => setTimeout(load, 80)));
                        load(); setInterval(load, 30000);
                    });
                </script>
            
                <div id="drop-overlay" class="drop-overlay hidden"><div><i class="fas fa-cloud-upload-alt"></i><p>{{ _("Déposez vos photos et vidéos : elles partent sur le cadre") }}</p></div></div>
                <style>
                    .drop-overlay { position: fixed; inset: 0; z-index: 80; background: rgba(79, 70, 229, .82); color: #fff; display: flex;
                                    align-items: center; justify-content: center; text-align: center; font-size: 1.4rem; font-weight: 700; pointer-events: none; }
                    .drop-overlay i { font-size: 4rem; margin-bottom: 12px; }
                    .drop-overlay.hidden { display: none; }
                </style>
                <script>
                    window.addEventListener("DOMContentLoaded", () => {
                        // Glisser-déposer des photos n'importe où sur l'interface : envoi vers « Mes envois »
                        const overlay = document.getElementById("drop-overlay");
                        const MEDIA = /\.(jpe?g|png|heic|heif|mp4|mov)$/i;
                        let depth = 0;
                        const hasFiles = (e) => e.dataTransfer && [...e.dataTransfer.types].includes("Files");
                        window.addEventListener("dragenter", (e) => { if (!hasFiles(e)) return; depth++; overlay.classList.remove("hidden"); });
                        window.addEventListener("dragleave", (e) => { if (!hasFiles(e)) return; depth = Math.max(0, depth - 1); if (!depth) overlay.classList.add("hidden"); });
                        window.addEventListener("dragover", (e) => { if (hasFiles(e)) e.preventDefault(); });
                        window.addEventListener("drop", async (e) => {
                            if (!hasFiles(e)) return;
                            e.preventDefault(); depth = 0; overlay.classList.add("hidden");
                            const files = [...e.dataTransfer.files].filter(f => MEDIA.test(f.name));
                            if (!files.length) { if (window.showToast) showToast({{ _("Aucune photo ni vidéo dans ce que vous avez déposé.")|tojson }}); return; }
                            const form = new FormData(); files.forEach(f => form.append("photos", f));
                            if (window.showToast) showToast({{ _("Envoi de {n} fichier(s)…")|tojson }}.replace("{n}", files.length));
                            try {
                                const response = await fetch("/import-smartphone", { method: "POST", body: form });
                                await response.text();  // la préparation se suit dans la notification des imports
                                if (window.showToast) showToast({{ _("Photos envoyées : elles arrivent sur le cadre.")|tojson }});
                                if (window.refreshMyUploads) window.refreshMyUploads();
                            } catch (err) {
                                if (window.showToast) showToast({{ _("Échec de l'envoi. Vérifiez la connexion au cadre.")|tojson }});
                            }
                        });
                    });
                </script>
            </div>
