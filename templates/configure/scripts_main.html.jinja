                    document.getElementById("gdrive-folders-list").innerHTML =
                        `<p class="text-sm text-gray-500">{{ _("Méthode modifiée : cliquez sur « Afficher mes dossiers Google Drive » pour choisir à nouveau les dossiers.") }}</p>`;
                });
                updateGdriveBackendSections();

                // ----- GOOGLE DRIVE : CHOIX DES DOSSIERS -----
                document.getElementById("gdrive-list-folders-btn").addEventListener("click", async () => {
                    const btn = document.getElementById("gdrive-list-folders-btn");
                    const statusSpan = document.getElementById("gdrive-folders-status");
                    const listDiv = document.getElementById("gdrive-folders-list");
                    const key = document.getElementById("gdrive_service_account_json").value;

                    btn.disabled = true;
                    statusSpan.textContent = "{{ _('Chargement...') }}";
                    statusSpan.className = "ml-4 font-medium text-gray-600";

                    try {
                        const response = await fetch('/api/gdrive/folders', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                key: key,
                                backend: document.getElementById("gdrive_backend").value,
                                remote: document.getElementById("gdrive_rclone_remote")?.value || ""
                            })
                        });
                        const data = await response.json();
                        if (!data.success) throw new Error(data.message);

                        // Conserver les dossiers déjà cochés
                        const selected = new Set(Array.from(listDiv.querySelectorAll('input[name="gdrive_folders"]:checked'))
                            .map(cb => cb.value.split('|')[0]));
                        listDiv.innerHTML = "";
                        if (data.folders.length === 0) {
                            listDiv.innerHTML = `<p class="text-sm text-gray-500">{{ _("Aucun dossier trouvé. Avez-vous partagé vos dossiers avec l'adresse du compte de service ?") }}</p>`;
                        }
                        data.folders.forEach(folder => {
                            const row = document.createElement('div');
                            row.className = "form-check my-1";
                            const cb = document.createElement('input');
                            cb.type = "checkbox";
                            cb.className = "form-check-input";
                            cb.name = "gdrive_folders";
                            cb.id = `gdrive_folder_${folder.id}`;
                            cb.value = `${folder.id}|${folder.name}`;
                            cb.checked = selected.has(folder.id);
                            const label = document.createElement('label');
                            label.className = "form-check-label ml-2";
                            label.htmlFor = cb.id;
                            label.textContent = folder.name;
                            row.append(cb, label);
                            listDiv.appendChild(row);
                        });
                        statusSpan.textContent = `${data.folders.length} {{ _("dossier(s) trouvé(s)") }}`;
                        statusSpan.className = "ml-4 font-medium text-green-600";
                    } catch (error) {
                        statusSpan.textContent = error.message;
                        statusSpan.className = "ml-4 font-medium text-red-600";
                    } finally {
                        btn.disabled = false;
                    }
                });

                // ----- TEST SAMBA CONNECTION -----
