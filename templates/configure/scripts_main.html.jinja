                                        loadInvitations();
                                    } else {
                                        alert(`${i18n.errorPrefix} ${result.message}`);
                                    }
                                } catch (error) {
                                    alert(i18n.commErrorServer);
                                }
                            }
                        }

                        if (revokeBtn) {
                            const code = revokeBtn.dataset.code;
                            if (confirm(i18n.confirmRevokeInvite)) {
                                try {
