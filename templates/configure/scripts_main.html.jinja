        <script>

            function copyToClipboard(text, successCallback, errorCallback) {
                // Try the modern Clipboard API first (works in secure contexts like HTTPS or localhost)
                if (navigator.clipboard && window.isSecureContext) {
                    navigator.clipboard.writeText(text)
                        .then(successCallback)
                        .catch(errorCallback);
                    return;
                }

                // Fallback for non-secure contexts (like HTTP on a local network) or older browsers
                const textArea = document.createElement("textarea");
                textArea.value = text;

                // Make it invisible and non-disruptive
                textArea.style.position = "fixed";
                textArea.style.top = "-9999px";
                textArea.style.left = "-9999px";

                document.body.appendChild(textArea);
                textArea.focus();
                textArea.select();

                try {
                    const successful = document.execCommand('copy');
                    if (successful) {
                        successCallback();
                    } else {
                        errorCallback(new Error('Fallback copy command failed.'));
                    }
                } catch (err) {
                    errorCallback(err);
                } finally {
                    document.body.removeChild(textArea);
                }
            }

            async function loadInvitations() {
                const invitationsListDiv = document.getElementById('invitations-list');
                if (!invitationsListDiv) return;

                invitationsListDiv.innerHTML = `<p class="text-gray-500 italic">${i18n.loading}</p>`;

                // Fetch bot info and invitations in parallel
                try {
                    const cacheBuster = `?_=${new Date().getTime()}`;
                    const [invitesResponse, botInfoResponse] = await Promise.all([
                        fetch(`/api/telegram/invitations${cacheBuster}`),
                        fetch(`/api/telegram/bot_info${cacheBuster}`)
                    ]);

                    const invitations = await invitesResponse.json();
                    const botInfo = await botInfoResponse.json();

                    const botUsername = botInfo.success ? botInfo.username : null;
                    if (!botUsername) {
                        console.warn("Could not fetch bot username:", botInfo.message);
                    }

                    invitationsListDiv.innerHTML = ''; // Vider la liste

                    if (invitations.length === 0) {
                        invitationsListDiv.innerHTML = `<p class="text-gray-500 italic">${i18n.noActiveInvites}</p>`;
                        return;
                    }

                    invitations.forEach(invite => {
                        const isExpired = new Date(invite.expires_at) < new Date();
                        const expires = new Date(invite.expires_at).toLocaleString('fr-FR');
                        const usedBy = invite.used_by_user_name ? `${i18n.usedBy} ${invite.used_by_user_name}` : i18n.notUsed;

                        const inviteLink = botUsername ? `https://t.me/${botUsername}?start=${invite.code}` : null;

                        const inviteEl = document.createElement('div');
                        inviteEl.className = 'p-4 bg-white border rounded-lg shadow-sm space-y-3';

                        // --- Statut de l'invitation ---
                        let statusText, statusClass;
                        if (isExpired) {
                            statusText = 'Expirée';
                            statusClass = 'bg-red-100 text-red-800';
                        } else if (invite.used_by_user_id) {
                            statusText = 'Utilisée';
                            statusClass = 'bg-green-100 text-green-800';
                        } else {
                            statusText = 'En attente';
                            statusClass = 'bg-yellow-100 text-yellow-800';
                        }

                        const statusHtml = `
                <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${statusClass}">
                    ${statusText}
                </span>
                ${invite.used_by_user_name ? `<span class="text-sm text-gray-600 ml-2">par <strong>${invite.used_by_user_name}</strong></span>` : ''}
            `;

                        // --- Lien d'invitation ---
                        let linkHtml = `<div class="text-xs text-gray-500 italic mt-1">${i18n.botUsernameError}</div>`;
                        if (inviteLink) {
                            linkHtml = `
                    <div class="flex items-center gap-2">
                        <input type="text" readonly value="${inviteLink}" class="flex-grow text-xs p-1 border rounded bg-gray-50 font-mono">
                        <button type="button" class="copy-link-btn text-gray-500 hover:text-blue-600" data-link="${inviteLink}" title="${i18n.copyLink}">
                            <i class="fas fa-copy"></i>
                        </button>
                    </div>
                `;
                        }

                        // --- Boutons d'action ---
                        const revokeBtnHtml = invite.used_by_user_id && !isExpired ? `
                <button class="revoke-invite-btn text-orange-500 hover:text-orange-700" data-code="${invite.code}" title="${i18n.revokeInvite}">
                    <i class="fas fa-user-slash"></i>
                </button>
            ` : '';
                        const deleteBtnHtml = `
                <button class="delete-invite-btn text-red-500 hover:text-red-700" data-code="${invite.code}" title="${i18n.deleteInvite}">
                    <i class="fas fa-trash-alt"></i>
                </button>`;

                        inviteEl.innerHTML = `
                <div class="flex justify-between items-start">
                    <div>
                        <p class="text-lg font-semibold text-gray-900">${invite.guest_name}</p>
                        <p class="text-sm text-gray-500 mt-1">${i18n.expiresOn} ${expires}</p>
                    </div>
                    <div class="flex items-center gap-x-3">
                        ${revokeBtnHtml}
                        ${deleteBtnHtml}
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-4 items-center pt-3 border-t">
                    <div class="text-sm">${statusHtml}</div>
                    <div>${linkHtml}</div>
                </div>
            `;
                        invitationsListDiv.appendChild(inviteEl);
                    });
                } catch (error) {
                    invitationsListDiv.innerHTML = `<p class="text-red-500">${i18n.errorLoadingInvites}</p>`;
                    console.error("Error loading invitations or bot info:", error);
                }
            }

            async function fetchTelegramBotStatus() {
                const statusSpan = document.getElementById('telegram-bot-status-message');
                if (!statusSpan) return;

                try {
                    const response = await fetch('/telegram_bot_status');
                    const data = await response.json();
                    statusSpan.textContent = data.status_message;
                    if (data.status === 'running') {
                        statusSpan.className = 'font-mono text-green-600';
                    } else if (data.status === 'error') {
                        statusSpan.className = 'font-mono text-red-600';
                    } else {
                        statusSpan.className = 'font-mono text-gray-500';
                    }
                } catch (error) {
                    statusSpan.textContent = i18n.connectionError;
                    statusSpan.className = 'font-mono text-red-600';
                }
            }

            function showToast(message, duration = 3000) {
                const toast = document.getElementById('global-toast');
                const toastMessage = document.getElementById('global-toast-message');
                if (!toast || !toastMessage) return;

                toastMessage.textContent = message;
                toast.classList.remove('hidden');
                // Animate in
                setTimeout(() => {
                    toast.classList.remove('opacity-0', 'translate-y-10');
                }, 10);

                // Animate out
                setTimeout(() => {
                    toast.classList.add('opacity-0', 'translate-y-10');
                    setTimeout(() => {
                        toast.classList.add('hidden');
                    }, 300); // Wait for fade-out transition
                }, duration);
            }

            async function savePlaylistOrder(playlistId) {
                const grid = document.getElementById(`photos-container-${playlistId}`);
                if (!grid) return;

                const sortableInstance = Sortable.get(grid);
                const newOrder = sortableInstance.toArray();

                try {
                    const response = await fetch(`/api/playlists/${playlistId}/reorder`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ photos: newOrder })
                    });
                    const result = await response.json();
                    if (result.success) {
                        showToast(i18n.orderSaved);
                    } else {
                        alert(`${i18n.errorPrefix} ${result.message}`);
                    }
                } catch (e) {
                    alert(i18n.commErrorServer);
                }
            }

            function initializeSortableForPlaylists() {
                document.querySelectorAll('.photo-grid[data-playlist-id]').forEach(grid => {
                    // Éviter la ré-initialisation si déjà fait
                    if (Sortable.get(grid)) {
                        return;
                    }
                    new Sortable(grid, {
                        animation: 150,
                        ghostClass: 'bg-blue-200', // Classe pour le fantôme de l'élément déplacé
                        dataIdAttr: 'data-id', // Spécifie quel attribut utiliser pour l'ordre
                        onEnd: function (evt) {
                            // Quand l'utilisateur a fini de déplacer, on sauvegarde automatiquement
                            const playlistId = evt.to.dataset.playlistId;
                            savePlaylistOrder(playlistId);
                        }
                    });
                });
            }

            // Dispositions proposées pour les playlists (même liste que le choix rapide du diaporama)
            const LAYOUT_OPTIONS = [
                {% for value, label, group in layout_choices %}{ value: {{ value|tojson }}, label: {{ (_("Comme le diaporama") if value == 'auto' else _(label))|tojson }}, group: {{ group|tojson }} },
                {% endfor %}
            ];
            function layoutOptionsHtml(current) {
                const esc = (t) => String(t).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/"/g, "&quot;");
                const option = (o) => `<option value="${esc(o.value)}" ${o.value === current ? "selected" : ""}>${esc(o.label)}</option>`;
                return LAYOUT_OPTIONS.filter(o => !o.group).map(option).join("")
                    + `<optgroup label="${esc({{ _('Uniquement ce format')|tojson }})}">${LAYOUT_OPTIONS.filter(o => o.group === "format").map(option).join("")}</optgroup>`
                    + `<optgroup label="${esc({{ _('Uniquement ce thème')|tojson }})}">${LAYOUT_OPTIONS.filter(o => o.group === "theme").map(option).join("")}</optgroup>`;
            }

            document.addEventListener("click", (event) => {
                const btn = event.target.closest(".edit-playlist-photos-btn");
                if (!btn || !window.openPlaylistBuilder) return;
                const playlist = (window.__playlists || []).find(p => p.id === btn.dataset.id);
                if (playlist) window.openPlaylistBuilder(playlist);
            });
            window.refreshPlaylists = () => renderPlaylists();
            async function renderPlaylists() {
                const playlistsContainer = document.getElementById('playlists-list-container');
                if (!playlistsContainer) return;
                playlistsContainer.innerHTML = `<p class="text-gray-500 italic">${i18n.loading}</p>`;

                try {
                    const response = await fetch('/api/playlists');
                    const playlists = await response.json();

                    playlistsContainer.innerHTML = '';
                    if (playlists.length === 0) {
                        playlistsContainer.innerHTML = `<p class="text-gray-500 italic">${i18n.noPlaylists}</p>`;
                    }

                    window.__playlists = playlists;
                    playlists.forEach(playlist => {
                        const photoCount = playlist.photos.length;
                        const coverHtml = playlist.photos.slice(0, 4).map(p => {
                            const thumb = /\.(mp4|mov|avi|mkv)$/i.test(p) ? p.substring(0, p.lastIndexOf('.')) + '_thumbnail.jpg' : p;
                            return `<img src="/static/prepared/${thumb}" alt="" loading="lazy">`;
                        }).join('');
                        const photoCountText = photoCount !== 1 ? `${photoCount} ${i18n.photos}` : `1 ${i18n.photo}`;

                        const playlistEl = document.createElement('div');
                        playlistEl.className = 'playlist-card p-4 bg-white border rounded-lg shadow-sm';
                        playlistEl.dataset.id = playlist.id;

                        // Construire les options du sélecteur de musique
                        let musicOptionsHtml = `<option value="">${i18n.noMusic}</option>`;
                        availableMusicFiles.forEach(file => {
                            const selected = (playlist.music_file === file) ? 'selected' : '';
                            musicOptionsHtml += `<option value="${file}" ${selected}>${file}</option>`;
                        });

                        let photosHtml = `<p class="text-sm italic text-gray-500 col-span-full">${i18n.noPhotosInPlaylist}</p>`;
                        if (playlist.photos.length > 0) {
                            photosHtml = playlist.photos.map(photoPath => {
                                const isVideo = /\.(mp4|mov|avi|mkv)$/i.test(photoPath);
                                const mediaUrl = `/static/prepared/${photoPath}?v=${new Date().getTime()}`;
                                let thumbUrl = mediaUrl;
                                let videoIconHtml = '';

                                if (isVideo) {
                                    const basePath = photoPath.substring(0, photoPath.lastIndexOf('.'));
                                    thumbUrl = `/static/prepared/${basePath}_thumbnail.jpg?v=${new Date().getTime()}`;
                                    videoIconHtml = `
                            <div class="absolute inset-0 flex items-center justify-center bg-black bg-opacity-25 rounded">
                                <i class="fas fa-play text-white text-3xl opacity-75"></i>
                            </div>
                        `;
                                }

                                return `
                        <div class="photo-tile relative cursor-move" data-id="${photoPath}">
                            <a href="${mediaUrl}" class="glightbox block relative" data-gallery="playlist-${playlist.id}" title="${photoPath}">
                                <img src="${thumbUrl}" class="w-24 h-24 object-cover rounded shadow bg-gray-200 cursor-pointer hover:scale-105 transition-transform">
                                ${videoIconHtml}
                            </a>
                            <button class="remove-from-playlist-btn absolute top-1 right-1 bg-red-600 text-white rounded-full w-5 h-5 flex items-center justify-center text-xs hover:bg-red-800 transition-colors z-10" title="{{ _('Retirer de la playlist') }}">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    `;
                            }).join('');
                        }

                        playlistEl.innerHTML = `
                <div class="flex flex-wrap justify-between items-center gap-3">
                    <div class="playlist-cover${photoCount ? '' : ' empty'}">${coverHtml || '<i class="fas fa-images"></i>'}</div>
                    <div class="flex-grow cursor-pointer playlist-title-toggle" title="{{ _('Afficher/Cacher les photos') }}">
                        <h5 class="text-lg font-semibold text-gray-900">${playlist.name}</h5>
                        <p class="text-sm text-gray-500" id="photo-count-${playlist.id}">${photoCountText}</p>
                    </div>
                    <div class="flex flex-wrap items-center gap-3">
                        <button type="button" class="edit-playlist-photos-btn btn-secondary text-sm" data-id="${playlist.id}"><i class="fas fa-images mr-1"></i>{{ _("Choisir les photos") }}</button>
                        <select class="playlist-layout-select text-sm rounded-md border-gray-300 shadow-sm" data-playlist-id="${playlist.id}" title="{{ _('Disposition de la playlist') }}">
                            ${layoutOptionsHtml(playlist.layout || "auto")}
                        </select>
                        <select class="playlist-music-select text-sm rounded-md border-gray-300 shadow-sm" data-playlist-id="${playlist.id}">
                            ${musicOptionsHtml}
                        </select>
                        <button type="button" class="play-music-btn bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold w-10 h-10 flex items-center justify-center rounded text-sm" data-target-select-id="${playlist.id}" data-music-file="${playlist.music_file || ''}" ${playlist.music_file ? '' : 'disabled'} title="${i18n.listenToMusic}">
                            <i class="fas fa-play fa-fw"></i>
                        </button>
                        <button class="rename-playlist-btn text-gray-500 hover:text-blue-600" data-id="${playlist.id}" title="${i18n.renamePlaylist}">
                            <i class="fas fa-edit"></i>
                        </button>
                        <button class="start-playlist-btn bg-blue-500 hover:bg-blue-600 text-white text-sm font-semibold py-2 px-4 rounded inline-flex items-center" data-id="${playlist.id}">
                            <i class="fas fa-play mr-2"></i>${i18n.launch}
                        </button>
                        <button class="delete-playlist-btn text-red-500 hover:text-red-700" data-id="${playlist.id}" title="${i18n.deletePlaylist}">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                        <i class="fas fa-chevron-down text-gray-400 playlist-chevron"></i>
                    </div>
                </div>
                <div id="photos-container-${playlist.id}" class="hidden mt-4 photo-grid border-t pt-4" data-playlist-id="${playlist.id}">
                    ${photosHtml}
                </div>
            `;
                        playlistsContainer.appendChild(playlistEl);
                    });

                    // Disposition propre à chaque playlist
                    document.querySelectorAll('.playlist-layout-select').forEach(select => {
                        select.addEventListener('change', async (event) => {
                            const response = await fetch(`/api/playlists/${event.target.dataset.playlistId}/layout`, {
                                method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ layout: event.target.value })
                            });
                            const result = await response.json();
                            if (result.success) { showToast(result.message); } else { alert(result.message); }
                        });
                    });

                    // Ajouter les écouteurs pour les sélecteurs de musique
                    document.querySelectorAll('.playlist-music-select').forEach(select => {
                        select.addEventListener('change', async (event) => {
                            const playlistId = event.target.dataset.playlistId;
                            const musicFile = event.target.value;
                            try {
                                const response = await fetch(`/api/playlists/${playlistId}/update_music`, {
                                    method: 'POST',
                                    headers: { 'Content-Type': 'application/json' },
                                    body: JSON.stringify({ music_file: musicFile })
                                });
                                const result = await response.json();
                                if (result.success) {
                                    showToast(i18n.musicUpdated);
                                } else {
                                    alert(`${i18n.errorPrefix} ${result.message}`);
                                }
                            } catch (e) {
                                alert(i18n.commErrorServer);
                            }
                        });
                    });

                    // Initialiser le glisser-déposer sur les grilles nouvellement créées
                    initializeSortableForPlaylists();

                    // NOUVEAU: Ré-initialiser GLightbox pour les nouvelles galeries de playlists
                    GLightbox({
                        selector: '#playlists-list-container .glightbox'
                    });
                } catch (error) {
                    playlistsContainer.innerHTML = `<p class="text-red-500">${i18n.errorLoadingPlaylists}</p>`;
                }
            }

            function openTab(evt, tabId) {
                // Si on clique sur l'onglet Favoris et qu'il n'est pas déjà actif, on recharge la page
                // pour s'assurer que la liste des favoris est à jour.
                const clickedButton = evt ? evt.currentTarget : null;
                if (tabId === 'tab-favoris' && clickedButton && !clickedButton.classList.contains('active')) {
                    localStorage.setItem('activeTab', 'tab-favoris'); // On s'assure de revenir sur le bon onglet
                    location.reload();
                    return; // On arrête l'exécution pour laisser le rechargement se faire
                }

                const tabcontent = document.getElementsByClassName("tabcontent");
                const tablinks = document.getElementsByClassName("tablink");

                for (const tab of tabcontent) {
                    tab.style.display = "none";
                }
                for (const link of tablinks) {
                    link.classList.remove("active");
                }

                const tabElement = document.getElementById(tabId);
                if (tabElement) {
                    tabElement.style.display = "block";
                }

                // Gérer la classe active sur le bouton de l'onglet
                const currentButton = evt ? evt.currentTarget : document.querySelector(`.tablink[onclick*="'${tabId}'"]`);
                if (currentButton) {
                    currentButton.classList.add("active");
                }
                localStorage.setItem('activeTab', tabId);

                // Gérer la visibilité du bouton "Enregistrer"
                const saveButton = document.getElementById('save-changes-btn');
                const tabsWithoutSaveButton = ['tab-comptes', 'tab-messages', 'tab-queue', 'tab-apercu', 'tab-actions', 'tab-validation', 'tab-favoris', 'tab-playlists', 'tab-network', 'tab-maintenance', 'tab-stats', 'tab-logs'];
                if (tabId === 'tab-validation') {
                    refreshValidationTab(); // On rafraîchit la grille et le badge
                }
                if (saveButton) {
                    saveButton.style.display = tabsWithoutSaveButton.includes(tabId) ? 'none' : 'block';
                }

                // Si on ouvre l'onglet Telegram, on charge les invitations
                if (tabId === 'tab-telegram') {
                    fetchTelegramBotStatus();
                    loadInvitations();
                }

                if (tabId === 'tab-playlists') {
                    renderPlaylists();
                }

                if (tabId === 'tab-vocal') {
                    loadAudioDevices();
                    fetchVoiceControlStatus();
                }
            }

            let availableMusicFiles = []; 

            async function loadMusicFiles() {
                try {
                    const response = await fetch('/api/music_files');
                    const data = await response.json();
                    if (data.success) {
                        availableMusicFiles = data.files;
                        
                        // 1. Remplir les sélecteurs de playlist
                        const newPlaylistMusicSelect = document.getElementById('new-playlist-music');
                        if (newPlaylistMusicSelect) {
                            newPlaylistMusicSelect.innerHTML = `<option value="">${i18n.noMusic}</option>`;
                            availableMusicFiles.forEach(file => {
                                const option = document.createElement('option');
                                option.value = file;
                                option.textContent = file;
                                newPlaylistMusicSelect.appendChild(option);
                            });
                        }

                        // 2. Remplir la liste de gestion (Actions)
                        const listContainer = document.getElementById('music-files-list');
                        if (listContainer) {
                            if (availableMusicFiles.length === 0) {
                                listContainer.innerHTML = `<p class="text-sm text-gray-500 italic col-span-full">${i18n.noMusicSelected}</p>`;
                            } else {
                                listContainer.innerHTML = availableMusicFiles.map(file => `
                                    <div class="flex items-center justify-between bg-white p-2 rounded shadow-sm border border-gray-200">
                                        <div class="flex items-center gap-2 overflow-hidden">
                                            <i class="fas fa-music text-purple-500 text-xs"></i>
                                            <span class="text-xs truncate font-mono" title="${file}">${file}</span>
                                        </div>
                                        <div class="flex items-center gap-1">
                                            <button type="button" class="preview-music-btn text-blue-500 hover:text-blue-700 p-1 w-6 h-6 flex items-center justify-center" data-file="${file}" title="${i18n.listenToMusic}">
                                                <i class="fas fa-play fa-fw text-xs"></i>
                                            </button>
                                            <button type="button" class="delete-music-btn text-red-500 hover:text-red-700 p-1" data-file="${file}" title="${i18n.deletePlaylist}">
                                                <i class="fas fa-trash-alt text-xs"></i>
                                            </button>
                                        </div>
                                    </div>
                                `).join('');
                            }
                        }
                    } else { console.error("Error loading music files:", data.message); }
                } catch (error) { console.error("Communication error loading music files:", error); }
            }

            let currentAudioPlayer = null;
            let currentPlayingButton = null;

            function resetPlayButton(button) {
                if (button) {
                    const icon = button.querySelector('i');
                    if (icon) {
                        icon.classList.remove('fa-stop');
                        icon.classList.add('fa-play');
                    }
                    button.title = i18n.listenToMusic;
                }
            }

            function toggleMusicPlayback(button, musicFile) {
                const musicUrl = `/static/music/${musicFile}`;
                const absoluteMusicUrl = new URL(musicUrl, window.location.origin).href;

                if (currentAudioPlayer && currentAudioPlayer.src !== absoluteMusicUrl) {
                    currentAudioPlayer.pause();
                    currentAudioPlayer.currentTime = 0;
                    resetPlayButton(currentPlayingButton);
                }

                if (currentAudioPlayer && currentAudioPlayer.src === absoluteMusicUrl && !currentAudioPlayer.paused) {
                    currentAudioPlayer.pause();
                    currentAudioPlayer.currentTime = 0;
                    resetPlayButton(button);
                    currentAudioPlayer = null;
                    currentPlayingButton = null;
                } else {
                    if (!currentAudioPlayer || currentAudioPlayer.src !== absoluteMusicUrl) {
                        currentAudioPlayer = new Audio(musicUrl);
                        currentAudioPlayer.volume = 0.7;
                        currentAudioPlayer.addEventListener('ended', () => {
                            resetPlayButton(button);
                            currentAudioPlayer = null;
                            currentPlayingButton = null;
                        });
                    }
                    currentAudioPlayer.play();
                    const icon = button.querySelector('i');
                    if (icon) {
                        icon.classList.remove('fa-play');
                        icon.classList.add('fa-stop');
                    }
                    button.title = i18n.stopMusic;
                    currentPlayingButton = button;
                }
            }

            // Restaurer l'onglet actif au chargement de la page
            document.addEventListener('DOMContentLoaded', async function () {
                // --- Nouvelle gestion de la navigation par groupes ---
                const mainNavLinks = document.querySelectorAll('.main-nav-link');
                const subNavGroups = document.querySelectorAll('.sub-nav-group');

                function switchMainGroup(targetGroup) {
                    mainNavLinks.forEach(link => {
                        link.classList.toggle('active', link.dataset.group === targetGroup);
                    });
                    subNavGroups.forEach(group => {
                        group.classList.toggle('hidden', group.id !== targetGroup);
                    });
                }

                mainNavLinks.forEach(link => {
                    link.addEventListener('click', function () {
                        const targetGroup = this.dataset.group;
                        switchMainGroup(targetGroup);
                        localStorage.setItem('activeMainGroup', targetGroup);

                        // Clique sur le premier onglet du nouveau groupe pour s'assurer qu'un onglet est toujours actif
                        const activeGroup = document.getElementById(targetGroup);
                        if (activeGroup) {
                            const firstTabButton = activeGroup.querySelector('.tablink');
                            if (firstTabButton) {
                                firstTabButton.click(); // Cela appellera openTab et sauvegardera le nouvel onglet actif
                            }
                        }
                    });
                });

                // --- Logique de restauration de l'état au chargement de la page ---
                let activeTabId = localStorage.getItem('activeTab') || 'tab-accueil';
                let activeMainGroup = localStorage.getItem('activeMainGroup');

                // Trouver à quel groupe appartient l'onglet actif
                const activeTabElement = document.querySelector(`.tablink[onclick*="'${activeTabId}'"]`);
