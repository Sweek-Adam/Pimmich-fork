                if (invitationsListDiv) {
                    invitationsListDiv.addEventListener('click', async (event) => {
                        const deleteBtn = event.target.closest('.delete-invite-btn');
                        const revokeBtn = event.target.closest('.revoke-invite-btn');
                        const copyBtn = event.target.closest('.copy-link-btn');

                        if (copyBtn) {
