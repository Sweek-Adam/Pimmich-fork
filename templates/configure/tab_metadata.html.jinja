            <div id="tab-metadata" class="tabcontent">
                <fieldset>
                    <legend>
                        <h3><i class="fas fa-info-circle mr-2"></i>{{ _("Affichage des métadonnées des photos") }}</h3>
                    </legend>
                    <p class="text-sm text-gray-600 mb-4">{{ _("Configurez ici l'affichage des informations (date, lieu)
                        extraites depuis Immich sur vos photos.") }}</p>

                    <!-- Date -->
                    <div class="form-check form-switch my-3">
                        <input class="form-check-input" type="checkbox" id="show_photo_date" name="show_photo_date" {% if config.get('show_photo_date') %}checked{% endif %}>
                        <label class="form-check-label ml-2" for="show_photo_date">{{ _("Afficher la date de prise de vue") }}</label>
                    </div>
                    <div class="mb-4">
                        <label for="photo_date_format" class="block text-sm font-medium text-gray-700">{{ _("Format de
                            la date") }}</label>
                        <input type="text" id="photo_date_format" name="photo_date_format"
                            value="{{ config.get('photo_date_format', '%Y') }}"
                            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                        <p class="text-xs text-gray-500 mt-1">{{ _("Utilise les codes de formatage Python (ex: %%d/%%m/%%Y, %%B %%Y).") }}</p>
                    </div>

                    <!-- Location -->
                    <div class="form-check form-switch my-3">
                        <input class="form-check-input" type="checkbox" id="show_photo_location" name="show_photo_location" {% if config.get('show_photo_location') %}checked{% endif %}>
                        <label class="form-check-label ml-2" for="show_photo_location">{{ _("Afficher la localisation (ville/pays)") }}</label>
                    </div>
                    <div class="mb-4">
                        <label for="photo_location_format" class="block text-sm font-medium text-gray-700">{{ _("Format
                            de la localisation") }}</label>
                        <select id="photo_location_format" name="photo_location_format"
                            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                            <option value="city_country" {% if config.get('photo_location_format')=='city_country'
                                %}selected{% endif %}>{{ _("Ville, Pays") }}</option>
                            <option value="city" {% if config.get('photo_location_format')=='city' %}selected{% endif
                                %}>{{ _("Ville uniquement") }}</option>
                            <option value="country" {% if config.get('photo_location_format')=='country' %}selected{%
                                endif %}>{{ _("Pays uniquement") }}</option>
                        </select>
                    </div>

                    <!-- Country Flag -->
                    <div class="form-check form-switch my-3">
                        <input class="form-check-input" type="checkbox" id="show_country_flag" name="show_country_flag" {% if config.get('show_country_flag') %}checked{% endif %}>
                        <label class="form-check-label ml-2" for="show_country_flag">{{ _("Afficher le drapeau du pays") }}</label>
                    </div>
                    <div class="mb-4">
                        <label for="country_flag_size" class="block text-sm font-medium text-gray-700">{{ _("Taille du
                            drapeau") }}</label>
                        <select id="country_flag_size" name="country_flag_size"
                            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                            <option value="128x96" {% if config.get('country_flag_size')=='128x96' %}selected{% endif
                                %}>128x96</option>
                            <option value="192x144" {% if config.get('country_flag_size')=='192x144' %}selected{% endif
                                %}>192x144</option>
                            <option value="256x192" {% if config.get('country_flag_size')=='256x192' %}selected{% endif
                                %}>256x192</option>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label for="country_flag_opacity" class="block text-sm font-medium text-gray-700">{{ _("Opacité
                            du drapeau (0.1 à 1.0)") }}</label>
                        <input type="number" step="0.1" min="0.1" max="1.0" id="country_flag_opacity"
                            name="country_flag_opacity" value="{{ config.get('country_flag_opacity', 1.0) }}"
                            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                    </div>
                    <div class="mb-4">
                        <label for="country_flag_position" class="block text-sm font-medium text-gray-700">{{
                            _("Position du drapeau") }}</label>
                        <select id="country_flag_position" name="country_flag_position"
                            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                            <option value="top_right" {% if config.get('country_flag_position')=='top_right'
                                %}selected{% endif %}>{{ _("En haut à droite") }}</option>
                            <option value="top_left" {% if config.get('country_flag_position')=='top_left' %}selected{%
                                endif %}>{{ _("En haut à gauche") }}</option>
                            <option value="bottom_right" {% if config.get('country_flag_position')=='bottom_right'
                                %}selected{% endif %}>{{ _("En bas à droite") }}</option>
                            <option value="bottom_left" {% if config.get('country_flag_position')=='bottom_left'
                                %}selected{% endif %}>{{ _("En bas à gauche") }}</option>
                        </select>
                    </div>
                    <div class="grid grid-cols-2 gap-4 mb-4">
                        <div>
                            <label for="country_flag_offset_x" class="block text-sm font-medium text-gray-700">{{
                                _("Décalage horizontal (px)") }}</label>
                            <input type="number" id="country_flag_offset_x" name="country_flag_offset_x"
                                value="{{ config.get('country_flag_offset_x', 15) }}"
                                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                        </div>
                        <div>
                            <label for="country_flag_offset_y" class="block text-sm font-medium text-gray-700">{{
                                _("Décalage vertical (px)") }}</label>
                            <input type="number" id="country_flag_offset_y" name="country_flag_offset_y"
                                value="{{ config.get('country_flag_offset_y', 15) }}"
                                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                        </div>
                    </div>

                    <!-- Style & Position -->
                    <h4 class="text-lg font-semibold mt-6 pt-4 border-t">{{ _("Style et Positionnement") }}</h4>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-2">
                        <div>
                            <label for="photo_metadata_font_size" class="block text-sm font-medium text-gray-700">{{
                                _("Taille de la police") }}</label>
                            <input type="number" id="photo_metadata_font_size" name="photo_metadata_font_size"
                                value="{{ config.get('photo_metadata_font_size', 23) }}"
                                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                        </div>
                        <div>
                            <label for="photo_metadata_font_path" class="block text-sm font-medium text-gray-700">{{
                                _("Police") }}</label>
                            <select id="photo_metadata_font_path" name="photo_metadata_font_path"
                                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                                {% set fonts = [
                                ('/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf', 'DejaVu Sans Bold'),
                                ('/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf', 'DejaVu Sans'),
                                ('/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf', 'Liberation Sans'),
                                ('/usr/share/fonts/truetype/freefont/FreeSans.ttf', 'FreeSans')
                                ] %}
                                {% for path, label in fonts %}
                                <option value="{{ path }}" {% if config.get('photo_metadata_font_path')==path
                                    %}selected{% endif %}>{{ label }}</option>
                                {% endfor %}
                            </select>
                        </div>
                        <div>
                            <label for="photo_metadata_color" class="block text-sm font-medium text-gray-700">{{
                                _("Couleur du texte (hex)") }}</label>
                            <input type="text" id="photo_metadata_color" name="photo_metadata_color"
                                value="{{ config.get('photo_metadata_color', '#ffffff') }}"
                                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                        </div>
                        <div>
                            <label for="photo_metadata_outline_color" class="block text-sm font-medium text-gray-700">{{
                                _("Couleur du contour (hex)") }}</label>
                            <input type="text" id="photo_metadata_outline_color" name="photo_metadata_outline_color"
                                value="{{ config.get('photo_metadata_outline_color', '#000000') }}"
                                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                        </div>
                        <div>
                            <label for="photo_metadata_position" class="block text-sm font-medium text-gray-700">{{
                                _("Position") }}</label>
                            <select id="photo_metadata_position" name="photo_metadata_position"
                                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                                <option value="bottom_left" {% if config.get('photo_metadata_position')=='bottom_left'
                                    %}selected{% endif %}>{{ _("En bas à gauche") }}</option>
                                <option value="bottom_right" {% if config.get('photo_metadata_position')=='bottom_right'
                                    %}selected{% endif %}>{{ _("En bas à droite") }}</option>
                                <option value="bottom_center" {% if
                                    config.get('photo_metadata_position')=='bottom_center' %}selected{% endif %}>{{
                                    _("En bas au centre") }}</option>
                                <option value="top_left" {% if config.get('photo_metadata_position')=='top_left'
                                    %}selected{% endif %}>{{ _("En haut à gauche") }}</option>
                                <option value="top_right" {% if config.get('photo_metadata_position')=='top_right'
                                    %}selected{% endif %}>{{ _("En haut à droite") }}</option>
                            </select>
                        </div>
                        <div>
                            <label for="photo_metadata_offset_x" class="block text-sm font-medium text-gray-700">{{
                                _("Décalage horizontal (px)") }}</label>
                            <input type="number" id="photo_metadata_offset_x" name="photo_metadata_offset_x"
                                value="{{ config.get('photo_metadata_offset_x', 0) }}"
                                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                        </div>
                        <div>
                            <label for="photo_metadata_offset_y" class="block text-sm font-medium text-gray-700">{{
                                _("Décalage vertical (px)") }}</label>
                            <input type="number" id="photo_metadata_offset_y" name="photo_metadata_offset_y"
                                value="{{ config.get('photo_metadata_offset_y', 0) }}"
                                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                        </div>
                    </div>

                    <!-- Background -->
                    <div class="form-check form-switch my-3 pt-4 border-t">
                        <input class="form-check-input" type="checkbox" id="photo_metadata_background_enabled" name="photo_metadata_background_enabled" {% if config.get('photo_metadata_background_enabled') %}checked{% endif %}>
                        <label class="form-check-label ml-2" for="photo_metadata_background_enabled">{{ _("Afficher un fond semi-transparent derrière les métadonnées") }}</label>
                    </div>
                    <div class="mb-4">
                        <label for="photo_metadata_background_color" class="block text-sm font-medium text-gray-700">{{
                            _("Couleur du fond (hex RGBA)") }}</label>
                        <input type="text" id="photo_metadata_background_color" name="photo_metadata_background_color"
                            value="{{ config.get('photo_metadata_background_color', '#00000080') }}"
                            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                    </div>
                </fieldset>
            </div>
