            <div id="tab-invites" class="tabcontent">
                <fieldset>
                    <legend>
                        <h3><i class="fas fa-user-friends mr-2"></i>{{ _("Inviter la famille et les amis") }}</h3>
                    </legend>
                    <div class="flex flex-col md:flex-row gap-6 items-start">
                        <img src="{{ url_for('guest_qr_png') }}" alt="{{ _('QR code de la page invités') }}" class="w-48 h-48 border rounded-lg bg-white p-2">
                        <div class="flex-1">
                            <p class="mb-3">{{ _("Les personnes connectées à votre Wi-Fi scannent ce QR code (ou ouvrent l'adresse ci-dessous) pour envoyer des photos et écrire des messages sur le cadre.") }}</p>
                            <p class="font-mono text-lg mb-4 break-all" id="guest-page-url">http://{{ request.host.split(':')[0] or '…' }}/upload</p>
                            <div class="flex flex-wrap gap-2">
                                <button type="button" id="guest-share" class="btn-primary guest-invite"><i class="fas fa-share-alt mr-1"></i>{{ _("Partager le lien") }}</button>
                                <a href="/upload" target="_blank" class="btn-secondary guest-invite"><i class="fas fa-external-link-alt mr-1"></i>{{ _("Ouvrir la page invités") }}</a>
                                <button type="button" class="btn-secondary guest-invite" onclick="window.open('{{ url_for('guest_qr_png') }}').print()"><i class="fas fa-print mr-1"></i>{{ _("Imprimer le QR code") }}</button>
                            </div>
                            <p id="guest-share-status" class="text-sm text-green-700 mt-2"></p>
                            <p class="text-sm text-gray-600 mt-3">{{ _("Les photos des invités passent par « À valider » avant d'être affichées.") }}</p>
                        </div>
                    </div>
                </fieldset>

                <script>
                    window.addEventListener("DOMContentLoaded", () => {
                        // Lien partagé, ouvert ou QR code imprimé : l'étape « Inviter la famille » de l'accueil est faite
                        const mark = () => fetch("/api/setup/mark", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ step: "guests" }) });
                        document.querySelectorAll(".guest-invite").forEach(el => el.addEventListener("click", mark));
                        document.getElementById("guest-share").addEventListener("click", async () => {
                            const url = document.getElementById("guest-page-url").textContent.trim();
                            const status = document.getElementById("guest-share-status");
                            try {
                                if (navigator.share) {
                                    await navigator.share({ title: {{ _("Notre cadre photo")|tojson }}, text: {{ _("Envoyez vos photos et vos messages sur notre cadre photo (depuis le Wi-Fi de la maison) :")|tojson }}, url });
                                } else {
                                    await navigator.clipboard.writeText(url);
                                    status.textContent = {{ _("Lien copié : collez-le dans un message à la famille.")|tojson }};
                                }
                            } catch (e) { /* partage annulé */ }
                        });
                    });
                </script>

                {% if is_admin %}
                <fieldset class="mt-6" id="remote-guests">
                    <legend>
                        <h3><i class="fas fa-globe-europe mr-2"></i>{{ _("Hors de la maison") }}</h3>
                    </legend>
                    <p class="text-sm text-gray-600 mb-3">{{ _("La famille peut aussi envoyer photos et messages depuis chez elle, avec un lien secret. Seule la page d'envoi est publiée (via Tailscale) : l'administration et vos photos ne sont jamais accessibles depuis internet. Les photos passent toujours par « À valider ».") }}</p>
                    <div id="rg-setup" class="install-hint hidden"></div>
                    <label class="flex items-center gap-2 my-2"><input type="checkbox" id="rg-enabled"> <strong>{{ _("Autoriser les envois depuis l'extérieur") }}</strong></label>
                    <div id="rg-link-box" class="hidden mt-3 flex flex-col md:flex-row gap-4 items-start">
                        <img id="rg-qr" alt="{{ _('QR code du lien secret') }}" class="w-40 h-40 border rounded-lg bg-white p-2">
                        <div class="flex-1 min-w-0">
                            <p class="font-mono text-sm break-all bg-gray-50 rounded p-2" id="rg-link"></p>
                            <div class="flex flex-wrap gap-2 mt-3">
                                <button type="button" id="rg-share" class="btn-primary"><i class="fas fa-share-alt mr-1"></i>{{ _("Partager le lien") }}</button>
                                <button type="button" id="rg-new" class="btn-secondary"><i class="fas fa-sync-alt mr-1"></i>{{ _("Changer le lien") }}</button>
                            </div>
                            <p class="text-xs text-gray-500 mt-2">{{ _("« Changer le lien » rend l'ancien inutilisable (par exemple s'il a circulé trop largement).") }}</p>
                        </div>
                    </div>
                    <p id="rg-status" class="text-sm mt-2"></p>
                </fieldset>
                <script>
                    window.addEventListener("DOMContentLoaded", () => {
                        const $ = (id) => document.getElementById(id);
                        const post = async (url, body) => (await fetch(url, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body || {}) })).json();
                        const T = { noTs: {{ _("Tailscale n'est pas installé sur le cadre : https://tailscale.com/download/linux")|tojson }},
                                    off: {{ _("Tailscale est installé mais pas connecté : lancez « sudo tailscale up » sur le cadre.")|tojson }},
                                    entry: {{ _("Une seule fois, lancez sur le Raspberry Pi : ~/pimmich/utils/enable_remote_guests.sh")|tojson }},
                                    copied: {{ _("Lien copié : collez-le dans un message à la famille.")|tojson }},
                                    shareText: {{ _("Envoyez vos photos et vos messages sur notre cadre photo, où que vous soyez :")|tojson }} };
                        const say = (t, ok) => { $("rg-status").textContent = t || ""; $("rg-status").className = "text-sm mt-2 " + (ok ? "text-green-700" : "text-red-600"); };
                        async function load() {
                            const d = await (await fetch("/api/remote_guests")).json();
                            const problem = !d.installed ? T.noTs : !d.connected ? T.off : !d.entry_ready ? T.entry : "";
                            $("rg-setup").textContent = problem;
                            $("rg-setup").classList.toggle("hidden", !problem);
                            $("rg-enabled").checked = d.enabled;
                            $("rg-enabled").disabled = !!problem && !d.enabled;
                            $("rg-link-box").classList.toggle("hidden", !d.link);
                            if (d.link) { $("rg-link").textContent = d.link; $("rg-qr").src = "/api/guest_qr.png?remote=1&t=" + Date.now(); }
                        }
                        $("rg-enabled").addEventListener("change", async () => {
                            $("rg-enabled").disabled = true;
                            const r = await post("/api/remote_guests", { enabled: $("rg-enabled").checked });
                            say(r.message, r.success);
                            if (r.activation_url) {  // Funnel à autoriser une fois dans la console Tailscale
                                const a = document.createElement("a");
                                a.href = r.activation_url; a.target = "_blank"; a.rel = "noopener"; a.className = "btn-primary inline-block mt-2";
                                a.textContent = {{ _("Autoriser Funnel sur Tailscale")|tojson }};
                                $("rg-status").append(document.createElement("br"), a);
                            }
                            await load();
                        });
                        $("rg-new").addEventListener("click", async () => { const r = await post("/api/remote_guests/new_link"); say(r.message, r.success); load(); });
                        $("rg-share").addEventListener("click", async () => {
                            const url = $("rg-link").textContent;
                            try {
                                if (navigator.share) await navigator.share({ title: {{ _("Notre cadre photo")|tojson }}, text: T.shareText, url });
                                else { await navigator.clipboard.writeText(url); say(T.copied, true); }
                                fetch("/api/setup/mark", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ step: "guests" }) });
                            } catch (e) { /* partage annulé */ }
                        });
                        document.querySelectorAll(".tablink[onclick*=\"'tab-invites'\"]").forEach(b => b.addEventListener("click", () => setTimeout(load, 50)));
                        load();
                    });
                </script>
                {% endif %}

                <fieldset class="mt-6">
                    <legend>
                        <h3><i class="fas fa-qrcode mr-2"></i>{{ _("QR code pour les invités") }}</h3>
                    </legend>
                    <p class="text-sm text-gray-600 mb-3">{{ _("Affiche en permanence sur le diaporama un QR code vers la page invités, pour envoyer des photos ou écrire un message depuis un téléphone connecté au même Wi-Fi.") }}</p>
                    <div class="form-check form-switch my-2">
                        <input class="form-check-input" type="checkbox" id="show_guest_qr" name="show_guest_qr" {% if config.get('show_guest_qr', True) %}checked{% endif %}>
                        <label class="form-check-label ml-2" for="show_guest_qr">{{ _("Afficher le QR code") }}</label>
                    </div>
                    <label for="guest_qr_position">{{ _("Position :") }}</label>
                    <select id="guest_qr_position" name="guest_qr_position">
                        {% set qr_pos = config.get('guest_qr_position', 'bottom_right') %}
                        <option value="bottom_right" {% if qr_pos == 'bottom_right' %}selected{% endif %}>{{ _("En bas à droite") }}</option>
                        <option value="bottom_left" {% if qr_pos == 'bottom_left' %}selected{% endif %}>{{ _("En bas à gauche") }}</option>
                        <option value="top_right" {% if qr_pos == 'top_right' %}selected{% endif %}>{{ _("En haut à droite") }}</option>
                        <option value="top_left" {% if qr_pos == 'top_left' %}selected{% endif %}>{{ _("En haut à gauche") }}</option>
                    </select>
                    <div class="form-check form-switch my-3">
                        <input class="form-check-input" type="checkbox" id="guest_messages_enabled" name="guest_messages_enabled" {% if config.get('guest_messages_enabled', True) %}checked{% endif %}>
                        <label class="form-check-label ml-2" for="guest_messages_enabled">{{ _("Autoriser les invités à écrire des messages") }}</label>
                    </div>
                    <p class="text-sm text-gray-600">{{ _("Les messages des invités s'affichent directement (5 par heure et par appareil au maximum) et disparaissent au bout de 7 jours. Vous pouvez les supprimer dans Contenu > Messages.") }}</p>
                    <div class="form-check form-switch my-3">
                        <input class="form-check-input" type="checkbox" id="voice_messages_enabled" name="voice_messages_enabled" {% if config.get('voice_messages_enabled', True) %}checked{% endif %}>
                        <label class="form-check-label ml-2" for="voice_messages_enabled">{{ _("Lire les messages vocaux quand leur carte s'affiche (au plus toutes les 20 minutes)") }}</label>
                    </div>
                    <div class="flex items-center gap-2 mb-2">
                        <label for="voice_volume" class="text-sm">{{ _("Volume des messages vocaux :") }}</label>
                        <input type="range" id="voice_volume" name="voice_volume" min="10" max="100" step="5" value="{{ config.get('voice_volume', 100) }}">
                    </div>
                    <div class="form-check form-switch my-3">
                        <input class="form-check-input" type="checkbox" id="guest_reactions_enabled" name="guest_reactions_enabled" {% if config.get('guest_reactions_enabled', True) %}checked{% endif %}>
                        <label class="form-check-label ml-2" for="guest_reactions_enabled">{{ _("Réactions : les invités voient la photo affichée et peuvent y réagir (❤️ 😂 😮 👏)") }}</label>
                    </div>
                    <p class="text-sm text-gray-600">{{ _("Seulement depuis le Wi-Fi de la maison. Les messages et dessins des invités restent ensuite dans le livre d'or :") }} <a class="link" href="{{ url_for('guest_book_page') }}" target="_blank">{{ _("ouvrir le livre d'or") }}</a></p>
                </fieldset>
            
            {% if is_admin %}
            <fieldset class="mt-6" id="frames-box">
                <legend><h3><i class="fas fa-th-large mr-2"></i>{{ _("Cadres de la famille") }}</h3></legend>
                <p class="text-sm text-gray-600 mb-3">{{ _("Pilotez d'ici les autres cadres Pimmich de la famille (chez Mamie, au chalet…) : voir la photo affichée, les allumer, leur envoyer des photos ou un message. Ils doivent être joignables : même réseau, ou Tailscale sur les deux cadres.") }}</p>
                <div id="fr-list" class="fr-list"></div>
                <details class="mt-3">
                    <summary class="cursor-pointer font-semibold text-sm">{{ _("Ajouter un cadre") }}</summary>
                    <ol class="text-sm text-gray-600 list-decimal ml-5 my-2">
                        <li>{{ _("Sur l'autre cadre : Partage › Invités › « Code d'association » (ci-dessous), puis « Créer un code ».") }}</li>
                        <li>{{ _("Ici : son adresse (ex. https://100.101.102.103 avec Tailscale, ou https://192.168.1.30) et ce code.") }}</li>
                    </ol>
                    <div class="grid gap-2 em-grid">
                        <label for="fr-url">{{ _("Adresse") }}</label><input type="url" id="fr-url" placeholder="https://100.101.102.103">
                        <label for="fr-token">{{ _("Code") }}</label><input type="text" id="fr-token" autocomplete="off">
                        <label for="fr-name">{{ _("Nom") }}</label><input type="text" id="fr-name" placeholder="{{ _('ex : Chez Mamie') }}">
                    </div>
                    <button type="button" id="fr-add" class="btn-primary mt-2">{{ _("Ajouter le cadre") }}</button>
                </details>
                <details class="mt-3">
                    <summary class="cursor-pointer font-semibold text-sm">{{ _("Code d'association de ce cadre") }}</summary>
                    <p class="text-sm text-gray-600 my-2">{{ _("À saisir sur le cadre qui pilotera celui-ci. Retirez un code pour couper l'accès.") }}</p>
                    <ul id="fr-codes" class="denied-list"></ul>
                    <button type="button" id="fr-new-code" class="btn-secondary mt-2">{{ _("Créer un code") }}</button>
                </details>
                <p id="fr-status" class="text-sm mt-2"></p>
            </fieldset>
            <style>
                .fr-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: .75rem; }
                .fr-card { border: 1px solid var(--border, #e5e7eb); border-radius: .75rem; overflow: hidden; background: var(--card, #fff); }
                .fr-card img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; background: #111; display: block; }
                .fr-card .fr-body { padding: .6rem; display: grid; gap: .4rem; }
                .fr-card .fr-actions { display: flex; flex-wrap: wrap; gap: .3rem; }
                .em-grid { grid-template-columns: max-content 1fr; align-items: center; }
                @media (max-width: 640px) { .em-grid { grid-template-columns: 1fr; } }
            </style>
            <script>
                window.addEventListener("DOMContentLoaded", () => {
                    const $ = (id) => document.getElementById(id);
                    const T = { on: {{ _("Allumer")|tojson }}, off: {{ _("Endormir")|tojson }}, next: {{ _("Photo suivante")|tojson }}, send: {{ _("Envoyer des photos")|tojson }},
                                message: {{ _("Envoyer un message")|tojson }}, remove: {{ _("Retirer")|tojson }}, offline: {{ _("injoignable")|tojson }},
                                refused: {{ _("code refusé")|tojson }}, running: {{ _("diaporama en cours")|tojson }}, stopped: {{ _("en veille")|tojson }},
                                ask: {{ _("Votre message :")|tojson }}, none: {{ _("Aucun autre cadre pour l'instant.")|tojson }} };
                    const say = (t, ok) => { $("fr-status").textContent = t || ""; $("fr-status").className = "text-sm mt-2 " + (ok ? "text-green-700" : "text-red-600"); };
                    const post = async (url, body) => (await fetch(url, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body || {}) })).json();
                    const button = (text, cls, fn) => { const b = document.createElement("button"); b.type = "button"; b.className = cls; b.textContent = text; b.addEventListener("click", fn); return b; };
                    async function load() {
                        const d = await (await fetch("/api/frames")).json();
                        $("fr-list").innerHTML = d.frames.length ? "" : `<p class="text-sm text-gray-500">${T.none}</p>`;
                        d.frames.forEach(f => {
                            const card = document.createElement("div"); card.className = "fr-card";
                            const img = document.createElement("img"); img.alt = ""; if (f.has_photo) img.src = `/api/frames/${f.id}/current.jpg?t=${Date.now()}`;
                            const body = document.createElement("div"); body.className = "fr-body";
                            const title = document.createElement("strong"); title.textContent = f.name;
                            const state = document.createElement("small"); state.className = "text-gray-500";
                            state.textContent = !f.online ? T.offline : f.unauthorized ? T.refused : (f.running ? T.running : T.stopped) + (f.photos ? ` · ${f.photos} photos` : "");
                            const actions = document.createElement("div"); actions.className = "fr-actions";
                            const act = async (action) => { const r = await post(`/api/frames/${f.id}/${action}`); say(r.message, r.success); setTimeout(load, 1500); };
                            const file = document.createElement("input"); file.type = "file"; file.multiple = true; file.accept = "image/*,video/*"; file.className = "hidden";
                            file.addEventListener("change", async () => {
                                const form = new FormData(); [...file.files].forEach(x => form.append("photos", x));
                                const r = await (await fetch(`/api/frames/${f.id}/photos`, { method: "POST", body: form })).json(); say(r.message, r.success); file.value = "";
                            });
                            actions.append(button(f.running ? T.off : T.on, "btn-secondary text-sm", () => act(f.running ? "off" : "on")),
                                           button(T.next, "btn-secondary text-sm", () => act("next")),
                                           button(T.send, "btn-secondary text-sm", () => file.click()),
                                           button(T.message, "btn-secondary text-sm", async () => {
                                               const text = prompt(T.ask); if (!text) return;
                                               const r = await post(`/api/frames/${f.id}/message`, { title: "", body: text, style: "pastel" }); say(r.message, r.success);
                                           }),
                                           button(T.remove, "link text-sm", async () => { await fetch(`/api/frames/${f.id}`, { method: "DELETE" }); load(); }), file);
                            body.append(title, state, actions); card.append(img, body); $("fr-list").appendChild(card);
                        });
                    }
                    async function loadCodes(codes) {
                        codes = codes || (await (await fetch("/api/frame/pairing")).json()).codes;
                        $("fr-codes").innerHTML = "";
                        codes.forEach(c => {
                            const li = document.createElement("li");
                            const code = document.createElement("code"); code.textContent = c.token;
                            const b = button(T.remove, "link ml-2", async () => {
                                const r = await (await fetch("/api/frame/pairing", { method: "DELETE", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ token: c.token }) })).json();
                                loadCodes(r.codes);
                            });
                            li.append(document.createTextNode(c.label + " : "), code, b); $("fr-codes").appendChild(li);
                        });
                    }
                    $("fr-new-code").addEventListener("click", async () => loadCodes((await post("/api/frame/pairing", {})).codes));
                    $("fr-add").addEventListener("click", async () => {
                        const r = await post("/api/frames", { url: $("fr-url").value, token: $("fr-token").value, name: $("fr-name").value });
                        say(r.message, r.success); if (r.success) { $("fr-token").value = ""; load(); }
                    });
                    document.querySelectorAll(".tablink[onclick*=\"'tab-invites'\"]").forEach(b => b.addEventListener("click", () => setTimeout(() => { load(); loadCodes(); }, 50)));
                    if ($("frames-box").offsetParent !== null) { load(); loadCodes(); }
                });
            </script>
            {% endif %}
        </div>
