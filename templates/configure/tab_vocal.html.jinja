            <div id="tab-vocal" class="tabcontent">
                <fieldset>
                    <legend>
                        <h3><i class="fas fa-microphone-alt mr-2"></i>{{ _("Contrôle Vocal") }}</h3>
                    </legend>
                    <p class="text-sm text-gray-600 mb-3">
                        {{ _('Contrôlez votre diaporama à la voix avec le mot-clé "Cadre Magique".') }}
                    </p>

                    <div class="p-4 border-l-4 border-blue-400 bg-blue-50 text-blue-700 mb-4">
                        <p><strong>{{ _("Étape Manuelle Requise :") }}</strong> {{ _('Pour utiliser le mot-clé
                            personnalisé "Cadre Magique", vous devez créer un modèle sur le site de Picovoice, le
                            télécharger, et le placer dans le dossier `voice_models` sous le nom
                            `cadre-magique_raspberry-pi.ppn`.') }}</p>
                    </div>

                    <div class="mt-4">
                        <label for="voice_control_engine" class="block text-sm font-medium text-gray-700">{{ _("Moteur
                            de mot-clé") }}</label>
                        <select id="voice_control_engine" name="voice_control_engine"
                            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                            <option value="porcupine" {% if config.get('voice_control_engine', 'porcupine'
                                )=='porcupine' %}selected{% endif %}>{{ _("Picovoice Porcupine (Recommandé, nécessite une clé API)") }}</option>
                            <option value="vosk" {% if config.get('voice_control_engine', 'porcupine' )=='vosk'
                                %}selected{% endif %}>{{ _("Vosk (Totalement local, sans clé API, plus gourmand)") }}</option>
                        </select>
                        <p class="text-xs text-gray-500 mt-1">{{ _("Choisissez 'Vosk' si vous ne souhaitez pas créer de
                            compte Picovoice.") }}</p>
                    </div>

                    <div class="form-check form-switch my-3">
                        <input class="form-check-input" type="checkbox" id="voice_control_enabled" name="voice_control_enabled" {% if config.get('voice_control_enabled') %}checked{% endif %}>
                        <label class="form-check-label ml-2" for="voice_control_enabled">{{ _("Activer le contrôle vocal (action immédiate)") }}</label>
                    </div>

                    <div class="mt-4">
                        <label for="voice_control_language" class="block text-sm font-medium text-gray-700">{{ _("Langue
                            du contrôle vocal") }}</label>
                        <select id="voice_control_language" name="voice_control_language"
                            class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                            <option value="fr" {% if config.get('voice_control_language', 'fr' )=='fr' %}selected{%
                                endif %}>{{ _('Français') }}</option>
                            <option value="en" {% if config.get('voice_control_language', 'fr' )=='en' %}selected{%
                                endif %}>{{ _('Anglais') }}</option>
                        </select>
                        <p class="text-xs text-gray-500 mt-1">{{ _("Le changement de langue nécessite un redémarrage du
                            service vocal (désactiver puis réactiver le contrôle vocal).") }}</p>
                    </div>

                    <div class="mt-4">
                        <label for="porcupine_access_key" class="block text-sm font-medium text-gray-700">{{ _("Clé
                            d'accès Picovoice Porcupine") }}</label>
                        <div class="relative mt-1">
                            <input type="password" id="porcupine_access_key" name="porcupine_access_key"
                                value="{{ config.get('porcupine_access_key', '') }}"
                                class="block w-full rounded-md border-gray-300 shadow-sm pr-10"
                                placeholder="{{ _('Collez votre clé d\'accès ici') }}">
                            <div class="absolute inset-y-0 right-0 pr-3 flex items-center">
                                <button type="button"
                                    class="toggle-password-btn text-gray-500 hover:bg-gray-200 rounded-md transition-colors w-auto p-2 flex items-center justify-center mt-0 bg-transparent border-none font-normal"
                                    data-target="porcupine_access_key" title="{{ _('Afficher/Cacher la clé d\'accès') }}">
                                    <i class="fas fa-eye"></i>
                                </button>
                            </div>
                        </div>
                        <p class="text-xs text-gray-500 mt-1">{{ _("Obtenez votre clé via le compte gratuit (Free Tier)
                            sur la") }} <a href="https://console.picovoice.ai/" target="_blank"
                                class="text-blue-600 hover:underline">Picovoice Console</a>.</p>
                    </div>

                    <div class="mt-4">
                        <label for="voice_control_device_index" class="block text-sm font-medium text-gray-700">{{
                            _("Périphérique d'entrée audio (Microphone)") }}</label>
                        <div class="flex items-center gap-2">
                            <select id="voice_control_device_index" name="voice_control_device_index"
                                class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                                <option value="">{{ _("Périphérique par défaut") }}</option>
                                <!-- Les options seront chargées par JavaScript -->
                            </select>
                            <button type="button" id="refresh-audio-devices-btn"
                                class="bg-gray-200 hover:bg-gray-300 text-gray-800 font-bold py-2 px-4 rounded text-sm"
                                title="{{ _('Actualiser la liste') }}"><i class="fas fa-sync-alt"></i></button>
                        </div>
                    </div>

                    <div id="voice-control-status-container" class="mt-6 p-3 bg-gray-100 rounded-lg border">
                        <p><strong>{{ _("État du service vocal :") }}</strong>
                            <span id="voice-control-status-message" class="font-mono">...</span>
                        </p>
                    </div>

                </fieldset>

                <fieldset class="mt-6">
                    <legend>
                        <h3><i class="fas fa-volume-up mr-2"></i>{{ _("Volume des Notifications Sonores") }}</h3>
                    </legend>
                    <p class="text-sm text-gray-600 mb-3">
                        {{ _("Règle le volume pour les sons de notification (confirmation du contrôle vocal, réception
                        de carte postale, etc.).") }}
                    </p>
                    <div id="notification-volume-selector" style="display: flex; align-items: center; margin-top: 8px;">
                        <label for="notification_sound_volume" style="min-width: 200px;">{{ _("Volume des notifications
                            :") }}</label>
                        <input type="range" id="notification_volume_slider" min="0" max="100"
                            value="{{ config.get('notification_sound_volume', 80) }}" class="w-1/2">
                        <input type="number" id="notification_sound_volume" name="notification_sound_volume" min="0"
                            max="100" value="{{ config.get('notification_sound_volume', 80) }}"
                            class="w-16 ml-2 text-center">
                        <span class="ml-1">%</span>
                    </div>
                </fieldset>

                <fieldset class="mt-6">
                    <legend>
                        <h3><i class="fas fa-stethoscope mr-2"></i>{{ _("Diagnostic Audio") }}</h3>
                    </legend>
                    <p class="text-sm text-gray-600 mb-3">
                        {{ _("Si votre microphone n'apparaît pas dans la liste ci-dessus, utilisez cet outil pour
                        vérifier si le système d'exploitation le détecte correctement.") }}
                    </p>
                    <button type="button" id="run-audio-diagnostics-btn"
                        class="bg-gray-500 hover:bg-gray-600 text-white font-bold py-2 px-4 rounded inline-flex items-center">
                        <i class="fas fa-play-circle mr-2"></i>{{ _("Lancer le diagnostic") }}
                    </button>
                    <div id="audio-diagnostics-results-container" class="hidden mt-4">
                        <h4 class="font-semibold text-gray-800 mb-2">{{ _("Résultats du diagnostic :") }}</h4>
                        <div class="bg-gray-800 rounded-lg overflow-auto" style="max-height: 300px;">
                            <pre id="audio-diagnostics-results" class="text-white p-4 text-xs"
                                style="white-space: pre-wrap; word-break: break-all;"></pre>
                        </div>
                    </div>
                </fieldset>
            </div>
