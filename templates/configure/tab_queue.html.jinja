        <div id="tab-queue" class="tabcontent">
            <fieldset>
                <legend>
                    <h3>{{ _("À suivre dans le diaporama") }}</h3>
                </legend>
                <p class="text-sm text-gray-600 mb-4">{{ _("Faites glisser une photo pour changer l'ordre : la première de la liste sera affichée juste après la photo actuelle. Le bouton ▶ l'affiche immédiatement. Les cadres violets regroupent les photos d'une même composition : elles se déplacent ensemble.") }}</p>

                <div id="queue-not-running" class="hidden p-3 bg-gray-100 rounded text-gray-600">{{ _("Le diaporama n'est pas en cours.") }}</div>

                <div id="queue-content" class="hidden">
                    <div class="flex items-center gap-3 mb-4">
                        <img id="queue-current-img" class="w-32 h-20 object-cover rounded border-4 border-green-500" alt="">
                        <div>
                            <p class="text-sm font-semibold text-green-700">{{ _("Affichée en ce moment") }}</p>
                            <p id="queue-current-name" class="text-xs text-gray-500"></p>
                        </div>
                    </div>
                    <ol id="queue-list" class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-6 gap-3"></ol>
                    <p id="queue-status" class="mt-3 text-sm"></p>
                </div>
            </fieldset>

            <script>
                window.addEventListener("DOMContentLoaded", () => {
                    const $ = (id) => document.getElementById(id);
                    const list = $("queue-list");
                    let busyUntil = 0;  // pas de rafraîchissement pendant / juste après une manipulation
                    const say = (text, ok) => { $("queue-status").textContent = text; $("queue-status").className = "mt-3 text-sm " + (ok ? "text-green-600" : "text-red-600"); };

                    async function sendOrder(playNow) {
                        busyUntil = Date.now() + 4000;
                        const order = [...list.querySelectorAll("li")].flatMap(li => JSON.parse(li.dataset.paths));
                        const resp = await fetch('/api/slideshow/queue', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ order, play_now: !!playNow }) });
                        const data = await resp.json();
                        say(data.message, data.success);
                        setTimeout(refresh, playNow ? 2500 : 4000);
                    }

                    function render(data) {
                        $("queue-not-running").classList.toggle("hidden", data.running);
                        $("queue-content").classList.toggle("hidden", !data.running);
                        if (!data.running) return;
                        if (data.current) {
                            $("queue-current-img").src = data.current.thumb;
                            $("queue-current-name").textContent = `${data.current.source} · ${data.current.name}`;
                        }
                        list.innerHTML = "";
                        const slots = data.slots || data.upcoming.map(item => ({ ...item, type: "photo" }));
                        slots.forEach((slot, i) => {
                            const li = document.createElement("li");
                            const group = slot.type === "composition";
                            const items = group ? slot.items : [slot];
                            li.dataset.paths = JSON.stringify(items.map(item => item.path));
                            li.className = "relative cursor-move rounded overflow-hidden bg-white shadow-sm " +
                                (group ? "col-span-2 border-2 " + (slot.pending ? "border-dashed border-indigo-300" : "border-indigo-500") : "border");
                            li.title = group ? `${slot.label} · ${items.map(item => item.name).join(", ")}` : `${slot.source} · ${slot.name}`;
                            if (group && slot.image) {
                                const img = document.createElement("img");
                                img.src = slot.image;
                                img.className = "w-full h-20 object-contain bg-gray-900 pointer-events-none";
                                li.appendChild(img);
                            } else if (group) {
                                const strip = document.createElement("div");
                                strip.className = "flex h-20 pointer-events-none";
                                items.forEach(item => {
                                    const img = document.createElement("img");
                                    img.src = item.thumb; img.loading = "lazy";
                                    img.className = "h-full flex-1 min-w-0 object-cover";
                                    strip.appendChild(img);
                                });
                                li.appendChild(strip);
                            } else {
                                const img = document.createElement("img");
                                img.src = slot.thumb;
                                img.className = "w-full h-20 object-cover pointer-events-none";
                                img.loading = "lazy";
                                li.appendChild(img);
                            }
                            const num = document.createElement("span");
                            num.className = "queue-num absolute top-1 left-1 bg-black bg-opacity-60 text-white text-xs px-1.5 rounded";
                            num.textContent = i + 1;
                            li.appendChild(num);
                            if (group) {
                                const badge = document.createElement("span");
                                badge.className = "absolute bottom-1 left-1 right-1 truncate bg-indigo-600 bg-opacity-90 text-white text-xs px-1.5 py-0.5 rounded";
                                badge.innerHTML = '<i class="fas fa-th-large mr-1"></i>';
                                badge.append(slot.pending
                                    ? {{ _("Composition (commence ici, en préparation)")|tojson }}
                                    : `${slot.label} · ${items.length} ${ {{ _("photos")|tojson }} }`);
                                li.appendChild(badge);
                            } else if (slot.video) {
                                const v = document.createElement("span");
                                v.className = "absolute bottom-1 left-1 text-white text-xs";
                                v.innerHTML = '<i class="fas fa-video"></i>';
                                li.appendChild(v);
                            }
                            const play = document.createElement("button");
                            play.type = "button";
                            play.className = "queue-play";
                            play.innerHTML = '<i class="fas fa-play"></i>';
                            play.title = {{ _("Afficher maintenant")|tojson }};
                            play.addEventListener("click", (e) => {
                                e.stopPropagation();
                                list.prepend(li);
                                sendOrder(true);
                            });
                            li.appendChild(play);
                            list.appendChild(li);
                        });
                    }

                    async function refresh() {
                        if (Date.now() < busyUntil || !$("tab-queue").offsetParent) return;  // onglet masqué ou manipulation en cours
                        try {
                            render(await (await fetch('/api/slideshow/queue')).json());
                        } catch (e) { /* le diaporama redémarre : on réessaiera */ }
                    }

                    if (window.Sortable) {
                        Sortable.create(list, {
                            animation: 150,
                            onStart: () => { busyUntil = Date.now() + 60000; },
                            onEnd: () => {
                                list.querySelectorAll(".queue-num").forEach((n, i) => n.textContent = i + 1);
                                sendOrder(false);
                            },
                        });
                    }
                    document.querySelectorAll(".tablink[onclick*=\"'tab-queue'\"]").forEach(b => b.addEventListener("click", () => setTimeout(refresh, 50)));
                    refresh();
                    setInterval(refresh, 5000);
                });
            </script>
        </div>
