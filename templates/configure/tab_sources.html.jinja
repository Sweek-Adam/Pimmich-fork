                </fieldset>
                <script>
                    window.addEventListener("DOMContentLoaded", () => {
                        const $ = (id) => document.getElementById(id);
                        const T = { items: {{ _("éléments")|tojson }}, remove: {{ _("Retirer")|tojson }}, checking: {{ _("Lecture de l'album…")|tojson }} };
                        const say = (t, ok) => { $("ic-status").textContent = t || ""; $("ic-status").className = "text-sm mt-2 " + (ok ? "text-green-700" : "text-red-600"); };
                        const post = async (url, body) => (await fetch(url, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body || {}) })).json();
                        async function load() {
                            const d = await (await fetch("/api/icloud")).json();
                            $("ic-auto").checked = d.auto;
