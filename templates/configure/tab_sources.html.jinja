                    <label class="flex items-center gap-2 mt-2"><input type="checkbox" id="ic-auto"> {{ _("Synchroniser automatiquement (toutes les heures)") }}</label>
                    <button type="button" id="ic-sync" class="btn-secondary mt-2"><i class="fas fa-sync-alt mr-1"></i>{{ _("Synchroniser maintenant") }}</button>
