                                const btn = document.createElement("button"); btn.type = "button"; btn.className = "link ml-2"; btn.textContent = T.remove;
                                btn.addEventListener("click", async () => { const r = await post("/api/icloud", { remove: a.token }); say(r.message, r.success); load(); });
                                li.append(name, btn); $("ic-albums").appendChild(li);
                            });
                        }
                        $("ic-add").addEventListener("click", async () => {
                            say(T.checking, true);
                            const r = await post("/api/icloud/album", { url: $("ic-url").value.trim() });
