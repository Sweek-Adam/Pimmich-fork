                        $("ic-auto").addEventListener("change", async () => { const r = await post("/api/icloud", { auto: $("ic-auto").checked }); say(r.message, r.success); });
                        $("ic-sync").addEventListener("click", async () => { const r = await post("/api/icloud/sync"); say(r.message, r.success); });
                        load();
                    });
                </script>

                <fieldset class="mt-4" id="email-box">
