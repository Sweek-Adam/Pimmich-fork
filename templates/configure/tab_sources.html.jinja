                    .em-grid { grid-template-columns: max-content 1fr; align-items: center; }
                    @media (max-width: 640px) { .em-grid { grid-template-columns: 1fr; } }
                </style>
                {% if is_admin %}
                <script>
                    window.addEventListener("DOMContentLoaded", () => {
                        const $ = (id) => document.getElementById(id);
                        const T = { saved: {{ _("Mot de passe enregistré (laisser vide pour le garder)")|tojson }}, testing: {{ _("Connexion…")|tojson }} };
                        const say = (t, ok) => { $("em-status").textContent = t || ""; $("em-status").className = "text-sm mt-2 " + (ok ? "text-green-700" : "text-red-600"); };
                        const post = async (url, body) => (await fetch(url, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body || {}) })).json();
                        let providers = {};
                        async function load() {
                            const d = await (await fetch("/api/email")).json();
                            providers = d.providers;
                            $("em-enabled").checked = d.enabled; $("em-user").value = d.user; $("em-host").value = d.host; $("em-port").value = d.port;
                            $("em-folder").value = d.folder; $("em-allowed").value = d.allowed.join(", "); $("em-unknown").value = d.unknown;
                            $("em-password").value = ""; $("em-password").placeholder = d.has_password ? T.saved : "";
                        }
                        $("em-user").addEventListener("change", () => {
                            const domain = ($("em-user").value.split("@")[1] || "").toLowerCase();
                            if (providers[domain] && !$("em-host").value) $("em-host").value = providers[domain];
                        });
                        const values = () => ({ enabled: $("em-enabled").checked, user: $("em-user").value, password: $("em-password").value, host: $("em-host").value,
                                                port: $("em-port").value, folder: $("em-folder").value, allowed: $("em-allowed").value, unknown: $("em-unknown").value });
                        const save = async () => { const r = await post("/api/email", values()); if (r.success) await load(); return r; };
                        $("em-save").addEventListener("click", async () => { const r = await save(); say(r.message, r.success); });
                        $("em-enabled").addEventListener("change", async () => { const r = await save(); say(r.message, r.success); });
                        $("em-test").addEventListener("click", async () => {
                            const saved = await save(); if (!saved.success) { say(saved.message, false); return; }
                            say(T.testing, true); const r = await post("/api/email/test"); say(r.message, r.success);
                        });
                        $("em-check").addEventListener("click", async () => { say(T.testing, true); const r = await post("/api/email/check"); say(r.message, r.success); });
                        load();
                    });
                </script>
                {% endif %}

                <fieldset class="mt-4 hidden" id="gdrive-denied-box">
                    <legend>
                        <h3><i class="fab fa-google-drive mr-2"></i>{{ _("Photos que le cadre ne peut pas retirer du Drive") }}</h3>
                    </legend>
                    <p class="text-sm text-gray-600 mb-3">{{ _("Ces photos ont été déposées dans le dossier par un autre compte Google : seul leur propriétaire peut les mettre à la corbeille. Elles restent affichées sur le cadre. Supprimez-les vous-même depuis Drive (si vous en avez le droit) ou demandez à leur propriétaire, puis cliquez sur « Réessayer ».") }}</p>
                    <ul id="gdrive-denied" class="denied-list"></ul>
                    <button type="button" id="gdrive-denied-retry" class="btn-secondary mt-3"><i class="fas fa-redo mr-1"></i>{{ _("Réessayer à la prochaine synchronisation") }}</button>
                    <span id="gdrive-denied-status" class="text-sm ml-2"></span>
                </fieldset>
                <script>
                    window.addEventListener("DOMContentLoaded", () => {
                        const $ = (id) => document.getElementById(id);
                        const OPEN = {{ _("Ouvrir dans Drive")|tojson }}, GONE = {{ _("(plus sur le cadre)")|tojson }};
                        async function loadDenied() {
                            const data = await (await fetch("/api/gdrive/denied")).json();
                            $("gdrive-denied-box").classList.toggle("hidden", !data.files.length);
                            $("gdrive-denied").innerHTML = "";
                            data.files.forEach(f => {
                                const li = document.createElement("li");
                                const name = document.createElement("span");
                                name.className = "denied-name";
                                name.textContent = f.remote_path + (f.local ? "" : " " + GONE);
                                li.appendChild(name);
                                if (f.drive_url) {
                                    const a = document.createElement("a");
                                    a.href = f.drive_url; a.target = "_blank"; a.rel = "noopener"; a.className = "link";
                                    a.innerHTML = '<i class="fas fa-external-link-alt mr-1"></i>'; a.append(OPEN);
                                    li.appendChild(a);
                                }
                                $("gdrive-denied").appendChild(li);
                            });
                        }
                        $("gdrive-denied-retry").addEventListener("click", async () => {
                            const r = await (await fetch("/api/gdrive/denied/retry", { method: "POST" })).json();
                            $("gdrive-denied-status").textContent = r.message;
                            loadDenied();
                        });
                        loadDenied();
                    });
                </script>

                <fieldset class="mt-4">
                    <legend>
                        <h3>{{ _("Options de démarrage") }}</h3>
                    </legend>
                    <div class="form-check form-switch my-3">
                        <input class="form-check-input" type="checkbox" id="skip_initial_auto_import" name="skip_initial_auto_import" {% if config.get('skip_initial_auto_import', False) %}checked{% endif %}>
                        <label class="form-check-label ml-2" for="skip_initial_auto_import">{{ _("Ignorer le premier import automatique au démarrage") }}</label>
