                    window.addEventListener("DOMContentLoaded", () => {
                        const $ = (id) => document.getElementById(id);
                        const T = { none: {{ _("Aucun compte")|tojson }}, loading: {{ _("Lecture des dossiers…")|tojson }} };
                        const say = (t, ok) => { $("cl-status").textContent = t || ""; $("cl-status").className = "text-sm mt-2 " + (ok ? "text-green-700" : "text-red-600"); };
                        const post = async (url, body) => (await fetch(url, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body || {}) })).json();
                        let state = null;
                        async function load() {
                            state = await (await fetch("/api/cloud")).json();
                            $("cl-remote").innerHTML = `<option value="">${T.none}</option>` + state.remotes.map(r => `<option value="${r.name}">${r.label} (${r.name})</option>`).join("");
                            $("cl-remote").value = state.remote || "";
                            if ($("cl-provider") && !$("cl-provider").options.length) {
                                Object.entries(state.providers).filter(([k]) => !["webdav", "sftp"].includes(k)).forEach(([k, v]) => $("cl-provider").add(new Option(v, k)));
                            }
                            $("cl-recursive").checked = state.recursive; $("cl-trash").checked = state.trash; $("cl-auto").checked = state.auto;
                            $("cl-folders-box").classList.toggle("hidden", !state.remote);
                            if (state.remote) loadFolders();
                        }
                        async function loadFolders() {
                            $("cl-folders").textContent = T.loading;
                            const d = await (await fetch("/api/cloud/folders")).json();
                            if (!d.success) { $("cl-folders").textContent = ""; say(d.message, false); return; }
                            const chosen = new Set(state.folders.map(f => f.id));
                            $("cl-folders").innerHTML = "";
                            d.folders.forEach(f => {
                                const label = document.createElement("label");
                                const box = document.createElement("input"); box.type = "checkbox"; box.checked = chosen.has(f.id);
                                box.addEventListener("change", saveFolders);
                                box.dataset.id = f.id; box.dataset.name = f.name;
                                label.append(box, document.createTextNode(" " + f.name));
                                $("cl-folders").appendChild(label);
                            });
                        }
                        async function saveFolders() {
                            const folders = [...document.querySelectorAll("#cl-folders input:checked")].map(b => ({ id: b.dataset.id, name: b.dataset.name }));
                            const r = await post("/api/cloud", { folders }); say(r.message, r.success); state.folders = folders;
                        }
                        $("cl-remote").addEventListener("change", async () => { const r = await post("/api/cloud", { remote: $("cl-remote").value, folders: [] }); say(r.message, r.success); load(); });
                        [["cl-recursive", "recursive"], ["cl-trash", "trash"], ["cl-auto", "auto"]].forEach(([id, key]) =>
                            $(id).addEventListener("change", async () => { const r = await post("/api/cloud", { [key]: $(id).checked }); say(r.message, r.success); }));
                        $("cl-sync").addEventListener("click", async () => { const r = await post("/api/cloud/sync"); say(r.message, r.success); });
                        if ($("cl-add-open")) {
                            $("cl-add-open").addEventListener("click", () => $("cl-add").classList.toggle("hidden"));
                            const cmd = () => { $("cl-cmd").textContent = `rclone authorize "${$("cl-provider").value}"`; if (!$("cl-name").dataset.edited) $("cl-name").value = $("cl-provider").value; };
                            $("cl-provider").addEventListener("change", cmd);
                            $("cl-name").addEventListener("input", () => $("cl-name").dataset.edited = "1");
                            $("cl-add-save").addEventListener("click", async () => {
                                const r = await post("/api/cloud/remote", { name: $("cl-name").value.trim(), provider: $("cl-provider").value, token: $("cl-token").value.trim() });
                                say(r.message, r.success);
                                if (r.success) { $("cl-token").value = ""; $("cl-add").classList.add("hidden"); load(); }
                            });
                        }
                        document.querySelectorAll(".tablink[onclick*=\"'tab-sources'\"]").forEach(b => b.addEventListener("click", () => setTimeout(load, 50)));
                        load();
                    });
                </script>

                <fieldset class="mt-4 hidden" id="gdrive-denied-box">
                    <legend>
                        <h3><i class="fab fa-google-drive mr-2"></i>{{ _("Photos que le cadre ne peut pas retirer du Drive") }}</h3>
                    </legend>
                    <p class="text-sm text-gray-600 mb-3">{{ _("Ces photos ont été déposées dans le dossier par un autre compte Google : seul leur propriétaire peut les mettre à la corbeille. Elles restent affichées sur le cadre. Supprimez-les vous-même depuis Drive (si vous en avez le droit) ou demandez à leur propriétaire, puis cliquez sur « Réessayer ».") }}</p>
                    <ul id="gdrive-denied" class="denied-list"></ul>
                    <button type="button" id="gdrive-denied-retry" class="btn-secondary mt-3"><i class="fas fa-redo mr-1"></i>{{ _("Réessayer à la prochaine synchronisation") }}</button>
                    <span id="gdrive-denied-status" class="text-sm ml-2"></span>
                </fieldset>
                <script>
                    window.addEventListener("DOMContentLoaded", () => {
                        const $ = (id) => document.getElementById(id);
                        const OPEN = {{ _("Ouvrir dans Drive")|tojson }}, GONE = {{ _("(plus sur le cadre)")|tojson }};
                        async function loadDenied() {
                            const data = await (await fetch("/api/gdrive/denied")).json();
                            $("gdrive-denied-box").classList.toggle("hidden", !data.files.length);
                            $("gdrive-denied").innerHTML = "";
                            data.files.forEach(f => {
                                const li = document.createElement("li");
                                const name = document.createElement("span");
                                name.className = "denied-name";
                                name.textContent = f.remote_path + (f.local ? "" : " " + GONE);
                                li.appendChild(name);
                                if (f.drive_url) {
                                    const a = document.createElement("a");
                                    a.href = f.drive_url; a.target = "_blank"; a.rel = "noopener"; a.className = "link";
                                    a.innerHTML = '<i class="fas fa-external-link-alt mr-1"></i>'; a.append(OPEN);
                                    li.appendChild(a);
                                }
                                $("gdrive-denied").appendChild(li);
                            });
                        }
                        $("gdrive-denied-retry").addEventListener("click", async () => {
                            const r = await (await fetch("/api/gdrive/denied/retry", { method: "POST" })).json();
                            $("gdrive-denied-status").textContent = r.message;
                            loadDenied();
                        });
                        loadDenied();
                    });
                </script>

                <fieldset class="mt-4">
                    <legend>
                        <h3>{{ _("Options de démarrage") }}</h3>
                    </legend>
                    <div class="form-check form-switch my-3">
                        <input class="form-check-input" type="checkbox" id="skip_initial_auto_import" name="skip_initial_auto_import" {% if config.get('skip_initial_auto_import', False) %}checked{% endif %}>
                        <label class="form-check-label ml-2" for="skip_initial_auto_import">{{ _("Ignorer le premier import automatique au démarrage") }}</label>
                    </div>
                    <p class="text-sm text-gray-600 mt-2">{{ _("Si cette option est cochée, les mises à jour automatiques (Immich, Samba) ne se lanceront pas immédiatement après un redémarrage du cadre, mais attendront le prochain cycle programmé.") }}</p>
                </fieldset>
            </div>
