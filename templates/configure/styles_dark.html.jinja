{#- Mode sombre de l'interface : variables de couleur, et équivalents sombres des classes Tailwind utilisées dans les onglets. -#}
<style>
    html[data-theme="dark"] {
        color-scheme: dark;
        --bg: #12141d; --card: #1b1e2b; --text: #e7e9f2; --muted: #9aa0b6; --border: #2d3145;
        --accent: #8b84ff; --accent-soft: #272a4b; --topbar-bg: rgba(18, 20, 29, .92); --input-bg: #232738;
    }
    html[data-theme="dark"] .bg-white, html[data-theme="dark"] .bg-gray-50 { background-color: var(--card) !important; }
    html[data-theme="dark"] .bg-gray-100 { background-color: #222637 !important; }
    html[data-theme="dark"] .bg-gray-200, html[data-theme="dark"] .bg-gray-300 { background-color: #2c3044 !important; }
    html[data-theme="dark"] .text-gray-900, html[data-theme="dark"] .text-gray-800, html[data-theme="dark"] .text-gray-700,
    html[data-theme="dark"] .text-black { color: var(--text) !important; }
    html[data-theme="dark"] .text-gray-600, html[data-theme="dark"] .text-gray-500, html[data-theme="dark"] .text-gray-400 { color: var(--muted) !important; }
    html[data-theme="dark"] .border, html[data-theme="dark"] .border-gray-100, html[data-theme="dark"] .border-gray-200,
    html[data-theme="dark"] .border-gray-300, html[data-theme="dark"] .border-t, html[data-theme="dark"] .border-b { border-color: var(--border) !important; }
    html[data-theme="dark"] .bg-blue-50, html[data-theme="dark"] .bg-blue-100, html[data-theme="dark"] .bg-indigo-50,
    html[data-theme="dark"] .bg-indigo-100 { background-color: rgba(99, 102, 241, .16) !important; }
    html[data-theme="dark"] .bg-green-50, html[data-theme="dark"] .bg-green-100 { background-color: rgba(34, 197, 94, .14) !important; }
    html[data-theme="dark"] .bg-yellow-50, html[data-theme="dark"] .bg-yellow-100 { background-color: rgba(234, 179, 8, .16) !important; }
    html[data-theme="dark"] .bg-red-50, html[data-theme="dark"] .bg-red-100 { background-color: rgba(239, 68, 68, .16) !important; }
    html[data-theme="dark"] .bg-purple-100, html[data-theme="dark"] .bg-pink-100 { background-color: rgba(168, 85, 247, .16) !important; }
    html[data-theme="dark"] .text-green-700, html[data-theme="dark"] .text-green-800 { color: #4ade80 !important; }
    html[data-theme="dark"] .text-red-600, html[data-theme="dark"] .text-red-700 { color: #f87171 !important; }
    html[data-theme="dark"] .text-blue-600, html[data-theme="dark"] .text-blue-800, html[data-theme="dark"] .text-indigo-600 { color: #93c5fd !important; }
    html[data-theme="dark"] .text-yellow-800 { color: #fde047 !important; }
    html[data-theme="dark"] input:not([type=checkbox]):not([type=radio]):not([type=range]):not([type=color]),
    html[data-theme="dark"] select, html[data-theme="dark"] textarea {
        background-color: var(--input-bg) !important; color: var(--text) !important; border-color: var(--border) !important;
    }
    html[data-theme="dark"] .progress-container { background-color: #232738; border-color: var(--border); }
    html[data-theme="dark"] code, html[data-theme="dark"] pre { background-color: #232738 !important; color: var(--text); }
    html[data-theme="dark"] .smart-badge { background: rgba(139, 92, 246, .22); color: #c4b5fd; }
    html[data-theme="dark"] a.link, html[data-theme="dark"] .link { color: var(--accent); }
    html[data-theme="dark"] .tabcontent label { color: #c9cde0; }
    html[data-theme="dark"] .sub-nav-group .tablink.active, html[data-theme="dark"] .chip.active { background: var(--accent); border-color: var(--accent); color: #fff; }
    html[data-theme="dark"] .hw-ok, html[data-theme="dark"] .spp-device { color: #4ade80; }
    html[data-theme="dark"] .hw-warn { color: #fbbf24; }
    html[data-theme="dark"] .spp-controls button.on { color: #4ade80; background: rgba(34, 197, 94, .16); }
    html[data-theme="dark"] fieldset, html[data-theme="dark"] legend, html[data-theme="dark"] h2 { color: var(--text); }
    html[data-theme="dark"] hr { border-color: var(--border); }
    .theme-switch { display: flex; gap: 6px; margin-bottom: 12px; }
    .theme-switch button { all: unset; cursor: pointer; padding: 4px 9px; border: 1px solid var(--border); border-radius: 8px; font-size: .8rem; }
    .theme-switch button.active { background: var(--accent); color: #fff; border-color: var(--accent); }
</style>
