        <div id="tab-actions" class="tabcontent">
            <fieldset>
                <legend>
                    <h3>{{ _("Actions") }}</h3>
                </legend>

                <div class="action-group">
                    <h4>{{ _("Gestion du diaporama") }}</h4>
                    <form method="POST" action="/toggle_slideshow">
                        <button type="submit"
                            class="system-button {% if slideshow_running %}bg-red-500 hover:bg-red-700{% else %}bg-green-500 hover:bg-green-700{% endif %} text-white font-bold py-2 px-4 rounded">
                            {% if slideshow_running %}
                            <i class="fas fa-stop"></i> {{ _("Arrêter le diaporama") }}
                            {% else %}
                            <i class="fas fa-play"></i> {{ _("Démarrer le diaporama") }}
                            {% endif %}
                        </button>
                    </form>
                    <div class="flex justify-center items-center gap-4 mt-4" id="slideshow-controls-actions">
                        <button type="button"
                            class="notification-toggle-btn bg-gray-600 hover:bg-gray-700 text-white p-3 rounded-full w-16 h-16 flex items-center justify-center"
                            title="{{ _('Activer/Désactiver les notifications') }}">
                            <i class="fas fa-bell fa-lg"></i>
                        </button>
                        <button type="button"
                            class="slideshow-control-btn bg-gray-600 hover:bg-gray-700 text-white p-3 rounded-full w-16 h-16 flex items-center justify-center"
                            data-command="previous" title="{{ _('Photo précédente') }}">
                            <i class="fas fa-backward fa-lg"></i>
                        </button>
                        <button type="button"
                            class="slideshow-control-btn bg-gray-600 hover:bg-gray-700 text-white p-3 rounded-full w-20 h-20 flex items-center justify-center"
                            data-command="toggle_pause" title="{{ _('Pause/Lecture') }}">
                            <i class="slideshow-pause-icon fas fa-pause fa-2x"></i>
                        </button>
                        <button type="button"
                            class="slideshow-control-btn bg-gray-600 hover:bg-gray-700 text-white p-3 rounded-full w-16 h-16 flex items-center justify-center"
                            data-command="next" title="{{ _('Photo suivante') }}">
                            <i class="fas fa-forward fa-lg"></i>
                        </button>
                    </div>
                </div>

                <div class="action-group">
                    <h4>{{ _("Importation des photos") }}</h4>
                    <button id="usb-import-btn"
                        class="import-button bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                        <i class="fas fa-file-import"></i> {{ _("Importer depuis la clé USB") }}
                    </button>
                    <div id="usb-progress-container" class="progress-container hidden">
                        <div id="usb-progress-bar" class="progress-bar"></div>
                    </div>
                    <div id="usb-import-status" class="status-messages"></div>

                    <button id="immich-import-btn"
                        class="import-button bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                        <i class="fas fa-cloud-download-alt"></i> {{ _("Importer depuis Immich") }}
                    </button>
                    <div id="immich-progress-container" class="progress-container hidden">
                        <div id="immich-progress-bar" class="progress-bar"></div>
                    </div>
                    <div id="immich-import-status" class="status-messages"></div>

                    <button id="samba-import-btn"
                        class="import-button bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                        <i class="fas fa-network-wired"></i> {{ _("Importer depuis Samba") }}
                    </button>
                    <div id="samba-progress-container" class="progress-container hidden">
                        <div id="samba-progress-bar" class="progress-bar"></div>
                    </div>
                    <div id="samba-import-status" class="status-messages"></div>

                    <button id="gdrive-import-btn"
                        class="import-button bg-blue-500 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
                        <i class="fab fa-google-drive"></i> {{ _("Importer depuis Google Drive") }}
                    </button>
                    <div id="gdrive-progress-container" class="progress-container hidden">
                        <div id="gdrive-progress-bar" class="progress-bar"></div>
                    </div>
                    <div id="gdrive-import-status" class="status-messages"></div>

                    <!-- NOUVEAU: Conteneur pour l'aperçu de la préparation -->
                    <div id="preparation-preview-container"
                        class="hidden mt-4 p-3 bg-gray-100 rounded-lg border text-center">
                        <p class="text-sm font-semibold text-gray-600 mb-2">{{ _("Préparation en cours...") }}</p>
                        <img id="preparation-preview-image" src="" alt="{{ _('Photo en cours de préparation') }}"
                            class="mx-auto max-w-xs max-h-48 rounded shadow">
                    </div>

                    <div class="mt-4 pt-4 border-t border-gray-200">
                        <p class="text-sm text-gray-600">{{ _("L'import depuis Telegram se fait automatiquement à la
                            réception des photos. Activez la source dans l'onglet \"Sources\" pour les voir.") }}</p>
                    </div>

                    <!-- Smartphone Upload Form -->
                    <form id="smartphone-upload-form" enctype="multipart/form-data"
                        class="mt-4 pt-4 border-t border-gray-200">
                        <h5 class="text-lg font-semibold mb-2 flex items-center gap-2"><i class="fas fa-mobile-alt"></i>
                            {{ _("Importer depuis un Smartphone") }}</h5>
                        <p class="text-sm text-gray-600 mb-3">{{ _("Envoyez des photos directement depuis votre
                            téléphone via le navigateur.") }}</p>
                        <input type="file" name="photos"
                            class="block w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 cursor-pointer focus:outline-none mb-3"
                            multiple required>
                        <button type="submit" id="import-smartphone-btn"
                            class="import-button bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded">
                            <i class="fas fa-upload"></i> {{ _("Envoyer les photos") }}
                        </button>
                    </form>
                    <div id="smartphone-progress-container" class="progress-container hidden">
                        <div id="smartphone-progress-bar" class="progress-bar"></div>
                    </div>
                    <div id="smartphone-import-status" class="status-messages"></div>

                    <div id="my-uploads-box" class="mt-4 pt-4 border-t border-gray-200">
                        <h5 class="text-lg font-semibold mb-2 flex items-center gap-2"><i class="fas fa-user"></i> {{ _("Mes envois") }}</h5>
                        <p class="text-sm text-gray-600 mb-2">{{ _("Les photos envoyées depuis ce compte s'ajoutent à votre source « Envois de %(name)s ». Touchez la croix pour en retirer une.", name=current_username or "") }}</p>
                        <div id="my-uploads" class="my-uploads"></div>
                        <p id="my-uploads-empty" class="text-sm text-gray-500">{{ _("Aucun envoi pour l'instant.") }}</p>
                    </div>
                    <style>
                        .my-uploads { display: grid; grid-template-columns: repeat(auto-fill, minmax(90px, 1fr)); gap: .4rem; }
                        .my-uploads div { position: relative; }
                        .my-uploads img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 8px; }
                        .my-uploads button { position: absolute; top: 4px; right: 4px; width: 24px; height: 24px; border-radius: 50%; background: rgba(0,0,0,.6); color: #fff; }
                    </style>
                    <script>
                        window.addEventListener("DOMContentLoaded", () => {
                            const $ = (id) => document.getElementById(id);
                            async function load() {
                                const d = await (await fetch("/api/my_uploads")).json();
                                $("my-uploads").innerHTML = "";
                                $("my-uploads-empty").classList.toggle("hidden", d.items.length > 0);
                                d.items.slice(0, 120).forEach(item => {
                                    const box = document.createElement("div");
                                    const img = document.createElement("img"); img.src = item.thumb; img.loading = "lazy"; img.alt = "";
                                    const b = document.createElement("button"); b.type = "button"; b.textContent = "×"; b.title = {{ _("Retirer du cadre")|tojson }};
                                    b.addEventListener("click", async () => {
                                        if (!confirm({{ _("Retirer cette photo du cadre ?")|tojson }})) return;
                                        const r = await (await fetch(`/api/my_uploads/${encodeURIComponent(item.name)}`, { method: "DELETE" })).json();
                                        if (r.success) box.remove();
                                    });
                                    box.append(img, b); $("my-uploads").appendChild(box);
                                });
                            }
                            document.querySelectorAll(".tablink[onclick*=\"'tab-actions'\"]").forEach(b => b.addEventListener("click", () => setTimeout(load, 50)));
                            if ($("my-uploads-box").offsetParent !== null) load();
                            window.refreshMyUploads = load;
                        });
                    </script>

                    <div id="whatsapp-box" class="mt-4 pt-4 border-t border-gray-200">
                        <h5 class="text-lg font-semibold mb-2 flex items-center gap-2"><i class="fab fa-whatsapp"></i> {{ _("Importer une discussion WhatsApp") }}</h5>
                        <p class="text-sm text-gray-600 mb-3">{{ _("Dans WhatsApp : ouvrez la discussion (ou le groupe familial) › nom en haut › « Exporter la discussion » › « Joindre les médias ». Envoyez le fichier .zip obtenu ici. Sur Android, avec Pimmich installé sur l'écran d'accueil, vous pouvez aussi choisir directement « Pimmich » dans le menu de partage.") }}</p>
                        <input type="file" id="wa-file" accept=".zip,application/zip"
                            class="block w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 cursor-pointer focus:outline-none mb-3">
                        <div id="wa-upload-progress" class="progress-container hidden"><div class="progress-bar"></div></div>
                        <div id="wa-summary" class="hidden p-3 rounded-lg bg-gray-50">
                            <p id="wa-counts" class="font-semibold"></p>
                            <p class="text-sm mt-2">{{ _("Expéditeurs à importer :") }}</p>
                            <div id="wa-senders" class="flex flex-wrap gap-x-4 gap-y-1 mt-1"></div>
                            <label class="block text-sm mt-3" for="wa-caption">{{ _("Légende des photos :") }}</label>
                            <select id="wa-caption">
                                <option value="text">{{ _("Le message qui accompagne la photo") }}</option>
                                <option value="both">{{ _("Le prénom de l'expéditeur et son message") }}</option>
                                <option value="sender">{{ _("Le prénom de l'expéditeur") }}</option>
                                <option value="none">{{ _("Aucune") }}</option>
                            </select>
                            <button type="button" id="wa-import" class="import-button bg-green-500 hover:bg-green-700 text-white font-bold py-2 px-4 rounded mt-3">
                                <i class="fas fa-file-import"></i> {{ _("Importer") }}
                            </button>
                        </div>
                        <p id="wa-status" class="text-sm mt-2"></p>
                    </div>
                    <script>
                        window.addEventListener("DOMContentLoaded", () => {
                            const $ = (id) => document.getElementById(id);
                            const T = { photos: {{ _("{photos} photos et {videos} vidéos, du {first} au {last}")|tojson }},
                                        sending: {{ _("Envoi de l'export…")|tojson }}, failed: {{ _("Envoi impossible.")|tojson }} };
                            const say = (t, ok) => { $("wa-status").textContent = t || ""; $("wa-status").className = "text-sm mt-2 " + (ok ? "text-green-700" : "text-red-600"); };
                            const day = (iso) => iso ? new Date(iso).toLocaleDateString() : "?";
                            $("wa-file").addEventListener("change", () => {
                                const file = $("wa-file").files[0];
                                if (!file) return;
                                const form = new FormData(); form.append("export", file);
                                const xhr = new XMLHttpRequest();
                                const bar = $("wa-upload-progress");
                                bar.classList.remove("hidden"); $("wa-summary").classList.add("hidden"); say(T.sending, true);
                                xhr.upload.onprogress = (e) => { if (e.lengthComputable) bar.firstElementChild.style.width = `${Math.round(e.loaded / e.total * 100)}%`; };
                                xhr.onload = () => {
                                    bar.classList.add("hidden");
                                    let r; try { r = JSON.parse(xhr.responseText); } catch (e) { r = { success: false, message: T.failed }; }
                                    if (!r.success) { say(r.message, false); return; }
                                    say("", true);
                                    const s = r.summary;
                                    $("wa-counts").textContent = T.photos.replace("{photos}", s.photos).replace("{videos}", s.videos).replace("{first}", day(s.first)).replace("{last}", day(s.last));
                                    $("wa-senders").innerHTML = "";
                                    s.senders.forEach(p => {
                                        const label = document.createElement("label"); label.className = "flex items-center gap-1";
                                        const box = document.createElement("input"); box.type = "checkbox"; box.checked = true; box.value = p.name;
                                        label.append(box, document.createTextNode(` ${p.name} (${p.count})`));
                                        $("wa-senders").appendChild(label);
                                    });
                                    $("wa-summary").classList.remove("hidden");
                                };
                                xhr.onerror = () => { bar.classList.add("hidden"); say(T.failed, false); };
                                xhr.open("POST", "/api/whatsapp/upload"); xhr.send(form);
                            });
                            $("wa-import").addEventListener("click", async () => {
                                const boxes = [...document.querySelectorAll("#wa-senders input")];
                                const senders = boxes.every(b => b.checked) ? [] : boxes.filter(b => b.checked).map(b => b.value);
                                const r = await (await fetch("/api/whatsapp/import", { method: "POST", headers: { "Content-Type": "application/json" },
                                    body: JSON.stringify({ senders, caption: $("wa-caption").value }) })).json();
                                say(r.message, r.success);
                                if (r.success) { $("wa-summary").classList.add("hidden"); $("wa-file").value = ""; }
                            });
                        });
                    </script>

                    <hr class="my-6">
                    <h5 class="text-lg font-semibold mb-2 flex items-center gap-2"><i class="fas fa-file-audio"></i> {{ _("Importation de musique") }}</h5>
