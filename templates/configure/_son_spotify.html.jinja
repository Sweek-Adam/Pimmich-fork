                <section class="card" id="spotify-card">
                    <h2 class="card-title"><i class="fab fa-spotify text-green-600 mr-2"></i>Spotify</h2>

                    <div class="spotify-step">
                        <h3><span class="step-num">1</span>{{ _("Associer le cadre à votre compte") }}</h3>
                        <p class="text-sm text-gray-600">{{ _("Le cadre apparaît alors dans vos appareils Spotify, même quand vous n'êtes pas à la maison. Compte Premium nécessaire.") }}</p>
                        <div id="sp-linked" class="hidden mt-2 flex flex-wrap items-center gap-3">
                            <span class="badge on"><i class="fas fa-check mr-1"></i>{{ _("Associé") }}</span>
                            <span id="sp-account" class="text-sm"></span>
                            <button type="button" id="sp-unlink" class="link">{{ _("Dissocier") }}</button>
                        </div>
                        <div id="sp-unlinked" class="hidden mt-2">
                            <button type="button" id="sp-link" class="btn-secondary"><i class="fas fa-link mr-1"></i>{{ _("Associer mon compte") }}</button>
                        </div>
                        <div id="sp-pairing" class="hidden pair-box">
                            <p>{{ _("Ouvrez ce lien sur votre téléphone ou votre ordinateur, connectez-vous à Spotify et validez :") }}</p>
                            <a id="sp-pair-url" href="#" target="_blank" rel="noopener" class="btn-primary inline-block my-2"><i class="fas fa-external-link-alt mr-1"></i>spotify.com/pair</a>
                            <p>{{ _("Code :") }} <strong id="sp-pair-code" class="pair-code"></strong></p>
                            <p class="text-sm text-gray-600">{{ _("Cette page se met à jour toute seule une fois l'association validée.") }}</p>
                        </div>
                    </div>

                    <div class="spotify-step">
                        <h3><span class="step-num">2</span>{{ _("Choisir la musique depuis cette page") }}</h3>
                        <div id="sp-setup" class="hidden">
                            <p class="text-sm text-gray-600">{{ _("Une seule fois : Spotify demande de créer une « application » personnelle (gratuit, 5 minutes).") }}</p>
                            <ol class="setup-guide">
                                <li>{{ _("Ouvrez") }} <a href="https://developer.spotify.com/dashboard" target="_blank" rel="noopener" class="link">developer.spotify.com/dashboard</a> {{ _("et cliquez sur « Create app ».") }}</li>
                                <li>{{ _("Nom : Pimmich. Dans « Redirect URIs », collez cette adresse :") }}
                                    <span class="copy-line"><code id="sp-redirect"></code><button type="button" id="sp-copy" class="link">{{ _("Copier") }}</button></span>
                                    {{ _("Cochez « Web API », acceptez les conditions et enregistrez.") }}</li>
                                <li>{{ _("Copiez le « Client ID » de l'application ici :") }}
                                    <span class="flex flex-wrap gap-2 mt-1"><input type="text" id="sp-client-id" class="font-mono" size="34" maxlength="32" placeholder="0123456789abcdef0123456789abcdef">
                                    <button type="button" id="sp-save-client" class="btn-secondary">{{ _("Enregistrer") }}</button></span></li>
                            </ol>
                            <p class="text-xs text-gray-500 mt-2">{{ _("Ouvrez toujours l'interface avec la même adresse que celle déclarée ci-dessus (même adresse IP ou même nom).") }}</p>
                        </div>
                        <div id="sp-login" class="hidden mt-2">
                            <a href="{{ url_for('spotify_login') }}" class="btn-primary inline-block"><i class="fab fa-spotify mr-1"></i>{{ _("Se connecter à Spotify") }}</a>
                            <button type="button" id="sp-change-client" class="link ml-3">{{ _("Changer d'application") }}</button>
                        </div>
                        <div id="sp-connected" class="hidden mt-2 flex flex-wrap items-center gap-3">
                            <span class="badge on"><i class="fas fa-check mr-1"></i>{{ _("Connecté") }}</span>
                            <button type="button" id="sp-disconnect" class="link">{{ _("Déconnecter") }}</button>
                        </div>
                    </div>

                    <div id="sp-music" class="hidden">
                        <div class="spotify-step">
                            <h3><span class="step-num"><i class="fas fa-headphones"></i></span>{{ _("Lecture en cours") }}</h3>
                            <p id="spp-idle" class="text-sm text-gray-600">{{ _("Rien ne joue sur votre compte Spotify pour le moment : lancez une playlist ci-dessous ou recherchez un titre.") }}</p>
                            <div id="spp" class="sp-player hidden">
                                <img id="spp-cover" alt="">
                                <div class="spp-main">
                                    <strong id="spp-title"></strong>
                                    <span id="spp-artist" class="muted"></span>
                                    <span class="spp-device"><i class="fas fa-volume-up"></i> <span id="spp-device"></span>
                                        <button type="button" id="spp-transfer" class="link hidden">{{ _("Écouter sur le cadre") }}</button></span>
                                    <div class="spp-progress"><span id="spp-pos">0:00</span><input type="range" id="spp-seek" min="0" max="1000" value="0" aria-label="{{ _('Avancement') }}"><span id="spp-dur">0:00</span></div>
                                    <div class="spp-controls mr-buttons">
                                        <button type="button" data-sp="shuffle" title="{{ _('Lecture aléatoire') }}" aria-label="{{ _('Lecture aléatoire') }}"><i class="fas fa-random"></i></button>
                                        <button type="button" data-sp="previous" title="{{ _('Précédent') }}" aria-label="{{ _('Précédent') }}"><i class="fas fa-step-backward"></i></button>
                                        <button type="button" data-sp="toggle" class="mr-main" title="{{ _('Lecture / pause') }}" aria-label="{{ _('Lecture / pause') }}"><i class="fas fa-play"></i></button>
                                        <button type="button" data-sp="next" title="{{ _('Suivant') }}" aria-label="{{ _('Suivant') }}"><i class="fas fa-step-forward"></i></button>
                                        <button type="button" data-sp="repeat" title="{{ _('Répéter') }}" aria-label="{{ _('Répéter') }}"><i class="fas fa-redo"></i><span class="spp-one">1</span></button>
                                    </div>
                                    <label class="mr-volume spp-volume"><i class="fas fa-volume-down"></i><input type="range" id="spp-volume" min="0" max="100" step="5" aria-label="{{ _('Volume Spotify') }}"><span id="spp-volume-value" class="mr-volume-value"></span></label>
                                </div>
                            </div>
                            <div id="spp-queue-box" class="hidden mt-3">
                                <h4 class="font-semibold text-sm mb-2">{{ _("À suivre sur Spotify") }}</h4>
                                <ol id="spp-queue" class="spp-list"></ol>
                            </div>
                        </div>
                        <div class="spotify-step">
                            <h3><span class="step-num"><i class="fas fa-search"></i></span>{{ _("Rechercher") }}</h3>
                            <input type="search" id="spp-search" placeholder="{{ _('Titre, artiste, album, playlist…') }}" class="w-full">
                            <div id="spp-results" class="spp-results"></div>
                        </div>
                        <div class="spotify-step">
                            <h3><span class="step-num"><i class="fas fa-play"></i></span>{{ _("Lire sur le cadre") }}</h3>
                            <div class="flex flex-wrap items-center gap-2 mb-3">
                                <input type="search" id="sp-filter" placeholder="{{ _('Rechercher une playlist…') }}" class="flex-1">
                            </div>
                            <div id="sp-playlists" class="sp-playlists"></div>
                        </div>
                        <div class="spotify-step">
                            <h3><span class="step-num"><i class="fas fa-magic"></i></span>{{ _("Musiques associées") }}</h3>
                            <p class="text-sm text-gray-600 mb-2">{{ _("Lancées automatiquement sur le cadre quand vous choisissez l'ambiance ou la playlist de photos.") }}</p>
                            <div id="sp-links" class="sp-links"></div>
                        </div>
                    </div>
                    <p id="sp-message" class="text-sm mt-2"></p>
                </section>

                <script>
                    window.addEventListener("DOMContentLoaded", () => {
                        const $ = (id) => document.getElementById(id);
                        const T = {
                            ambiance: {{ _("Ambiance")|tojson }}, playlist: {{ _("Playlist de photos")|tojson }},
                            none: {{ _("Aucune musique")|tojson }}, play: {{ _("Lire sur le cadre")|tojson }},
                            tracks: {{ _("titres")|tojson }}, empty: {{ _("Aucune playlist trouvée.")|tojson }},
                            account: {{ _("Compte :")|tojson }}, copied: {{ _("Copié")|tojson }},
                        };
                        const say = (text, ok) => { $("sp-message").textContent = text || ""; $("sp-message").className = "text-sm mt-2 " + (ok ? "text-green-600" : "text-red-600"); };
                        const post = async (url, body) => (await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) })).json();
                        let state = null, lists = [], polling = null, playerTimer = null;
                        // --- Lecture en cours sur Spotify ---
                        const fmt = (ms) => { const t = Math.max(0, Math.round(ms / 1000)); return `${Math.floor(t / 60)}:${String(t % 60).padStart(2, "0")}`; };
                        const P = { on: {{ _("sur")|tojson }}, add: {{ _("Ajouter à la file")|tojson }}, playNow: {{ _("Écouter maintenant sur le cadre")|tojson }},
                                    added: {{ _("Ajouté à la file d'attente.")|tojson }}, none: {{ _("Aucun résultat.")|tojson }},
                                    tracks: {{ _("Titres")|tojson }}, artists: {{ _("Artistes")|tojson }}, albums: {{ _("Albums")|tojson }}, playlists: {{ _("Playlists")|tojson }} };
                        let player = null, seeking = false, volTimer = null, tick = Date.now();
                        const spAction = async (action, value) => {
                            const r = await post('/api/spotify/player', { action, value });
                            if (!r.success) say(r.message, false); else setTimeout(loadPlayer, 600);
                            return r;
                        };
                        async function loadPlayer() {
                            if (!$("tab-son").offsetParent || !state || !state.connected) return;
                            try { player = await (await fetch('/api/spotify/player')).json(); } catch (e) { return; }
                            tick = Date.now();
                            renderPlayer();
                        }
                        function renderPlayer() {
                            const active = player && player.success && player.active;
                            $("spp").classList.toggle("hidden", !active);
                            $("spp-idle").classList.toggle("hidden", !!active);
                            $("spp-queue-box").classList.toggle("hidden", !active || !player.queue.length);
                            if (!active) return;
                            const t = player.track;
                            if ($("spp-cover").getAttribute("src") !== t.image) $("spp-cover").src = t.image || "";
                            $("spp-title").textContent = t.name;
                            $("spp-artist").textContent = [t.artists, t.album].filter(Boolean).join(" · ");
                            $("spp-device").textContent = `${P.on} ${player.device}`;
                            $("spp-transfer").classList.toggle("hidden", player.on_frame);
                            $("spp-dur").textContent = fmt(t.duration_ms);
                            updateProgress();
                            document.querySelector('[data-sp="toggle"] i').className = "fas " + (player.playing ? "fa-pause" : "fa-play");
                            document.querySelector('[data-sp="shuffle"]').classList.toggle("on", player.shuffle);
                            const repeat = document.querySelector('[data-sp="repeat"]');
                            repeat.classList.toggle("on", player.repeat !== "off");
                            repeat.classList.toggle("one", player.repeat === "track");
                            $("spp-volume").closest("label").classList.toggle("hidden", player.volume === null || player.volume === undefined);
                            if (!volTimer && player.volume !== null) { $("spp-volume").value = player.volume; $("spp-volume-value").textContent = `${player.volume} %`; }
                            $("spp-queue").innerHTML = "";
                            player.queue.forEach(q => $("spp-queue").appendChild(trackRow(q, false)));
                        }
                        function updateProgress() {
                            if (!player || !player.active || seeking) return;
                            const pos = Math.min(player.track.duration_ms, player.progress_ms + (player.playing ? Date.now() - tick : 0));
                            $("spp-pos").textContent = fmt(pos);
                            $("spp-seek").value = player.track.duration_ms ? Math.round(1000 * pos / player.track.duration_ms) : 0;
                        }
                        setInterval(updateProgress, 1000);
                        $("spp-seek").addEventListener("input", () => { seeking = true; $("spp-pos").textContent = fmt(player.track.duration_ms * $("spp-seek").value / 1000); });
                        $("spp-seek").addEventListener("change", async () => {
                            const ms = Math.round(player.track.duration_ms * $("spp-seek").value / 1000);
                            player.progress_ms = ms; tick = Date.now(); seeking = false;
                            await spAction("seek", ms);
                        });
                        document.querySelectorAll("[data-sp]").forEach(b => b.addEventListener("click", async () => {
                            const what = b.dataset.sp;
                            if (what === "toggle") { const r = await post('/api/spotify/control', { action: player.playing ? "pause" : "resume" }); if (!r.success) say(r.message, false); setTimeout(loadPlayer, 600); }
                            else if (what === "previous" || what === "next") { const r = await post('/api/spotify/control', { action: what }); if (!r.success) say(r.message, false); setTimeout(loadPlayer, 800); }
                            else if (what === "shuffle") spAction("shuffle", !player.shuffle);
                            else if (what === "repeat") spAction("repeat", { off: "context", context: "track", track: "off" }[player.repeat] || "off");
                        }));
                        $("spp-transfer").addEventListener("click", () => spAction("transfer"));
                        $("spp-volume").addEventListener("input", () => {
                            $("spp-volume-value").textContent = `${$("spp-volume").value} %`;
                            clearTimeout(volTimer);
                            volTimer = setTimeout(async () => { await spAction("volume", Number($("spp-volume").value)); volTimer = null; }, 300);
                        });
                        function trackRow(t, actions) {
                            const li = document.createElement("li");
                            const img = document.createElement(t.thumb ? "img" : "span");
                            if (t.thumb) { img.src = t.thumb; img.loading = "lazy"; img.alt = ""; } else { img.className = "np-nocover"; img.innerHTML = '<i class="fas fa-music"></i>'; }
                            const text = document.createElement("span"); text.className = "spp-text";
                            const name = document.createElement("strong"); name.textContent = t.name;
                            const sub = document.createElement("small"); sub.textContent = t.artists || "";
                            text.append(name, sub); li.append(img, text);
                            if (actions) {
                                const bar = document.createElement("span"); bar.className = "spp-row-actions";
                                const playBtn = document.createElement("button"); playBtn.type = "button"; playBtn.title = P.playNow; playBtn.setAttribute("aria-label", P.playNow);
                                playBtn.innerHTML = '<i class="fas fa-play"></i>';
                                playBtn.addEventListener("click", () => spAction("play_uri", t.uri));
                                bar.appendChild(playBtn);
                                if (/^spotify:(track|episode):/.test(t.uri)) {
                                    const addBtn = document.createElement("button"); addBtn.type = "button"; addBtn.title = P.add; addBtn.setAttribute("aria-label", P.add);
                                    addBtn.innerHTML = '<i class="fas fa-plus"></i>';
                                    addBtn.addEventListener("click", async () => { const r = await spAction("queue_uri", t.uri); if (r.success) say(P.added, true); });
                                    bar.appendChild(addBtn);
                                }
                                li.appendChild(bar);
                            }
                            return li;
                        }
                        let searchTimer = null;
                        $("spp-search").addEventListener("input", () => {
                            clearTimeout(searchTimer);
                            searchTimer = setTimeout(async () => {
                                const q = $("spp-search").value.trim(), box = $("spp-results");
                                if (q.length < 2) { box.innerHTML = ""; return; }
                                const r = await (await fetch('/api/spotify/search?q=' + encodeURIComponent(q))).json();
                                box.innerHTML = "";
                                if (!r.success) { say(r.message, false); return; }
                                const groups = [[P.tracks, r.tracks], [P.artists, r.artists], [P.albums, r.albums], [P.playlists, r.playlists]].filter(g => g[1].length);
                                if (!groups.length) { box.innerHTML = `<p class="muted">${P.none}</p>`; return; }
                                groups.forEach(([title, items]) => {
                                    const h = document.createElement("h4"); h.className = "font-semibold text-sm mt-3 mb-1"; h.textContent = title;
                                    const ol = document.createElement("ol"); ol.className = "spp-list";
                                    items.forEach(i => ol.appendChild(trackRow(i, true)));
                                    box.append(h, ol);
                                });
                            }, 400);
                        });

                        async function load() {
                            state = await (await fetch('/api/spotify')).json();
                            $("sp-linked").classList.toggle("hidden", !state.linked);
                            $("sp-unlinked").classList.toggle("hidden", state.linked || state.pending);
                            $("sp-pairing").classList.toggle("hidden", !state.pending);
                            $("sp-account").textContent = state.account ? `${T.account} ${state.account}` : "";
                            if (state.pending && state.url) { $("sp-pair-url").href = state.url; $("sp-pair-code").textContent = state.code || ""; }
                            if (!state.pending && polling) { clearInterval(polling); polling = null; }
                            $("sp-redirect").textContent = state.redirect_uri;
                            $("sp-client-id").value = state.client_id || "";
                            const hasClient = !!state.client_id;
                            $("sp-setup").classList.toggle("hidden", (hasClient || state.connected) && !$("sp-setup").dataset.force);
                            $("sp-login").classList.toggle("hidden", !hasClient || state.connected);
                            $("sp-connected").classList.toggle("hidden", !state.connected);
                            $("sp-music").classList.toggle("hidden", !state.connected);
                            if (state.connected && !lists.length) loadPlaylists();
                            if (state.connected && !playerTimer) { loadPlayer(); playerTimer = setInterval(loadPlayer, 4000); }
                        }

                        async function loadPlaylists() {
                            const data = await (await fetch('/api/spotify/playlists')).json();
                            if (!data.success) { say(data.message, false); return; }
                            lists = data.playlists;
                            renderPlaylists(); renderLinks();
                        }

                        function renderPlaylists() {
                            const q = $("sp-filter").value.trim().toLowerCase();
                            const box = $("sp-playlists"); box.innerHTML = "";
                            const shown = lists.filter(p => !q || p.name.toLowerCase().includes(q));
                            if (!shown.length) { box.innerHTML = `<p class="muted">${T.empty}</p>`; return; }
                            shown.forEach(p => {
                                const card = document.createElement("button");
                                card.type = "button"; card.className = "sp-playlist"; card.title = T.play;
                                const img = document.createElement(p.image ? "img" : "span");
                                if (p.image) { img.src = p.image; img.loading = "lazy"; img.alt = ""; } else { img.className = "np-nocover"; img.innerHTML = '<i class="fas fa-music"></i>'; }
                                const text = document.createElement("span");
                                const name = document.createElement("strong"); name.textContent = p.name;
                                const count = document.createElement("small"); count.textContent = `${p.tracks} ${T.tracks}`;
                                text.append(name, count);
                                card.append(img, text);
                                card.addEventListener("click", async () => { const r = await post('/api/spotify/play', { uri: p.uri }); say(r.message, r.success); });
                                box.appendChild(card);
                            });
                        }

                        function renderLinks() {
                            const box = $("sp-links"); box.innerHTML = "";
                            const rows = [...state.ambiances.map(a => ({ key: `ambiance:${a.key}`, label: `${T.ambiance} · ${a.label}` })),
                                          ...state.photo_playlists.map(p => ({ key: `playlist:${p.id}`, label: `${T.playlist} · ${p.name}` }))];
                            rows.forEach(row => {
                                const label = document.createElement("label"); label.textContent = row.label;
                                const select = document.createElement("select");
                                select.add(new Option(T.none, ""));
                                lists.forEach(p => select.add(new Option(p.name, p.uri)));
                                select.value = state.links[row.key] || "";
                                select.addEventListener("change", async () => { const r = await post('/api/spotify/links', { key: row.key, uri: select.value }); say(r.message, r.success); state.links[row.key] = select.value; });
                                box.append(label, select);
                            });
                        }

                        $("sp-link").addEventListener("click", async () => {
                            say({{ _("Demande de code à Spotify…")|tojson }}, true);
                            const r = await post('/api/spotify/link');
                            if (!r.success) { say(r.message, false); return; }
                            say("", true);
                            await load();
                            polling = setInterval(load, 3000);
                        });
                        $("sp-unlink").addEventListener("click", async () => { const r = await post('/api/spotify/unlink'); say(r.message, r.success); load(); });
                        $("sp-save-client").addEventListener("click", async () => {
                            const r = await post('/api/spotify/client_id', { client_id: $("sp-client-id").value });
                            say(r.message, r.success);
                            if (r.success) { delete $("sp-setup").dataset.force; load(); }
                        });
                        $("sp-change-client").addEventListener("click", () => { $("sp-setup").dataset.force = "1"; $("sp-setup").classList.remove("hidden"); });
                        $("sp-copy").addEventListener("click", async () => {
                            try { await navigator.clipboard.writeText($("sp-redirect").textContent); $("sp-copy").textContent = T.copied; } catch (e) { /* copie manuelle */ }
                        });
                        $("sp-disconnect").addEventListener("click", async () => { const r = await post('/api/spotify/disconnect'); say(r.message, r.success); lists = []; load(); });
                        $("sp-filter").addEventListener("input", renderPlaylists);
                        document.querySelectorAll(".tablink[onclick*=\"'tab-son'\"], .main-nav-link[data-group]").forEach(b => b.addEventListener("click", () => setTimeout(loadPlayer, 100)));
                        load();
                    });
                </script>
