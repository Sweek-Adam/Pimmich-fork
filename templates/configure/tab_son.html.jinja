            <div id="tab-son" class="tabcontent">
                <section class="card">
                    <h2 class="card-title"><i class="fas fa-music text-indigo-500 mr-2"></i>{{ _("Musique du diaporama") }}</h2>
                    <p class="text-sm text-gray-600 mb-3">{{ _("Jouée en boucle pendant le diaporama. Chaque playlist peut avoir sa propre musique (rubrique Playlists).") }}</p>
                    <div class="grid md:grid-cols-2 gap-4 items-end">
                        <div>
                            <label for="sound-music" class="block">{{ _("Musique") }}</label>
                            <select id="sound-music" class="w-full"><option value="">{{ _("Aucune musique") }}</option></select>
                        </div>
                        <div>
                            <label for="sound-volume">{{ _("Volume") }} : <span id="sound-volume-value">80</span> %</label>
                            <input type="range" id="sound-volume" min="0" max="100" step="5" class="w-full">
                        </div>
                    </div>
                    <audio id="sound-preview" controls class="w-full mt-3 hidden"></audio>
                    <div class="flex flex-wrap items-center gap-3 mt-4">
                        <button type="button" id="sound-save" class="btn-primary"><i class="fas fa-check mr-1"></i>{{ _("Appliquer") }}</button>
                        <label class="btn-secondary cursor-pointer"><i class="fas fa-upload mr-1"></i>{{ _("Ajouter une musique (MP3, WAV)") }}
                            <input type="file" id="sound-upload" accept=".mp3,.wav,audio/mpeg,audio/wav" class="hidden"></label>
                        <span id="sound-status" class="text-sm"></span>
                    </div>
                    <p class="text-sm text-gray-600 mt-3">{{ _("Le son des vidéos (activé ou non, sortie HDMI ou jack, volume) se règle dans Écran > Affichage.") }}
                        <button type="button" class="link" onclick="goToTab('tab-affichage')">{{ _("Y aller") }}</button></p>
                </section>

                <section class="card">
                    <h2 class="card-title"><i class="fas fa-compact-disc text-indigo-500 mr-2"></i>{{ _("Lecteur à l'écran") }}</h2>
                    <div id="np-now" class="now-playing hidden">
                        <img id="np-cover" alt="" class="hidden">
                        <span id="np-nocover" class="np-nocover"><i class="fas fa-music"></i></span>
                        <span class="np-text"><strong id="np-title"></strong><small id="np-artist"></small></span>
                        <span id="np-source" class="badge on"></span>
                    </div>
                    <p id="np-idle" class="text-sm text-gray-600 mb-3">{{ _("Aucune musique en cours de lecture.") }}</p>
                    <div class="grid md:grid-cols-2 gap-4 mt-3">
                        <div>
                            <label for="np-display" class="block">{{ _("Afficher le morceau sur le cadre") }}</label>
                            <select id="np-display" class="w-full">
                                <option value="change">{{ _("Quelques secondes à chaque nouveau morceau") }}</option>
                                <option value="always">{{ _("En permanence pendant la lecture") }}</option>
                                <option value="off">{{ _("Ne pas afficher") }}</option>
                            </select>
                        </div>
                        <div>
                            <label for="np-position" class="block">{{ _("Position") }}</label>
                            <select id="np-position" class="w-full">
                                <option value="bottom_left">{{ _("En bas à gauche") }}</option>
                                <option value="bottom_right">{{ _("En bas à droite") }}</option>
                                <option value="top_left">{{ _("En haut à gauche") }}</option>
                                <option value="top_right">{{ _("En haut à droite") }}</option>
                            </select>
                        </div>
                    </div>
                    <p class="text-sm text-gray-600 mt-3">{{ _("Un petit encart discret (pochette, titre, artiste) pour la musique du diaporama, Spotify et AirPlay. Pendant que Spotify ou AirPlay joue, la musique du diaporama se met en pause.") }}</p>
                </section>

                <section class="card">
                    <h2 class="card-title"><i class="fas fa-broadcast-tower text-indigo-500 mr-2"></i>{{ _("Spotify, Deezer et autres applications") }}</h2>
                    <div class="grid md:grid-cols-2 gap-4">
                        <div class="receiver">
                            <h3><i class="fab fa-spotify text-green-600"></i> Spotify Connect <span id="recv-spotify" class="badge">…</span></h3>
                            <p>{{ _("Dans l'application Spotify, choisissez « Cadre photo » comme appareil : la musique sort par l'écran du cadre. Compte Spotify Premium nécessaire.") }}</p>
                        </div>
                        <div class="receiver">
                            <h3><i class="fab fa-apple"></i> AirPlay <span id="recv-airplay" class="badge">…</span></h3>
                            <p>{{ _("Depuis un iPhone, un iPad ou un Mac, envoyez le son de n'importe quelle application (Deezer, Apple Music, YouTube...) vers « Cadre photo ».") }}</p>
                        </div>
                    </div>
                    <div class="receiver mt-4">
                        <h3><i class="fab fa-bluetooth-b text-blue-600"></i> Bluetooth <span id="recv-bluetooth" class="badge">…</span></h3>
                        <p>{{ _("Pour les téléphones Android (Deezer, YouTube Music...) : associez une fois le téléphone, il se reconnecte ensuite tout seul. Le cadre n'accepte un nouvel appareil que pendant 3 minutes après un appui sur « Associer un téléphone ».") }}</p>
                        <div class="flex flex-wrap items-center gap-3 mt-3">
                            <button type="button" id="bt-pair" class="btn-secondary"><i class="fab fa-bluetooth-b mr-1"></i>{{ _("Associer un téléphone") }}</button>
                            <span id="bt-status" class="text-sm"></span>
                        </div>
                        <ul id="bt-devices" class="bt-devices"></ul>
                    </div>
                    <div id="receivers-install" class="install-hint hidden">
                        <p>{{ _("Pour activer ces fonctions, lancez une fois sur le Raspberry Pi :") }}</p>
                        <code>~/pimmich/utils/enable_music_receivers.sh</code>
                    </div>
                </section>

                <script>
                    window.addEventListener("DOMContentLoaded", () => {
                        const $ = (id) => document.getElementById(id);
                        const say = (text, ok) => { $("sound-status").textContent = text; $("sound-status").className = "text-sm " + (ok ? "text-green-600" : "text-red-600"); };
                        const ON = {{ _("Actif")|tojson }}, OFF = {{ _("Non installé")|tojson }};
                        async function load() {
                            const data = await (await fetch('/api/sound')).json();
                            const select = $("sound-music");
                            select.querySelectorAll("option:not([value=''])").forEach(o => o.remove());
                            data.files.forEach(f => { const o = document.createElement("option"); o.value = o.textContent = f; select.appendChild(o); });
                            select.value = data.background_music || "";
                            $("sound-volume").value = data.music_volume; $("sound-volume-value").textContent = data.music_volume;
                            preview();
                            for (const [key, active] of Object.entries(data.receivers)) {
                                const badge = $(`recv-${key}`);
                                badge.textContent = active ? ON : OFF;
                                badge.className = "badge " + (active ? "on" : "off");
                            }
                            $("receivers-install").classList.toggle("hidden", Object.values(data.receivers).every(Boolean));
                            $("np-display").value = data.now_playing_display; $("np-position").value = data.now_playing_position;
                        }
                        async function saveDisplay() {
                            const data = await (await fetch('/api/sound', { method: 'POST', headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ now_playing_display: $("np-display").value, now_playing_position: $("np-position").value }) })).json();
                            if (typeof showToast === "function") showToast(data.message);
                        }
                        $("np-display").addEventListener("change", saveDisplay);
                        $("np-position").addEventListener("change", saveDisplay);
                        async function nowPlaying() {
                            if (!$("tab-son").offsetParent) return;  // onglet masqué
                            try {
                                const { playing } = await (await fetch('/api/now_playing')).json();
                                $("np-now").classList.toggle("hidden", !playing);
                                $("np-idle").classList.toggle("hidden", !!playing);
                                if (!playing) return;
                                $("np-title").textContent = playing.title; $("np-artist").textContent = playing.artist || playing.album || "";
                                $("np-source").textContent = playing.source_label;
                                $("np-cover").classList.toggle("hidden", !playing.cover); $("np-nocover").classList.toggle("hidden", !!playing.cover);
                                if (playing.cover && $("np-cover").getAttribute("src") !== playing.cover) $("np-cover").src = playing.cover;
                            } catch (e) { /* le cadre redémarre */ }
                        }
                        document.querySelectorAll(".tablink[onclick*=\"'tab-son'\"]").forEach(b => b.addEventListener("click", () => setTimeout(nowPlaying, 50)));
                        setInterval(nowPlaying, 5000);
                        function preview() {
                            const file = $("sound-music").value;
                            $("sound-preview").classList.toggle("hidden", !file);
                            if (file) $("sound-preview").src = `/static/music/${encodeURIComponent(file)}`;
                        }
                        $("sound-music").addEventListener("change", preview);
                        $("sound-volume").addEventListener("input", () => $("sound-volume-value").textContent = $("sound-volume").value);
                        $("sound-save").addEventListener("click", async () => {
                            const data = await (await fetch('/api/sound', { method: 'POST', headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ background_music: $("sound-music").value, music_volume: Number($("sound-volume").value) }) })).json();
                            say(data.message, data.success);
                        });
                        $("sound-upload").addEventListener("change", async (e) => {
                            const form = new FormData(); form.append("music_file", e.target.files[0]);
                            const data = await (await fetch('/api/upload_music', { method: 'POST', body: form })).json();
                            say(data.message, data.success);
                            await load();
                            if (data.success) { $("sound-music").value = e.target.files[0].name.replace(/[^\w.\-]/g, "_"); preview(); }
                        });
                        // --- Bluetooth ---
                        const BT = { visible: {{ _("Visible : choisissez « Cadre photo » sur le téléphone")|tojson }}, connected: {{ _("connecté")|tojson }},
                                     forget: {{ _("Oublier")|tojson }}, none: {{ _("Aucun téléphone associé.")|tojson }} };
                        async function loadBluetooth() {
                            try {
                                const data = await (await fetch('/api/bluetooth')).json();
                                const badge = $("recv-bluetooth");
                                badge.textContent = data.service ? ON : OFF; badge.className = "badge " + (data.service ? "on" : "off");
                                $("bt-pair").disabled = !data.service;
                                const list = $("bt-devices"); list.innerHTML = "";
                                if (!data.devices.length && data.service) list.innerHTML = `<li class="muted">${BT.none}</li>`;
                                data.devices.forEach(d => {
                                    const li = document.createElement("li");
                                    const name = document.createElement("span");
                                    name.textContent = d.name + (d.connected ? ` · ${BT.connected}` : "");
                                    if (d.connected) name.className = "text-green-700 font-semibold";
                                    const btn = document.createElement("button");
                                    btn.type = "button"; btn.className = "link"; btn.textContent = BT.forget;
                                    btn.addEventListener("click", async () => {
                                        const r = await (await fetch('/api/bluetooth/forget', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ mac: d.mac }) })).json();
                                        say(r.message, r.success); loadBluetooth();
                                    });
                                    li.append(name, btn); list.appendChild(li);
                                });
                                $("bt-status").textContent = data.discoverable ? BT.visible : "";
                            } catch (e) { /* le cadre redémarre */ }
                        }
                        $("bt-pair").addEventListener("click", async () => {
                            const data = await (await fetch('/api/bluetooth/pair', { method: 'POST' })).json();
                            say(data.message, data.success);
                            loadBluetooth();
                        });
                        setInterval(() => { if ($("tab-son").offsetParent) loadBluetooth(); }, 5000);

                        load(); nowPlaying(); loadBluetooth();
                    });
                </script>
            </div>
