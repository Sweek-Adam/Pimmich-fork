{#- Albums intelligents : suggestions et éditeur de règles (période, années, personnes, lieu, sources, favoris). -#}
<div class="mb-6" id="smart-albums">
    <h4 class="font-semibold text-gray-800 mb-1"><i class="fas fa-magic mr-1"></i>{{ _("Albums intelligents") }}</h4>
    <p class="text-sm text-gray-600 mb-2">{{ _("Ils se remplissent tout seuls d'après la date, les personnes ou le lieu des photos, et accueillent les nouvelles photos dès leur arrivée.") }}</p>
    <div id="sa-suggestions" class="sa-suggestions"></div>
    <button type="button" id="sa-new" class="btn-secondary mt-2"><i class="fas fa-plus mr-1"></i>{{ _("Créer un album intelligent") }}</button>
</div>

<div id="sa-modal" class="modal hidden" role="dialog" aria-modal="true" aria-labelledby="sa-title">
    <div class="modal-panel sa-panel">
        <div class="modal-head">
            <h2 id="sa-title" class="card-title">{{ _("Album intelligent") }}</h2>
            <button type="button" class="modal-close" aria-label="{{ _('Fermer') }}">&times;</button>
        </div>
        <div class="sa-body">
            <label for="sa-name" class="font-semibold">{{ _("Nom") }}</label>
            <input type="text" id="sa-name" maxlength="80" placeholder="{{ _('ex : Les enfants, Été 2025, Noël en famille') }}">

            <label for="sa-period" class="font-semibold">{{ _("Période de l'année") }}</label>
            <div class="flex flex-wrap gap-2 items-center">
                <select id="sa-period"><option value="">{{ _("Toute l'année") }}</option></select>
                <span id="sa-custom" class="hidden flex gap-2 items-center">{{ _("du") }} <input type="text" id="sa-from" class="w-20" placeholder="06-21" maxlength="5"> {{ _("au") }} <input type="text" id="sa-to" class="w-20" placeholder="09-22" maxlength="5"> <small class="text-gray-500">{{ _("(mois-jour)") }}</small></span>
            </div>

            <span class="font-semibold">{{ _("Années") }}</span>
            <div id="sa-years" class="sa-checks"></div>

            <span class="font-semibold" id="sa-people-label">{{ _("Personnes") }}</span>
            <div id="sa-people-box">
                <div id="sa-people" class="sa-checks"></div>
                <label class="text-sm" id="sa-all-label"><input type="checkbox" id="sa-all"> {{ _("Toutes ensemble sur la photo (sinon : au moins une)") }}</label>
            </div>

            <label for="sa-place" class="font-semibold">{{ _("Lieu") }}</label>
            <input type="text" id="sa-place" maxlength="80" placeholder="{{ _('ex : Biarritz, Italie') }}">

            <span class="font-semibold">{{ _("Sources") }}</span>
            <div id="sa-sources" class="sa-checks"></div>

            <span class="font-semibold">{{ _("Autres") }}</span>
            <div class="flex flex-wrap gap-4 items-center">
                <label><input type="checkbox" id="sa-fav"> <i class="fas fa-star text-yellow-500"></i> {{ _("Favoris uniquement") }}</label>
                <select id="sa-media">
                    <option value="">{{ _("Photos et vidéos") }}</option>
                    <option value="photos">{{ _("Photos seulement") }}</option>
                    <option value="videos">{{ _("Vidéos seulement") }}</option>
                </select>
            </div>
        </div>
        <div class="sa-preview">
            <strong id="sa-count"></strong>
            <div id="sa-thumbs" class="sa-thumbs"></div>
        </div>
        <p id="sa-message" class="text-sm"></p>
        <div class="flex justify-end gap-2 mt-2">
            <button type="button" id="sa-save" class="btn-primary"><i class="fas fa-check mr-1"></i>{{ _("Enregistrer l'album") }}</button>
        </div>
    </div>
</div>
<style>
    .sa-suggestions { display: flex; flex-wrap: wrap; gap: .5rem; }
    .sa-suggestion { all: unset; cursor: pointer; display: inline-flex; align-items: center; gap: .4rem; padding: .45rem .8rem; border-radius: 999px;
                     border: 1px dashed var(--border, #d1d5db); font-weight: 600; font-size: .9rem; }
    .sa-suggestion:hover { border-style: solid; background: rgba(99, 102, 241, .08); }
    .sa-suggestion small { color: var(--muted, #6b7280); font-weight: 500; }
    .sa-panel { width: min(720px, 100%); }
    .sa-body { display: grid; grid-template-columns: max-content 1fr; gap: .7rem 1rem; align-items: center; overflow-y: auto; padding: .5rem 0; }
    .sa-body > label, .sa-body > span { font-size: .9rem; font-weight: 600; margin: 0; }
    .sa-checks { display: flex; flex-wrap: wrap; gap: .3rem .9rem; }
    .sa-preview { display: flex; align-items: center; gap: .8rem; margin-top: .6rem; min-height: 56px; }
    .sa-thumbs { display: flex; gap: 4px; overflow: hidden; }
    .sa-thumbs img { width: 56px; height: 56px; object-fit: cover; border-radius: 8px; }
    .smart-badge { font-size: .8rem; font-weight: 600; color: #6d28d9; background: #ede9fe; padding: .2rem .55rem; border-radius: 999px; }
    @media (max-width: 640px) { .sa-body { grid-template-columns: 1fr; } }
</style>
<script>
    window.addEventListener("DOMContentLoaded", () => {
        const $ = (id) => document.getElementById(id);
        const modal = $("sa-modal");
        const T = { photos: {{ _("{n} photos")|tojson }}, custom: {{ _("Dates précises…")|tojson }}, none: {{ _("Aucune pour l'instant")|tojson }} };
        let meta = null, editing = null, timer = null;

        const checks = (box, values, chosen) => {
            box.innerHTML = "";
            values.forEach(v => {
                const label = document.createElement("label");
                const input = document.createElement("input"); input.type = "checkbox"; input.value = v; input.checked = (chosen || []).map(String).includes(String(v));
                input.addEventListener("change", preview);
                label.append(input, document.createTextNode(" " + v));
                box.appendChild(label);
            });
        };
        const picked = (box) => [...box.querySelectorAll("input:checked")].map(i => i.value);

        async function loadMeta() {
            meta = await (await fetch("/api/smart_albums")).json();
            $("sa-suggestions").innerHTML = "";
            meta.suggestions.forEach(s => {
                const b = document.createElement("button"); b.type = "button"; b.className = "sa-suggestion";
                const icon = document.createElement("i"); icon.className = `fas ${s.icon}`;
                const count = document.createElement("small"); count.textContent = T.photos.replace("{n}", s.count);
                b.append(icon, document.createTextNode(" + " + s.name + " "), count);
                b.addEventListener("click", () => open({ name: s.name, smart: s.rules }));
                $("sa-suggestions").appendChild(b);
            });
            const period = $("sa-period");
            period.length = 1;
            Object.entries(meta.events).forEach(([key, e]) => period.add(new Option(e.label, key)));
            period.add(new Option(T.custom, "custom"));
        }

        function rules() {
            const r = {};
            const p = $("sa-period").value;
            if (p === "custom") { r.from = $("sa-from").value.trim(); r.to = $("sa-to").value.trim(); }
            else if (p) { r.from = meta.events[p].from; r.to = meta.events[p].to; }
            const years = picked($("sa-years")); if (years.length) r.years = years.map(Number);
            const people = picked($("sa-people")); if (people.length) { r.people = people; if ($("sa-all").checked) r.people_all = true; }
            const sources = picked($("sa-sources")); if (sources.length) r.sources = sources;
            if ($("sa-place").value.trim()) r.place = $("sa-place").value.trim();
            if ($("sa-fav").checked) r.favorites = true;
            if ($("sa-media").value) r.media = $("sa-media").value;
            return r;
        }

        function preview() {
            clearTimeout(timer);
            timer = setTimeout(async () => {
                const d = await (await fetch("/api/smart_albums/preview", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ rules: rules() }) })).json();
                $("sa-count").textContent = d.count ? T.photos.replace("{n}", d.count) : T.none;
                $("sa-thumbs").innerHTML = "";
                d.thumbs.forEach(src => { const img = document.createElement("img"); img.src = src; img.alt = ""; img.loading = "lazy"; $("sa-thumbs").appendChild(img); });
            }, 250);
        }

        async function open(album) {
            if (!meta) await loadMeta();
            editing = album && album.id ? album.id : null;
            const r = (album && album.smart) || {};
            $("sa-name").value = (album && album.name) || "";
            const event = Object.entries(meta.events).find(([, e]) => e.from === r.from && e.to === r.to);
            $("sa-period").value = r.from ? (event ? event[0] : "custom") : "";
            $("sa-from").value = r.from || ""; $("sa-to").value = r.to || "";
            $("sa-custom").classList.toggle("hidden", $("sa-period").value !== "custom");
            checks($("sa-years"), meta.years, r.years);
            checks($("sa-people"), meta.people, r.people);
            ["sa-people-box", "sa-people-label"].forEach(id => $(id).classList.toggle("hidden", !meta.people.length));
            $("sa-all").checked = !!r.people_all;
            checks($("sa-sources"), meta.sources, r.sources);
            $("sa-place").value = r.place || ""; $("sa-fav").checked = !!r.favorites; $("sa-media").value = r.media || "";
            $("sa-message").textContent = "";
            modal.classList.remove("hidden");
            preview();
        }
        window.openSmartAlbum = open;
        const close = () => modal.classList.add("hidden");
        modal.querySelector(".modal-close").addEventListener("click", close);
        modal.addEventListener("click", (e) => { if (e.target === modal) close(); });
        $("sa-period").addEventListener("change", () => { $("sa-custom").classList.toggle("hidden", $("sa-period").value !== "custom"); preview(); });
        ["sa-from", "sa-to", "sa-place"].forEach(id => $(id).addEventListener("input", preview));
        ["sa-all", "sa-fav", "sa-media"].forEach(id => $(id).addEventListener("change", preview));
        $("sa-new").addEventListener("click", () => open(null));
        $("sa-save").addEventListener("click", async () => {
            const r = await (await fetch("/api/smart_albums", { method: "POST", headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ id: editing, name: $("sa-name").value, rules: rules() }) })).json();
            $("sa-message").textContent = r.message; $("sa-message").className = "text-sm " + (r.success ? "text-green-700" : "text-red-600");
            if (r.success) { close(); meta = null; loadMeta(); if (window.refreshPlaylists) window.refreshPlaylists(); }
        });
        document.querySelectorAll(".tablink[onclick*=\"'tab-playlists'\"]").forEach(b => b.addEventListener("click", () => setTimeout(loadMeta, 50)));
        if ($("smart-albums").offsetParent !== null) loadMeta();  // sinon : à l'ouverture de l'onglet (la bibliothèque peut être grande)
    });
</script>
