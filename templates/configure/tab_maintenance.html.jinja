        <div id="tab-maintenance" class="tabcontent">
            <fieldset>
                <legend>
                    <h3><i class="fas fa-microchip mr-2"></i>{{ _("Matériel") }}</h3>
                </legend>
                <div id="hw-grid" class="hw-grid">
                    <div><small>{{ _("Modèle") }}</small><strong id="hw-model">…</strong></div>
                    <div><small>{{ _("Température") }}</small><strong id="hw-temp">…</strong></div>
                    <div><small>{{ _("Alimentation") }}</small><strong id="hw-power">…</strong></div>
                    <div><small>{{ _("Carte SD") }}</small><strong id="hw-sd">…</strong></div>
                </div>
                <p id="hw-supply" class="text-sm text-gray-600 mt-3"></p>
            </fieldset>
            <script>
                window.addEventListener("DOMContentLoaded", () => {
                    const $ = (id) => document.getElementById(id);
                    const T = { ok: {{ _("Correcte")|tojson }}, now: {{ _("Insuffisante en ce moment")|tojson }}, boot: {{ _("A faibli depuis le démarrage")|tojson }},
                                sdOk: {{ _("Aucune erreur")|tojson }}, sdErr: {{ _("erreur(s)")|tojson }}, unknown: {{ _("Inconnu")|tojson }},
                                supply: {{ _("Alimentation conseillée pour ce modèle :")|tojson }} };
                    const set = (id, text, level) => { $(id).textContent = text; $(id).className = level ? `hw-${level}` : ""; };
                    async function load() {
                        if (!$("tab-maintenance").offsetParent) return;
                        const hw = await (await fetch("/api/hardware")).json();
                        set("hw-model", hw.model || T.unknown);
                        set("hw-temp", hw.temperature === null ? T.unknown : `${hw.temperature} °C`, hw.temperature >= 80 ? "err" : hw.temperature >= 70 ? "warn" : "ok");
                        set("hw-power", hw.undervoltage_now === null ? T.unknown : hw.undervoltage_now ? T.now : hw.undervoltage_since_boot ? T.boot : T.ok,
                            hw.undervoltage_now ? "err" : hw.undervoltage_since_boot ? "warn" : "ok");
                        set("hw-sd", hw.sd_errors === null ? T.unknown : hw.sd_errors ? `${hw.sd_errors} ${T.sdErr}` : T.sdOk, hw.sd_errors ? "warn" : "ok");
                        $("hw-supply").textContent = hw.supply ? `${T.supply} ${hw.supply}` : "";
                    }
                    document.querySelectorAll(".tablink[onclick*=\"'tab-maintenance'\"]").forEach(b => b.addEventListener("click", () => setTimeout(load, 50)));
                    load();
                    setInterval(load, 15000);
                });
            </script>
            <fieldset class="mt-6">
                <legend>
                    <h3>{{ _("Sauvegarde et Restauration") }}</h3>
                </legend>
                <p class="text-sm text-gray-600 mb-3">{{ _("Sauvegardez votre configuration (API, partages,
                    affichage...) dans un fichier. Vous pourrez le restaurer plus tard ou sur une nouvelle
                    installation.") }}</p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Sauvegarde -->
                    <div class="p-4 border rounded-lg bg-gray-50/50">
                        <h4 class="font-semibold text-gray-800 mb-2">{{ _("Sauvegarder la configuration") }}</h4>
                        <a href="{{ url_for('backup_settings_api') }}"
                            class="system-button bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded inline-flex items-center">
                            <i class="fas fa-download mr-2"></i>{{ _("Télécharger la sauvegarde") }}
                        </a>
                    </div>
                    <!-- Restauration -->
                    <div class="p-4 border rounded-lg bg-gray-50/50">
                        <h4 class="font-semibold text-gray-800 mb-2">{{ _("Restaurer une configuration") }}</h4>
                        <form action="{{ url_for('restore_settings_api') }}" method="post" enctype="multipart/form-data"
                            onsubmit="return confirm('{{ _('Êtes-vous sûr ? La configuration actuelle sera écrasée par le contenu du fichier de sauvegarde.') }}')">
                            <input type="file" name="backup_file" accept=".json" required
                                class="block w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 cursor-pointer focus:outline-none mb-3">
                            <button type="submit"
                                class="system-button bg-green-500 hover:bg-green-600 text-white font-bold py-2 px-4 rounded inline-flex items-center"><i
                                    class="fas fa-upload mr-2"></i>{{ _("Restaurer") }}</button>
                        </form>
                    </div>
                </div>
            </fieldset>

            <fieldset class="mt-6" id="full-backup">
                <legend><h3><i class="fas fa-archive mr-2"></i>{{ _("Sauvegarde complète") }}</h3></legend>
                <p class="text-sm text-gray-600 mb-3">{{ _("Tout ce qui fait votre cadre : réglages, comptes, playlists, messages, dessins et vocaux, livre d'or, légendes, réactions, musique et historique. Restaurable en un clic, sur ce cadre ou sur une nouvelle installation.") }}</p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div class="p-4 border rounded-lg bg-gray-50/50">
                        <h4 class="font-semibold text-gray-800 mb-2">{{ _("Sans les photos") }}</h4>
                        <a href="/api/backup/full" class="system-button bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded inline-flex items-center mb-3">
                            <i class="fas fa-download mr-2"></i>{{ _("Télécharger") }}</a>
                        <input type="file" id="full-backup-file" accept=".zip"
                            class="block w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 cursor-pointer focus:outline-none mb-2">
                        <button type="button" id="full-backup-upload" class="system-button bg-green-500 hover:bg-green-600 text-white font-bold py-2 px-4 rounded inline-flex items-center">
                            <i class="fas fa-upload mr-2"></i>{{ _("Restaurer ce fichier") }}</button>
                    </div>
                    <div class="p-4 border rounded-lg bg-gray-50/50">
                        <h4 class="font-semibold text-gray-800 mb-2">{{ _("Avec les photos, sur un disque USB ou un NAS") }}</h4>
                        <p id="full-backup-nostorage" class="text-sm text-gray-600 hidden">{{ _("Ajoutez d'abord un support dans « Stockage des photos » ci-dessous.") }}</p>
                        <div id="full-backup-storage-row" class="flex flex-wrap gap-2 items-center">
                            <select id="full-backup-storage" class="border rounded px-2 py-1"></select>
                            <button type="button" id="full-backup-start" class="system-button bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded inline-flex items-center">
                                <i class="fas fa-save mr-2"></i>{{ _("Sauvegarder maintenant") }}</button>
                        </div>
                        <p id="full-backup-progress" class="text-sm mt-2"></p>
                    </div>
                </div>
                <div id="full-backup-list" class="mt-3 text-sm"></div>
                <p id="full-backup-status" class="mt-2 text-sm"></p>
                <script>
                    (() => {
                        const $ = id => document.getElementById(id);
                        const say = (text, ok) => { $("full-backup-status").textContent = text || ""; $("full-backup-status").className = "mt-2 text-sm " + (ok === false ? "text-red-600" : "text-green-700"); };
                        const size = n => n > 1e9 ? (n / 1e9).toFixed(1) + " Go" : Math.max(1, Math.round(n / 1e6)) + " Mo";
                        let timer = null;
                        async function refresh() {
                            let data;
                            try { data = await (await fetch("/api/backup/full/storage")).json(); } catch (e) { return; }
                            const select = $("full-backup-storage"), current = select.value;
                            select.innerHTML = "";
                            (data.storages || []).forEach(s => select.add(new Option(s.label, s.id)));
                            if (current) select.value = current;
                            const none = !(data.storages || []).length;
                            $("full-backup-nostorage").classList.toggle("hidden", !none);
                            $("full-backup-storage-row").classList.toggle("hidden", none);
                            const st = data.status || {};
                            $("full-backup-start").disabled = !!st.running;
                            $("full-backup-progress").textContent = st.running
                                ? "{{ _('Sauvegarde en cours : {done} / {total} fichiers') }}".replace("{done}", st.done || 0).replace("{total}", st.total || "…")
                                : (st.message || "");
                            $("full-backup-progress").className = "text-sm mt-2 " + (st.ok === false ? "text-red-600" : "");
                            const list = $("full-backup-list");
                            list.innerHTML = "";
                            (data.backups || []).forEach(b => {
                                const row = document.createElement("div");
                                row.className = "flex flex-wrap items-center gap-2 py-1 border-b";
                                const label = document.createElement("span");
                                label.className = "flex-1";
                                label.textContent = `${b.storage_label} · ${(b.created || b.name).replace("T", " ")} · ${size(b.size)}` + (b.photos ? " · {{ _('avec photos') }}" : "");
                                const btn = document.createElement("button");
                                btn.type = "button";
                                btn.className = "system-button bg-orange-500 hover:bg-orange-600 text-white py-1 px-3 rounded";
                                btn.textContent = "{{ _('Restaurer') }}";
                                btn.onclick = () => restore("/api/backup/full/storage/restore", {method: "POST", headers: {"Content-Type": "application/json"}, body: JSON.stringify({storage: b.storage, name: b.name})});
                                row.append(label, btn);
                                list.append(row);
                            });
                            clearTimeout(timer);
                            if (st.running) timer = setTimeout(refresh, 3000);
                        }
                        async function restore(url, options) {
                            if (!confirm("{{ _('Remplacer les réglages, comptes, messages et playlists actuels par cette sauvegarde ?') }}")) return;
                            say("{{ _('Restauration en cours...') }}");
                            try {
                                const data = await (await fetch(url, options)).json();
                                say(data.message, !!data.success);
                            } catch (e) { say("{{ _('Erreur de communication avec le serveur.') }}", false); }
                        }
                        $("full-backup-upload").addEventListener("click", () => {
                            const file = $("full-backup-file").files[0];
                            if (!file) { say("{{ _('Aucun fichier sélectionné.') }}", false); return; }
                            const form = new FormData();
                            form.append("backup", file);
                            restore("/api/backup/full/restore", {method: "POST", body: form});
                        });
                        $("full-backup-start").addEventListener("click", async () => {
                            const data = await (await fetch("/api/backup/full/storage", {method: "POST", headers: {"Content-Type": "application/json"}, body: JSON.stringify({storage: $("full-backup-storage").value})})).json();
                            say(data.message, !!data.success);
                            refresh();
                        });
                        refresh();
                    })();
                </script>
            </fieldset>

            <fieldset class="mt-6" id="admin-https">
                <legend><h3><i class="fas fa-lock mr-2"></i>{{ _("HTTPS sans avertissement (Tailscale)") }}</h3></legend>
                <p class="text-sm text-gray-600 mb-3">{{ _("Ouvre l'administration à une adresse sécurisée par un vrai certificat, depuis vos appareils connectés à Tailscale (à la maison comme ailleurs). Elle n'est jamais publiée sur internet.") }}</p>
                <label class="inline-flex items-center"><input type="checkbox" id="ah-enabled" class="mr-2">{{ _("Activer l'accès HTTPS par Tailscale") }}</label>
                <p id="ah-info" class="text-sm mt-2"></p>
                <p class="mt-2"><a id="ah-link" class="text-blue-600 underline break-all hidden" target="_blank" rel="noopener"></a></p>
                <script>
                    (() => {
                        const $ = id => document.getElementById(id);
                        const info = (text, ok, html) => { const el = $("ah-info"); el.className = "text-sm mt-2 " + (ok === false ? "text-red-600" : "text-gray-700"); el.textContent = text || ""; if (html) el.append(" ", html); };
                        async function load() {
                            let d;
                            try { d = await (await fetch("/api/admin_https")).json(); } catch (e) { return; }
                            $("ah-enabled").checked = !!d.enabled;
                            $("ah-enabled").disabled = !d.installed;
                            if (!d.installed) info({{ _("Tailscale n'est pas installé sur ce cadre.")|tojson }}, false);
                            else if (!d.connected) info({{ _("Tailscale n'est pas connecté.")|tojson }}, false);
                            $("ah-link").classList.toggle("hidden", !d.link);
                            if (d.link) { $("ah-link").href = d.link; $("ah-link").textContent = d.link; }
                        }
                        $("ah-enabled").addEventListener("change", async () => {
                            info({{ _("Un instant...")|tojson }});
                            let r;
                            try {
                                r = await (await fetch("/api/admin_https", {method: "POST", headers: {"Content-Type": "application/json"}, body: JSON.stringify({enabled: $("ah-enabled").checked})})).json();
                            } catch (e) { r = {success: false, message: {{ _("Erreur de communication avec le serveur.")|tojson }}}; }
                            let extra = null;
                            if (r.activation_url) {
                                extra = document.createElement("a");
                                extra.href = r.activation_url; extra.target = "_blank"; extra.rel = "noopener";
                                extra.className = "text-blue-600 underline";
                                extra.textContent = {{ _("Autoriser sur Tailscale")|tojson }};
                            }
                            info(r.message, !!r.success, extra);
                            load();
                        });
                        load();
                    })();
                </script>
            </fieldset>

            <fieldset class="mt-6">
                <legend>
                    <h3>{{ _("Espace disque") }}</h3>
                </legend>
                <p id="disk-summary" class="mb-3">…</p>
                <label for="disk_alert_free_gb">{{ _("Alerter sous (Go libres) :") }}</label>
                <input type="number" id="disk_alert_free_gb" min="0" step="0.5" class="w-32">
                <div class="form-check form-switch my-3">
                    <input class="form-check-input" type="checkbox" id="disk_auto_cleanup">
                    <label class="form-check-label ml-2" for="disk_auto_cleanup">{{ _("Libérer de la place automatiquement") }}</label>
                </div>
                <p class="text-sm text-gray-600">{{ _("Sous le seuil, les photos et vidéos Google Drive déjà retirées du Drive sont supprimées du cadre, les plus anciennes d'abord. Les favoris ne sont jamais supprimés.") }}</p>
            </fieldset>

            <fieldset class="mt-6" id="storage-box">
                <legend><h3><i class="fas fa-hdd mr-2"></i>{{ _("Stockage des photos") }}</h3></legend>
                <p class="text-sm text-gray-600 mb-3">{{ _("Les photos peuvent vivre ailleurs que sur la carte SD : un disque ou une clé USB branché au cadre, ou un partage réseau (NAS). Choisissez l'emplacement de chaque source ; le cadre copie les photos, vérifie la copie, puis libère la place. Moins d'écritures sur la carte SD, c'est aussi une carte qui dure plus longtemps.") }}</p>
                <div id="st-supports" class="st-supports"></div>
                {% if is_admin %}
                <div class="mt-3 p-3 rounded-lg bg-gray-50">
                    <p class="font-semibold mb-2">{{ _("Ajouter un support") }}</p>
                    <div id="st-disks" class="flex flex-wrap gap-2"></div>
                    <p id="st-nodisk" class="text-sm text-gray-600 hidden">{{ _("Aucun disque USB détecté : branchez-le puis rouvrez cet onglet.") }}</p>
                    <details class="mt-2">
                        <summary class="cursor-pointer text-sm font-semibold">{{ _("Partage réseau (NAS, ordinateur)") }}</summary>
                        <div class="grid gap-2 mt-2 st-grid">
                            <label for="st-share">{{ _("Adresse") }}</label><input type="text" id="st-share" placeholder="//nas.local/photos">
                            <label for="st-user">{{ _("Utilisateur") }}</label><input type="text" id="st-user" autocomplete="off">
                            <label for="st-pass">{{ _("Mot de passe") }}</label><input type="password" id="st-pass" autocomplete="new-password">
                        </div>
                        <button type="button" id="st-add-smb" class="btn-secondary mt-2">{{ _("Ajouter le partage") }}</button>
                    </details>
                </div>
                {% endif %}
                <h4 class="font-semibold mt-4 mb-2">{{ _("Emplacement de chaque source") }}</h4>
                <div id="st-sources" class="st-sources"></div>
                <div id="st-move" class="hidden mt-2"><div class="progress-container"><div class="progress-bar" id="st-move-bar"></div></div><p id="st-move-text" class="text-sm"></p></div>
                <p id="st-status" class="text-sm mt-2"></p>
            </fieldset>
            <style>
                .st-supports { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: .75rem; }
                .st-support { border: 1px solid var(--border, #e5e7eb); border-radius: .75rem; padding: .75rem; }
                .st-support .st-bar { height: 8px; border-radius: 4px; background: #e5e7eb; overflow: hidden; margin: .4rem 0; }
                .st-support .st-bar span { display: block; height: 100%; background: #6366f1; }
                .st-support.off { border-color: #fca5a5; background: #fef2f2; }
                .st-sources { display: grid; grid-template-columns: 1fr auto auto; gap: .4rem .8rem; align-items: center; }
                .st-grid { grid-template-columns: max-content 1fr; align-items: center; }
                @media (max-width: 640px) { .st-sources { grid-template-columns: 1fr auto; } .st-sources .st-size { display: none; } .st-grid { grid-template-columns: 1fr; } }
            </style>
            <script>
                window.addEventListener("DOMContentLoaded", () => {
                    const $ = (id) => document.getElementById(id);
                    const ADMIN = {{ (is_admin|default(false))|tojson }};
                    const T = { sd: {{ _("Carte SD")|tojson }}, free: {{ _("libres sur")|tojson }}, off: {{ _("Débranché")|tojson }},
                                remove: {{ _("Retirer")|tojson }}, add: {{ _("Utiliser ce disque")|tojson }}, moving: {{ _("Déplacement de « {source} » : {done} / {total} fichiers")|tojson }},
                                files: {{ _("fichiers")|tojson }}, offline: {{ _("support débranché")|tojson }}, confirm: {{ _("Déplacer les photos de « {source} » vers « {target} » ?")|tojson }},
                                erase: {{ _("Le contenu actuel du disque est conservé : Pimmich range ses photos dans un dossier « pimmich ».")|tojson }} };
                    const say = (t, ok) => { $("st-status").textContent = t || ""; $("st-status").className = "text-sm mt-2 " + (ok ? "text-green-700" : "text-red-600"); };
                    const post = async (url, body) => (await fetch(url, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body || {}) })).json();
                    const gb = (b) => (b / 1e9).toLocaleString(undefined, { maximumFractionDigits: b < 1e10 ? 1 : 0 }) + " Go";
                    const el = (tag, cls, text) => { const e = document.createElement(tag); if (cls) e.className = cls; if (text !== undefined) e.textContent = text; return e; };
                    let timer = null;
                    function support(name, usage, off, id) {
                        const card = el("div", "st-support" + (off ? " off" : ""));
                        card.append(el("strong", "", name));
                        if (usage) {
                            const bar = el("div", "st-bar"); const fill = el("span"); fill.style.width = `${usage.percent}%`; bar.append(fill);
                            card.append(bar, el("small", "", `${gb(usage.free)} ${T.free} ${gb(usage.total)}`));
                        } else if (off) card.append(el("div", "text-sm text-red-700", T.off));
                        if (id && ADMIN) {
                            const b = el("button", "link text-sm block mt-1", T.remove); b.type = "button";
                            b.addEventListener("click", async () => { const r = await post("/api/storage/remove", { id }); say(r.message, r.success); load(); });
                            card.append(b);
                        }
                        return card;
                    }
                    async function load() {
                        if (!$("storage-box").offsetParent) return;
                        const d = await (await fetch("/api/storage")).json();
                        $("st-supports").innerHTML = "";
                        $("st-supports").append(support(T.sd, d.sd, false, null));
                        d.storages.forEach(s => $("st-supports").append(support(s.label, s.usage, !s.mounted, s.id)));
                        if ($("st-disks")) {
                            $("st-disks").innerHTML = "";
                            d.disks.forEach(disk => {
                                const b = el("button", "btn-secondary text-sm", `${T.add} : ${disk.label} (${gb(disk.size)}, ${disk.fstype})`); b.type = "button";
                                b.title = T.erase;
                                b.addEventListener("click", async () => { const r = await post("/api/storage/add", { kind: "disk", uuid: disk.uuid }); say(r.message, r.success); load(); });
                                $("st-disks").append(b);
                            });
                            $("st-nodisk").classList.toggle("hidden", d.disks.length > 0);
                        }
                        $("st-sources").innerHTML = "";
                        const targets = [["sd", T.sd]].concat(d.storages.map(s => [s.id, s.label]));
                        Object.entries(d.sources).forEach(([name, info]) => {
                            $("st-sources").append(el("span", "", name), el("span", "st-size text-sm text-gray-600", info.online ? `${gb(info.bytes)} · ${info.files} ${T.files}` : T.offline));
                            const select = el("select");
                            targets.forEach(([value, label]) => select.add(new Option(label, value)));
                            select.value = info.location; select.disabled = !ADMIN || d.move.running || d.storages.length === 0;
                            select.addEventListener("change", async () => {
                                const label = targets.find(t => t[0] === select.value)[1];
                                if (!confirm(T.confirm.replace("{source}", name).replace("{target}", label))) { select.value = info.location; return; }
                                const r = await post("/api/storage/move", { source: name, to: select.value }); say(r.message, r.success); load();
                            });
                            $("st-sources").append(select);
                        });
                        $("st-move").classList.toggle("hidden", !d.move.running);
                        if (d.move.running) {
                            $("st-move-bar").style.width = d.move.total ? `${Math.round(d.move.done / d.move.total * 100)}%` : "5%";
                            $("st-move-text").textContent = T.moving.replace("{source}", d.move.source).replace("{done}", d.move.done).replace("{total}", d.move.total || "…");
                        } else if (d.move.message) say(d.move.message, d.move.ok);
                        clearTimeout(timer);
                        if (d.move.running) timer = setTimeout(load, 2000);
                    }
                    if ($("st-add-smb")) $("st-add-smb").addEventListener("click", async () => {
                        const r = await post("/api/storage/add", { kind: "smb", share: $("st-share").value.trim(), username: $("st-user").value.trim(), password: $("st-pass").value });
                        say(r.message, r.success); if (r.success) { $("st-pass").value = ""; load(); }
                    });
                    document.querySelectorAll(".tablink[onclick*=\"'tab-maintenance'\"]").forEach(b => b.addEventListener("click", () => setTimeout(load, 50)));
                    load();
                });
            </script>
            <fieldset class="mt-6">
                <legend>
                    <h3>{{ _("Sauvegarde automatique sur Google Drive") }}</h3>
                </legend>
                <p class="text-sm text-gray-600 mb-3">{{ _("Sauvegarde les réglages, comptes, playlists, favoris, invitations et messages dans un dossier de votre Google Drive (connexion rclone). Les photos ne sont pas incluses.") }}</p>
                <div class="form-check form-switch my-3">
                    <input class="form-check-input" type="checkbox" id="backup_drive_enabled">
                    <label class="form-check-label ml-2" for="backup_drive_enabled">{{ _("Activer la sauvegarde automatique") }}</label>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                    <div><label for="backup_drive_folder">{{ _("Dossier Google Drive :") }}</label>
                        <input type="text" id="backup_drive_folder"></div>
                    <div><label for="backup_drive_interval_hours">{{ _("Toutes les (heures) :") }}</label>
                        <input type="number" id="backup_drive_interval_hours" min="1"></div>
                    <div><label for="backup_drive_keep">{{ _("Sauvegardes conservées :") }}</label>
                        <input type="number" id="backup_drive_keep" min="1"></div>
                </div>
                <p id="backup-summary" class="mt-3 text-sm"></p>
                <div class="mt-3 flex flex-wrap gap-2">
                    <button type="button" id="maintenance-save-btn" class="system-button bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded inline-flex items-center">
                        <i class="fas fa-save mr-2"></i>{{ _("Enregistrer ces réglages") }}</button>
                    <button type="button" id="backup-now-btn" class="system-button bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded inline-flex items-center">
                        <i class="fab fa-google-drive mr-2"></i>{{ _("Sauvegarder maintenant") }}</button>
                    <button type="button" id="backup-restore-btn" class="system-button bg-orange-500 hover:bg-orange-600 text-white font-bold py-2 px-4 rounded inline-flex items-center">
                        <i class="fas fa-undo mr-2"></i>{{ _("Restaurer la dernière sauvegarde") }}</button>
                </div>
                <p id="maintenance-status" class="mt-3 text-sm"></p>
                <script>
                    (function () {
                        const $ = (id) => document.getElementById(id);
                        const say = (text, ok) => { $("maintenance-status").textContent = text; $("maintenance-status").className = `mt-3 text-sm ${ok ? 'text-green-600' : 'text-red-600'}`; };
                        const fmt = (iso) => iso ? new Date(iso).toLocaleString() : "—";
                        async function load() {
                            const data = await (await fetch('/api/maintenance/status')).json();
                            if (!data.success) return;
                            const d = data.disk, s = data.settings, b = data.backup;
                            $("disk-summary").innerHTML = `<strong>${d.free_gb} {{ _("Go libres sur") }} ${d.total_gb} Go</strong> (${d.used_percent} % {{ _("utilisés") }})`
                                + (d.low ? ` — <span class="text-red-600 font-semibold">{{ _("espace faible") }}</span>` : '')
                                + `<br><span class="text-sm text-gray-600">${d.cleanable_count} {{ _("média(s) Google Drive pourraient être supprimés automatiquement.") }}</span>`;
                            $("disk_alert_free_gb").value = s.disk_alert_free_gb;
                            $("disk_auto_cleanup").checked = !!s.disk_auto_cleanup;
                            $("backup_drive_enabled").checked = !!s.backup_drive_enabled;
                            $("backup_drive_folder").value = s.backup_drive_folder;
                            $("backup_drive_interval_hours").value = s.backup_drive_interval_hours;
                            $("backup_drive_keep").value = s.backup_drive_keep;
                            $("backup-summary").innerHTML = `{{ _("Dernière sauvegarde réussie :") }} <strong>${fmt(b.last_success)}</strong>`
                                + (b.last_error ? `<br><span class="text-red-600">{{ _("Dernier échec :") }} ${fmt(b.last_attempt)} — ${b.last_error.replace(/</g, '&lt;')}</span>` : '');
                        }
                        async function post(url, body) {
                            const resp = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body || {}) });
                            const data = await resp.json();
                            say(data.message, data.success);
                            load();
                        }
                        $("maintenance-save-btn").addEventListener("click", () => post('/api/maintenance/settings', {
                            disk_alert_free_gb: $("disk_alert_free_gb").value, disk_auto_cleanup: $("disk_auto_cleanup").checked,
                            backup_drive_enabled: $("backup_drive_enabled").checked, backup_drive_folder: $("backup_drive_folder").value,
                            backup_drive_interval_hours: $("backup_drive_interval_hours").value, backup_drive_keep: $("backup_drive_keep").value,
                        }));
                        $("backup-now-btn").addEventListener("click", () => { say("{{ _('Sauvegarde en cours...') }}", true); post('/api/backup/drive'); });
                        $("backup-restore-btn").addEventListener("click", () => {
                            if (confirm("{{ _('Remplacer les réglages actuels par la dernière sauvegarde du Drive ?') }}")) post('/api/backup/drive/restore');
                        });
                        load();
                    })();
                </script>
            </fieldset>

            <fieldset class="mt-6">
                <legend>
                    <h3>{{ _("Mise à jour de l'application") }}</h3>
                </legend>
                <p class="text-sm text-gray-600 mb-3">{{ _("Pimmich se met à jour depuis GitHub puis redémarre. Si la nouvelle version ne démarre pas, le cadre revient tout seul à la version précédente.") }}</p>
                <div class="update-box">
                    <p><span class="muted">{{ _("Version installée :") }}</span> <code id="upd-current">…</code></p>
                    <p id="upd-status" class="font-semibold mt-1"></p>
                    <ul id="upd-changes" class="upd-changes hidden"></ul>
                    <p id="upd-state" class="text-sm mt-2"></p>
                </div>
                <a href="/update" 
                   class="system-button bg-purple-600 hover:bg-purple-700 text-white font-bold py-2 px-4 rounded inline-flex items-center"
                   onclick="return confirm('{{ _('Lancer la mise à jour ? Vous allez être redirigé vers la page de suivi.') }}')">
                    <i class="fas fa-cloud-download-alt mr-2"></i>{{ _("Lancer la mise à jour") }}
                </a>
                <button type="button" id="upd-rollback" class="btn-secondary ml-2 hidden"><i class="fas fa-undo mr-1"></i>{{ _("Revenir à la version précédente") }}</button>
                <script>
                    window.addEventListener("DOMContentLoaded", () => {
                        const $ = (id) => document.getElementById(id);
                        const T = { upToDate: {{ _("Pimmich est à jour.")|tojson }}, available: {{ _("Mise à jour disponible :")|tojson }}, changes: {{ _("changement(s)")|tojson }},
                                    offline: {{ _("Impossible de joindre GitHub (connexion internet ?).")|tojson }},
                                    pending: {{ _("Dernière mise à jour en cours de validation (redémarrage).")|tojson }},
                                    rolled: {{ _("Le cadre est revenu à une version précédente.")|tojson }},
                                    confirm: {{ _("Revenir à la version précédente ? Pimmich va redémarrer.")|tojson }} };
                        let loaded = false;
                        async function check() {
                            if (loaded || !$("tab-maintenance").offsetParent) return;
                            loaded = true;
                            const d = await (await fetch("/api/update/check")).json();
                            $("upd-current").textContent = d.current && d.current.sha ? `${d.current.sha} (${(d.current.date || "").slice(0, 10)})` : "?";
                            if (!d.success) { $("upd-status").textContent = T.offline; return; }
                            $("upd-status").textContent = d.behind ? `${T.available} ${d.behind} ${T.changes}` : T.upToDate;
                            $("upd-status").className = "font-semibold mt-1 " + (d.behind ? "text-indigo-700" : "text-green-700");
                            $("upd-changes").classList.toggle("hidden", !d.changes.length);
                            $("upd-changes").innerHTML = "";
                            d.changes.forEach(c => { const li = document.createElement("li"); li.textContent = c.title; $("upd-changes").appendChild(li); });
                            const st = d.state || {};
                            $("upd-state").textContent = st.status === "pending" ? T.pending : st.status === "rolled_back" ? T.rolled : "";
                            $("upd-rollback").classList.toggle("hidden", !st.previous);
                        }
                        $("upd-rollback").addEventListener("click", async () => {
                            if (!confirm(T.confirm)) return;
                            const r = await (await fetch("/api/update/rollback", { method: "POST" })).json();
                            $("upd-state").textContent = r.message;
                        });
                        document.querySelectorAll(".tablink[onclick*=\"'tab-maintenance'\"]").forEach(b => b.addEventListener("click", () => setTimeout(check, 50)));
                        check();
                    });
                </script>
            </fieldset>

            <fieldset class="mt-6">
                <legend>
                    <h3>{{ _("Système de Fichiers de la Carte SD") }}</h3>
                </legend>
                <p class="text-sm text-gray-600 mb-3">{{ _("Si vous avez flashé Pimmich sur une carte SD plus grande que
                    l'image, utilisez cette option pour étendre la partition et utiliser tout l'espace disponible. Un
                    redémarrage du système sera nécessaire pour finaliser l'opération.") }}</p>
                <div class="p-4 border-l-4 border-blue-400 bg-blue-50 text-blue-700 mb-4">
                    <p><strong>{{ _("Note :") }}</strong> {{ _("Cette opération est sûre et ne supprime aucune donnée.
                        Elle prépare simplement le système à s'étendre au prochain démarrage.") }}</p>
                </div>
                <button type="button" id="expand-fs-btn"
                    class="system-button bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded inline-flex items-center">
                    <i class="fas fa-expand-arrows-alt mr-2"></i>{{ _("Étendre le système de fichiers") }}
                </button>
                <div id="expand-fs-status" class="status-messages mt-2"></div>
                <h4 class="font-semibold text-gray-800 mt-5 mb-1"><i class="fas fa-shield-alt mr-2"></i>{{ _("Protection contre l'usure") }}</h4>
                <p id="sd-protection" class="text-sm text-gray-700"></p>
                <script>
                    (async () => {
                        let d;
                        try { d = await (await fetch("/api/sd_protection")).json(); } catch (e) { return; }
                        const el = document.getElementById("sd-protection");
                        if (d.log2ram) { el.className = "text-sm text-green-700"; el.textContent = {{ _("Active : les journaux sont écrits en mémoire vive et recopiés sur la carte une fois par jour.")|tojson }}; }
                        else { el.textContent = {{ _("Inactive. Pour réduire les écritures sur la carte SD, lancez une fois sur le Raspberry Pi : sudo ~/pimmich/utils/enable_sd_protection.sh puis redémarrez.")|tojson }}; }
                    })();
                </script>
