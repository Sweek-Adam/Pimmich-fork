        <div id="tab-maintenance" class="tabcontent">
            <fieldset class="mt-6">
                <legend>
                    <h3>{{ _("Sauvegarde et Restauration") }}</h3>
                </legend>
                <p class="text-sm text-gray-600 mb-3">{{ _("Sauvegardez votre configuration (API, partages,
                    affichage...) dans un fichier. Vous pourrez le restaurer plus tard ou sur une nouvelle
                    installation.") }}</p>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Sauvegarde -->
                    <div class="p-4 border rounded-lg bg-gray-50/50">
                        <h4 class="font-semibold text-gray-800 mb-2">{{ _("Sauvegarder la configuration") }}</h4>
                        <a href="{{ url_for('backup_settings_api') }}"
                            class="system-button bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded inline-flex items-center">
                            <i class="fas fa-download mr-2"></i>{{ _("Télécharger la sauvegarde") }}
                        </a>
                    </div>
                    <!-- Restauration -->
                    <div class="p-4 border rounded-lg bg-gray-50/50">
                        <h4 class="font-semibold text-gray-800 mb-2">{{ _("Restaurer une configuration") }}</h4>
                        <form action="{{ url_for('restore_settings_api') }}" method="post" enctype="multipart/form-data"
                            onsubmit="return confirm('{{ _('Êtes-vous sûr ? La configuration actuelle sera écrasée par le contenu du fichier de sauvegarde.') }}')">
                            <input type="file" name="backup_file" accept=".json" required
                                class="block w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 cursor-pointer focus:outline-none mb-3">
                            <button type="submit"
                                class="system-button bg-green-500 hover:bg-green-600 text-white font-bold py-2 px-4 rounded inline-flex items-center"><i
                                    class="fas fa-upload mr-2"></i>{{ _("Restaurer") }}</button>
                        </form>
                    </div>
                </div>
            </fieldset>

            <fieldset class="mt-6">
                <legend>
                    <h3>{{ _("Mise à jour de l'application") }}</h3>
                </legend>
                <p class="text-sm text-gray-600 mb-3">{{ _("Cliquez sur le bouton pour rechercher et installer les
                    dernières mises à jour de Pimmich depuis GitHub. L'application redémarrera automatiquement après la
                    mise à jour.") }}</p>
                <a href="/update" 
                   class="system-button bg-purple-600 hover:bg-purple-700 text-white font-bold py-2 px-4 rounded inline-flex items-center"
                   onclick="return confirm('{{ _('Lancer la mise à jour ? Vous allez être redirigé vers la page de suivi.') }}')">
                    <i class="fas fa-cloud-download-alt mr-2"></i>{{ _("Lancer la mise à jour") }}
                </a>
            </fieldset>

            <fieldset class="mt-6">
                <legend>
                    <h3>{{ _("Système de Fichiers de la Carte SD") }}</h3>
                </legend>
                <p class="text-sm text-gray-600 mb-3">{{ _("Si vous avez flashé Pimmich sur une carte SD plus grande que
                    l'image, utilisez cette option pour étendre la partition et utiliser tout l'espace disponible. Un
                    redémarrage du système sera nécessaire pour finaliser l'opération.") }}</p>
                <div class="p-4 border-l-4 border-blue-400 bg-blue-50 text-blue-700 mb-4">
                    <p><strong>{{ _("Note :") }}</strong> {{ _("Cette opération est sûre et ne supprime aucune donnée.
                        Elle prépare simplement le système à s'étendre au prochain démarrage.") }}</p>
                </div>
                <button type="button" id="expand-fs-btn"
                    class="system-button bg-green-600 hover:bg-green-700 text-white font-bold py-2 px-4 rounded inline-flex items-center">
                    <i class="fas fa-expand-arrows-alt mr-2"></i>{{ _("Étendre le système de fichiers") }}
                </button>
                <div id="expand-fs-status" class="status-messages mt-2"></div>
            </fieldset>

            <fieldset class="mt-6">
                <legend>
                    <h3>{{ _("Contrôle du système") }}</h3>
                </legend>
                <form method="POST" action="/restart_app"
                    onsubmit="return confirm('{{ _('Êtes-vous sûr de vouloir redémarrer UNIQUEMENT l\'application web ? Le système d\'exploitation ne sera pas redémarré.') }}');">
                    <button type="submit"
                        class="system-button bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2 px-4 rounded">
                        <i class="fas fa-redo"></i> {{ _("Redémarrer l'application web") }}
                    </button>
                </form>
                <!-- Formulaire pour le redémarrage -->
                <form id="rebootForm" action="/system_reboot" method="POST"
                    class="flex items-center gap-3 mb-3 p-3 bg-yellow-50 border border-yellow-200 rounded-lg"
                    onsubmit="return confirm('Êtes-vous sûr de vouloir redémarrer le système ?');">
                    <button type="submit"
                        class="system-button bg-yellow-500 hover:bg-yellow-700 text-gray-800 font-bold py-2 px-4 rounded flex-1">
                        <i class="fas fa-sync-alt mr-1"></i>{{ _("Redémarrer le système") }}
                    </button>
                    <div class="flex items-center bg-yellow-100 px-3 py-2 rounded-md border border-yellow-300">
                        <input type="checkbox" name="delete_logs" id="delete_logs"
                            class="mr-2 h-4 w-4 text-yellow-600 focus:ring-yellow-500 border-gray-300 rounded">
                        <label for="delete_logs"
                            class="text-sm font-medium text-gray-800 cursor-pointer select-none whitespace-nowrap flex items-center">
                            <i class="fas fa-trash-alt mr-1 text-yellow-600 text-xs"></i>
                            <span>{{ _("Supprimer les logs") }}</span>
                        </label>
                    </div>
                </form>
                <form method="POST" action="/shutdown"
                    onsubmit="return confirm('{{ _('Êtes-vous sûr de vouloir ÉTEINDRE le système ?') }}');">
                    <button type="submit"
                        class="system-button bg-red-500 hover:bg-red-700 text-white font-bold py-2 px-4 rounded">
                        <i class="fas fa-power-off"></i> {{ _("Éteindre le système") }}
                    </button>
                </form>
                <button type="button" id="switch-desktop-btn"
                    class="system-button bg-gray-700 hover:bg-gray-900 text-white font-bold py-2 px-4 rounded mt-3">
                    <i class="fab fa-raspberry-pi mr-1"></i> {{ _("Repasser sur Raspberry Pi OS (bureau)") }}
                </button>
                <div id="switch-desktop-status" class="status-messages mt-2"></div>
                <script>
                    document.getElementById("switch-desktop-btn").addEventListener("click", () => {
                        if (!confirm("{{ _('Le Raspberry va redémarrer sur le bureau Raspberry Pi OS et Pimmich ne se lancera plus automatiquement. Pour revenir au mode cadre photo, relancez setup.sh. Continuer ?') }}")) {
                            return;
                        }
                        const btn = document.getElementById("switch-desktop-btn");
                        const statusDiv = document.getElementById("switch-desktop-status");
                        btn.disabled = true;
                        btn.classList.add("opacity-50", "cursor-not-allowed");
                        fetch('/api/switch_to_desktop', { method: 'POST' })
                            .then(r => r.json())
                            .then(data => {
                                statusDiv.innerHTML = `<p class="${data.success ? 'text-green-600' : 'text-red-600'}">${data.message}</p>`;
                                if (!data.success) {
                                    btn.disabled = false;
                                    btn.classList.remove("opacity-50", "cursor-not-allowed");
                                }
                            })
                            .catch(err => {
                                statusDiv.innerHTML = `<p class="text-red-600">${err}</p>`;
                                btn.disabled = false;
                                btn.classList.remove("opacity-50", "cursor-not-allowed");
                            });
                    });
                </script>
            </fieldset>
        </div>
